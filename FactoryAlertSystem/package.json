{
  "name": "FactoryAlertSystem",
  "version": "1.0.15",
  "description": "Hệ Thống Thông Báo Lỗi Thời Gian Thực Cho Dây Chuyền Sản Xuất",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "clean:android": "cd android && gradlew clean && cd ..",
    "clean:all:win": "rmdir /s /q node_modules && rmdir /s /q android\\build",
    "clean:all:unix": "rm -rf node_modules && rm -rf android/build && rm -rf ios/build",
    "build:android:debug": "cd android && gradlew assembleDebug && cd ..",
    "build:android:release": "cd android && gradlew assembleRelease && cd ..",
    "build:ios": "cd ios && xcodebuild -workspace FactoryAlertSystem.xcworkspace -scheme FactoryAlertSystem -configuration Release",
    "postinstall": "npx patch-package && npx react-native-asset",
    "android:device": "adb devices && react-native run-android",
    "adb:reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:1883 tcp:1883",
    "adb:reverse:mqtt": "adb reverse tcp:1883 tcp:1883",
    "setup:device": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:1883 tcp:1883 && echo Port forwarding setup complete!"
  },
  "dependencies": {
    "@notifee/react-native": "^7.8.2",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "date-fns": "^3.2.0",
    "dns-js": "^0.3.1",
    "events": "^3.3.0",
    "mqtt": "^5.3.4",
    "process": "^0.11.10",
    "react": "18.2.0",
    "react-native": "0.73.2",
    "react-native-gesture-handler": "2.14.1",
    "react-native-keep-awake": "^4.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-paper": "^5.12.3",
    "react-native-reanimated": "3.6.1",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-screens": "3.29.0",
    "react-native-sound": "^0.11.2",
    "react-native-svg": "^14.1.0",
    "react-native-tcp-socket": "^6.4.1",
    "react-native-vector-icons": "^10.0.3",
    "stream-browserify": "^3.0.0",
    "url": "^0.11.3",
    "util": "^0.12.5",
    "uuid": "^9.0.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.8",
    "@babel/runtime": "^7.23.8",
    "@react-native/babel-preset": "^0.73.19",
    "@react-native/eslint-config": "^0.73.2",
    "@react-native/metro-config": "^0.73.3",
    "@react-native/typescript-config": "^0.73.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/react-native": "^12.4.3",
    "@types/react": "^18.2.48",
    "@types/react-native": "^0.73.0",
    "@types/uuid": "^9.0.7",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "react-native-asset": "^2.1.1",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true
}
