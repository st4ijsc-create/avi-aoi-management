<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>solbench</RootNamespace>
    <AssemblyName>solbench</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS1591;CS0618;NU1603;NU1701</NoWarn>
  </PropertyGroup>
  <!--
    Khuôn OT .NET của bộ tasks-api2 (2026-10-18). Phiên bản GHIM đúng bản có sẵn trong %USERPROFILE%\.nuget\packages
    của máy đo ⇒ restore KHÔNG cần mạng. Đổi phiên bản = đổi bộ đo (ghi README, chạy lại kiểm thước).
  -->
  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <PackageReference Include="MQTTnet.Server" Version="5.2.0.1603" />
    <PackageReference Include="NModbus" Version="3.0.83" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="1.5.378.156" />
  </ItemGroup>
</Project>
