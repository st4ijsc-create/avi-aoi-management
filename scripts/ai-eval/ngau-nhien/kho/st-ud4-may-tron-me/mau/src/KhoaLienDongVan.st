FUNCTION_BLOCK KhoaLienDongVan
VAR_INPUT
    YC_A : BOOL;
    YC_B : BOOL;
    YC_XA : BOOL;
END_VAR
VAR_OUTPUT
    VAN_A : BOOL;
    VAN_B : BOOL;
    VAN_XA : BOOL;
    XUNG_DOT : BOOL;
END_VAR
    XUNG_DOT := (BOOL_TO_INT(YC_A) + BOOL_TO_INT(YC_B) + BOOL_TO_INT(YC_XA)) > 1;
    VAN_A := YC_A AND NOT XUNG_DOT;
    VAN_B := YC_B AND NOT XUNG_DOT;
    VAN_XA := YC_XA AND NOT XUNG_DOT;
END_FUNCTION_BLOCK
