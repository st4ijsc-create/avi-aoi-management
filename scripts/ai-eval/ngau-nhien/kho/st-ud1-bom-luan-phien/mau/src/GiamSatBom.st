FUNCTION_BLOCK GiamSatBom
VAR_INPUT
    LENH : BOOL;
    PHAN_HOI : BOOL;
    RESET : BOOL;
    T_PHAN_HOI : TIME;
END_VAR
VAR_OUTPUT
    LOI : BOOL;
END_VAR
VAR
    tMat : TON;
END_VAR
    tMat(IN := LENH AND NOT PHAN_HOI, PT := T_PHAN_HOI);
    IF RESET THEN
        LOI := FALSE;
    ELSIF tMat.Q THEN
        LOI := TRUE;
    END_IF
END_FUNCTION_BLOCK
