FUNCTION_BLOCK KhoaDongCo
VAR_INPUT
    YC_LEN : BOOL;
    YC_XUONG : BOOL;
    CUA_DONG : BOOL;
    DUNG_KHAN : BOOL;
END_VAR
VAR_OUTPUT
    LEN : BOOL;
    XUONG : BOOL;
END_VAR
VAR
    choPhep : BOOL;
END_VAR
    choPhep := CUA_DONG AND NOT DUNG_KHAN AND NOT (YC_LEN AND YC_XUONG);
    LEN := YC_LEN AND choPhep;
    XUONG := YC_XUONG AND choPhep;
END_FUNCTION_BLOCK
