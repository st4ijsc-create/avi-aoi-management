# === AI Local Provider (100% local — cloud OpenAI đã gỡ khỏi code; aiProviderManager = gguf|offline) ===
# A0.1: biến cloud bên dưới đã comment vì CODE KHÔNG ĐỌC (giữ lịch sử).
# AI_PRIMARY_PROVIDER=openai   # (rác — không dùng)
# AI_FALLBACK_ENABLED=true     # (rác — không dùng)
# A0.6: 1 nguồn model duy nhất = D:/SOURCES/16.AI (tránh trùng lặp uploads/gguf-models).
GGUF_MODELS_DIR=D:/SOURCES/16.AI
# Upgrade 2026-06 (5090): Deep tier = Qwen3-30B-A3B (MoE, qwen3moe) — verify 166 tok/s GPU, RCA/report.
GGUF_DEFAULT_MODEL=Qwen3-30B-A3B-Instruct-2507-UD-Q4_K_XL.gguf
# Fast tier (Tier 1: intent/chat/extract) = Qwen3-4B — verify 178 tok/s GPU. Model Router tự chọn.
GGUF_FAST_MODEL=Qwen3-4B-Instruct-2507-UD-Q4_K_XL.gguf
# A1bis: RTX 5090 32GB → giữ nhiều model nóng + chạy song song thật trên GPU.
GGUF_MAX_LOADED_MODELS=4
GGUF_MAX_CONCURRENCY=4
GGUF_INFER_TIMEOUT_MS=180000
# B0.1 — VRAM threshold guard (%). Trước khi nạp model thứ N, nếu VRAM dùng ≥ ngưỡng này (% của tổng,
# RTX 5090 32GB), engine evict LRU idle trước; nếu không evict được thì CẢNH BÁO + trì hoãn (cho phép
# tràn tạm thời, KHÔNG crash). Đọc VRAM qua node-llama-cpp getVramState(), fallback `nvidia-smi`.
# Best-effort: lỗi telemetry KHÔNG ném. Đặt 0/≥100 để tắt. Mặc định 90.
GGUF_VRAM_GUARD_PCT=90
# B0.2 — KV-cache theo task. n_ctx mặc định khi không có hint từ Model Router (KHÔNG để ctx khổng lồ
# tốn VRAM). Router gửi hint nhỏ cho task trivial/fast, lớn cho task sâu. GGUF_MAX_CTX = trần cứng cho
# mọi hint (chống cấp phát KV-cache phi lý). Mặc định 4096 / 32768.
GGUF_DEFAULT_CTX=4096
GGUF_MAX_CTX=32768
# A1bis: GPU = RTX 5090 32GB (Blackwell sm_120). node-llama-cpp đã build CUDA tại chỗ (CUDA Toolkit 13.3).
# gpuLayers="max" trong aiGgufEngine → offload TOÀN BỘ layer. Đã verify 3B=244 tok/s, 7B nhanh tương ứng.
# CUDA runtime DLLs lấy từ %CUDA_PATH%\bin (Toolkit đã thêm vào system PATH); engine cũng tự prepend.
GGUF_GPU=auto
# Vision (Tier 3) = Qwen3-VL-8B + mmproj-F16 — verify 1.2s/ảnh GPU, OCR tốt hơn Qwen2.5-VL.
GGUF_VISION_MODEL=D:/SOURCES/16.AI/Qwen3-VL-8B-Instruct-UD-Q4_K_XL.gguf
GGUF_VISION_MMPROJ=D:/SOURCES/16.AI/Qwen3-VL-8B-mmproj-F16.gguf
GGUF_EMBEDDING_MODEL=Qwen3-Embedding-0.6B-f16.gguf
# ↑ KHÔNG được code đọc (giữ cho tương thích). Tên env CODE thật đọc cho embedding GGUF (G1/G4):
# Embedding (RAG/KB) = Qwen3-Embedding-0.6B — đa ngôn ngữ top, dim=1024 (verify, giữ schema). Cần re-embed KB.
GGUF_EMBED_MODEL=Qwen3-Embedding-0.6B-f16.gguf
GGUF_EMBED_DIM=1024
PREDICTIVE_MAINTENANCE_ENABLED=true

# A0.1 — Cloud/OpenAI: ĐÃ COMMENT (code 100% local, không gọi cloud).
# ⚠️ Key bên dưới là key thật — NÊN THU HỒI/ROTATE ở dashboard OpenAI vì đã từng nằm trong file.
# OPENAI_API_KEY=...
# AI_PRIMARY_PROVIDER=openai
# AI_VISION_CLOUD_MODEL=gpt-4o
# AI_TEXT_CLOUD_MODEL=gpt-4o-mini
# === AI Local Assistant (P0 tuning) ===
# A0.1 — Ollama: ĐÃ COMMENT (USE_LEGACY_OLLAMA=false → embeddings/KB/intent chạy GGUF in-process, không cần Ollama).
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_QA_MODEL=qwen2.5:3b-instruct
# OLLAMA_EMBED_MODEL=mxbai-embed-large:latest
# OLLAMA_VISION_MODEL=ollama-vision:latest
AI_TOOL_LLM_FALLBACK=1
# false = embeddings/KB/intent chạy GGUF in-process, KHÔNG cần Ollama daemon (đích Phase 191).
# Đổi về true để rollback nếu KB retrieval sút (xem cảnh báo cosine bên dưới).
USE_LEGACY_OLLAMA=false
KB_QA_NUM_PREDICT=350
KB_QA_CTX_CAP=1800
KB_QA_TIMEOUT_MS=45000

# =============================================================================
# 4.0 Infrastructure flags (Sprint hạ tầng S2) — bật sau migration 0111/0112/0113
# Chỉ bật các mục in-process / DB-backed (không cần dịch vụ ngoài).
# =============================================================================
# G4/G9 — refresh materialized views machine_status_latest + hourly_yield_cache (DB-only)
MATVIEW_REFRESH_ENABLED=true
MATVIEW_REFRESH_INTERVAL_MS=60000
# G11 — Prometheus /metrics (cần package prom-client; no-op nếu thiếu)
METRICS_ENABLED=true
# G8 — SSE realtime stream tại GET /api/stream (in-process)
SSE_ENABLED=true
# G0 — statement timeout cho mọi truy vấn (ms)
DB_STATEMENT_TIMEOUT_MS=30000
# G2 — dispatching realtime theo WIP/bottleneck (pure compute)
DISPATCHING_REALTIME_ENABLED=true
# G2/G7 — PdM tự sinh work-order từ predictedFailureRisk (ghi maintenance_work_orders)
PDM_WORKORDER_ENABLED=true

# --- Các flag cần DỊCH VỤ NGOÀI ---
# G6/G10 — Redis (Socket.IO adapter + distributedCache). Chạy qua: docker compose up -d redis
REDIS_URL=redis://localhost:6379
# G1 — UNS bridge → EMQX (broker MQTT HA). Chạy broker: docker compose up -d emqx
# EMQX map cổng lệch để tránh đụng aedes nội bộ: MQTT 1884, WS 8084, dashboard http://localhost:18083
UNS_BRIDGE_ENABLED=true
UNS_SPARKPLUG_ENABLED=true
UNS_BROKER_URL=mqtt://localhost:1884
# UNS_BROKER_USERNAME=
# UNS_BROKER_PASSWORD=
# G1/G3 — TimescaleDB cho time-series (energy_readings). Chạy: docker compose up -d timescaledb
# DB chính vẫn ở DATABASE_URL (PG18); đây là kết nối phụ. Bỏ comment để bật.
TSDB_URL=postgresql://tsdb:tsdb_pass@localhost:5433/avi_aoi_ts
# OPCUA_GATEWAY_ENABLED=true                # cần cài node-opcua + OPCUA_ENDPOINT_URL
# OPCUA_ENDPOINT_URL=opc.tcp://host:4840
# DR_VERIFY_ENABLED=true                    # cần pg_dump/pg_restore tooling + đích sao lưu
# SENTRY_DSN=                               # cần Sentry
# OTEL_EXPORTER_OTLP_ENDPOINT=              # cần OTel collector

# =============================================================================
# Tier 3 — GPU inference (B9) + Deep training (B8) + tính năng Nhánh B
# Kiểm tra môi trường: node scripts/check-tier3-env.mjs
# =============================================================================
# B9 — GPU ONNX inference qua DirectML (đã verify trên RTX 4050; KHÔNG cần CUDA Toolkit)
ENABLE_GPU=true
# AI_INFER_EP=dml             # override tường minh: dml | cuda | tensorrt | cpu
# AI_INFER_MAX_BATCH=4        # VRAM 6GB → 2-4; RTX 4090 (24GB) → 8-16

# B8 — Deep training Tier-2 sidecar (Python/PyTorch/ultralytics đã cài). Opt-in: chỉ chạy job trainingMode=local-sidecar.
LOCAL_TRAINER_CMD=python tools/trainer/train.py
# LOCAL_TRAINER_TIMEOUT_MS=7200000

# Vision local (WS-G2 / A1bis) — GPU: Qwen2.5-VL + mmproj-F16 + llama-server CUDA build b9814.
# RTX 5090 (Blackwell sm_120) — đã verify 0.4s/ảnh (CPU b8770 cũ là 8.9s → nhanh ~22×).
# CUDA runtime DLLs (cudart64_13/cublas64_13/cublasLt64_13) nằm cùng thư mục llama-cuda/.
LLAMA_SERVER_BIN=D:/SOURCES/16.AI/llama-cuda/llama-server.exe
LLAMA_VISION_HOST=127.0.0.1
LLAMA_VISION_PORT=8081
# A1bis: offload toàn bộ layer vision lên GPU (5090 32GB thừa sức).
LLAMA_VISION_GPU_LAYERS=999
# A0.3: giảm context để KHÔNG cấp ~7GB KV-cache cho 1 ảnh (mặc định model = 128k). 8192 đủ cho mô tả/QA ảnh.
LLAMA_VISION_CTX=8192
# B0.2 — Trần cứng cho LLAMA_VISION_CTX (chống cấp phát KV-cache khổng lồ nếu cấu hình nhầm). Mặc định 16384.
LLAMA_VISION_CTX_MAX=16384
LLAMA_VISION_READY_TIMEOUT_MS=180000
LLAMA_VISION_IDLE_TIMEOUT_MS=600000

# B3 go-live 2026-06-27: anomaly detection enabled (DINOv2 score on 100% imgs; VL gated to NG/suspect).
# NOTE: still need to build a PatchCore memory bank per product via aiAnomalyRouter.buildBank for scoring.
ANOMALY_DETECTION_ENABLED=true
# Anomaly bank auto-rebuild cron: refreshes PatchCore memory banks per scope from stored
# OK DINOv2 vectors when enough NEW OK samples accumulate. Enabled 2026-06-27 (user approved).
# Builds non-bootstrap banks once ≥ MIN_OK OK samples; rebuilds only when a scope's OK pool
# grew by ≥ REBUILD_DELTA (avoids churn). Fail-safe per scope; capped per run.
ANOMALY_BANK_AUTO_REBUILD_ENABLED=true
ANOMALY_BANK_REBUILD_CRON=0 3 * * *
ANOMALY_BANK_TZ=Asia/Ho_Chi_Minh
ANOMALY_BANK_MIN_OK=30
ANOMALY_BANK_REBUILD_DELTA=20
ANOMALY_BANK_SCOPE=machine
ANOMALY_BANK_MAX_SCOPES_PER_RUN=25
ANOMALY_BANK_MODEL_CODE=dinov2-small
ANOMALY_BANK_BACKFILL=true
ANOMALY_BANK_BACKFILL_LIMIT=5000
# B4: DINOv2-small ONNX (modelId=3) làm embedding ảnh mặc định. Bật sau khi re-embed lịch sử xong.
IMAGE_EMBEDDING_DEFAULT=onnx
# ALIGN_BEFORE_DIFF=true           # B4.2 golden-sample alignment (thuần JS — an toàn bật khi muốn)

# Embed-at-ingest (Phase A2/A4): tự sinh DINOv2 embedding cho ảnh AOI MỚI khi commit package.
# Non-blocking, idempotent, chỉ xử lý ảnh mới (không quét ảnh cũ đã mất). Đổi MODEL_CODE sang
# "dinov2-base" để dùng bản 768-d chính xác hơn. RESULT_FILTER=ALL để embed cả điểm OK.
AOI_EMBEDDING_ENABLED=true
AOI_EMBEDDING_MODEL_CODE=dinov2-small
AOI_EMBEDDING_CONCURRENCY=2
# ALL → embed cả ảnh OK (không chỉ NG) để PatchCore memory bank (ai_anomaly_*) có vector OK mà lớn dần.
AOI_EMBEDDING_RESULT_FILTER=ALL
AOI_EMBEDDING_MAX_POINTS=500

# 21 CFR Part 11 — HMAC secret cho supervisor sign-off (>=16 chars)
SIGNOFF_SECRET=v24V/WaLjieGNtrKL/4HNHfVq9CxgTbSMxLvo1GPwUo=

# ─────────────────────────────────────────────────────────────────────────────
# Phase B1 — "Bộ não điều phối" (orchestration + AI watcher). ADVISORY/NOTIFY ONLY.
# Master flags stay OFF here; the operator flips them at go-live (xem doc 04 §B1).
# Rules engine performs NOTIFY/AUDIT only; AI watcher writes ai_insights only.
# Neither ever issues a device-control command (all control stays behind HITL).
# ─────────────────────────────────────────────────────────────────────────────

# Orchestration rules engine (server/services/orchestration/rulesEngine.ts).
# When "true": subscribes NG_ALERT/SPC_VIOLATION on the event bus → audit +
# (optional) notify + republish 'orchestration.triggered'. Default OFF.
# B1 go-live 2026-06-27: advisory enabled (watcher only; agentic-write stays OFF).
ORCHESTRATION_ENABLED=true
# NG burst rule: ≥ THRESHOLD NG alerts for one machine within WINDOW_MS → fire.
# ORCH_NG_THRESHOLD=5            # default 5 (NG count to trigger a burst)
# ORCH_NG_WINDOW_MS=300000       # default 300000 (5-minute sliding window, ms)
# Comma-separated user IDs to notify on a trigger (empty ⇒ audit only, no notify).
# ORCH_NOTIFY_USER_IDS=

# AI orchestration watcher (server/services/orchestration/aiWatcher.ts).
# When "true": on 'orchestration.triggered' it asks the LOCAL LLM (routed via the
# Model Router → deep/Tier-2 reasoning model) for an RCA hypothesis + next step
# and persists an advisory ai_insights row. Advisory-only; never executes.
# Requires ORCHESTRATION_ENABLED=true to receive events. Default OFF.
# B1 go-live 2026-06-27: advisory watcher enabled.
AI_ORCHESTRATION_ENABLED=true
# Per-machine throttle to protect the GGUF inference slot (ms). Default 60000.
# AI_WATCHER_MIN_INTERVAL_MS=60000

# ─── AI Action Inbox — Auto-Proposer (server/services/aiAutoProposer.ts) ──────
# "AI Action Inbox" (push, 1-tap approve): on 'orchestration.triggered' the
# auto-proposer drafts a SAFE engineering write-action (today: NG-burst on a
# machine with an existing NG threshold → adjust_ng_threshold to a conservative,
# tool-bounded value) and PROPOSES it (HITL propose-only) into the inbox of the
# responsible maintenance/supervisor users who hold the tool's RBAC permission.
# NEVER confirms/executes; proposals expire (TTL) like any other. Requires
# ORCHESTRATION_ENABLED=true to receive triggers. Default OFF (safe no-op).
# Go-live 2026-06-27: enabled (NG-burst → auto-draft threshold proposal in responsible user's inbox; HITL).
AI_AUTO_PROPOSE_ENABLED=true
# Per-scope (rule:machine) throttle/dedup window (ms). Falls back to
# AI_WATCHER_MIN_INTERVAL_MS, else 60000.
# AI_AUTO_PROPOSE_MIN_INTERVAL_MS=60000

# Technician Copilot ③ — RCA Copilot: AI auto-diagnoses a defect (causal graph + RAG + SPC + anomaly +
# vision + deep model) → ranked hypotheses + a 1-tap fix (HITL propose). Go-live 2026-06-28.
AI_RCA_COPILOT_ENABLED=true
# Minimum hypothesis confidence to surface (0-1). Default 0.2.
# AI_RCA_MIN_CONFIDENCE=0.2

# Technician Copilot ② — Threshold/Param Advisor: AI computes LSL/USL/target (→ projected Cpk)
# for measurement points + NG warning/critical % from recent data; technician only approves
# (HITL: threshold approval for MP, propose+confirm for NG). Go-live 2026-06-28.
AI_THRESHOLD_ADVISOR_ENABLED=true
# Minimum samples before a recommendation is trusted (else degraded). Default 300.
# AI_THRESHOLD_ADVISOR_MIN_SAMPLES=300

# Threshold Auto-Tune cron — once enough new data accumulates and a threshold is
# suboptimal, PROPOSES a tuned value (HITL): NG → adjust_ng_threshold in the
# responsible users' inbox (1-tap approve); measurement point → threshold-approval
# request in the approval queue. NEVER auto-applies. Go-live 2026-06-28.
AI_THRESHOLD_AUTOTUNE_ENABLED=true
# AI_THRESHOLD_AUTOTUNE_CRON=0 4 * * *
# AI_THRESHOLD_AUTOTUNE_TZ=Asia/Ho_Chi_Minh
# Min recent samples in scope to even consider tuning. Default 300.
# AI_THRESHOLD_AUTOTUNE_MIN_SAMPLES=300
# Only propose a point when current Cpk < this target. Default 1.33.
# AI_THRESHOLD_AUTOTUNE_CPK_TARGET=1.33
# Min material change to bother: ΔCpk (points) OR relative NG warn/crit shift. Default 0.1.
# AI_THRESHOLD_AUTOTUNE_MIN_DELTA=0.1
# Max proposals per run (cap; deferred count is logged). Default 20.
# AI_THRESHOLD_AUTOTUNE_MAX_PER_RUN=20
# Scope: ng | point | both. Default both.
# AI_THRESHOLD_AUTOTUNE_SCOPE=both
# Per-scope re-propose cooldown (ms). Default 86400000 (24h).
# AI_THRESHOLD_AUTOTUNE_THROTTLE_MS=86400000
# Recency window (days) for sample counts + advisor. Default 30.
# AI_THRESHOLD_AUTOTUNE_WINDOW_DAYS=30

# Technician Copilot ① — Setup Advisor: new-machine wizard pre-fills config from the most similar
# machine/product (points/thresholds/station/model); thresholds with data → suggested, else copied
# (cron tunes later). Advisory; technician approves via the normal wizard. Go-live 2026-06-28.
AI_SETUP_ADVISOR_ENABLED=true
# Per-point sample count to suggest (vs copy) thresholds. Default 200.
# AI_SETUP_ADVISOR_MIN_SAMPLES=200
# Max proposals created per trigger run (cap on fan-out to users). Default 5.
# AI_AUTO_PROPOSE_MAX_PER_RUN=5
# How much NG-burst tightens the warning threshold, relative (0–1). Default 0.2.
# AI_AUTO_PROPOSE_NG_TIGHTEN=0.2

# B1 agentic-write (server/services/aiAgentOrchestrator.ts). When "1": multi-step agentic
# sessions allowed for AGENTIC_ROLES; every write still goes through HITL propose→confirm.
# Single-tool propose→confirm works for ANY role holding the tool's RBAC permission.
# B1 go-live 2026-06-27: enabled. Engineering write-tools require settings_alerts/settings_products.
AI_AGENTIC_ENABLED=1

# ─── Phase B2 — GraphRAG production (additive, all default OFF) ────────────────
# B2.2 Reranker — embed→cosine top-K then rerank→top-5. Biggest RAG precision lever.
# B2 go-live 2026-06-27: reranker ON in "llm" mode (uses Qwen3-4B, no new model needed).
RAG_RERANKER_ENABLED=true
RAG_RERANKER_MODE=llm
# GGUF_RERANKER_MODEL=                  # set to a reranker GGUF filename to switch MODE=gguf (not downloaded)
RAG_RERANKER_POOL=20
RAG_RERANKER_MAX_CANDIDATES=20
RAG_RERANKER_DOC_CHARS=480
RAG_RERANKER_BLEND=0.85
# B2.3 Causal knowledge graph — knowledge/causal-graph.json (machine↔defect↔cause↔action).
RAG_CAUSAL_GRAPH_ENABLED=true
# B2.4 Auto-ingest — append new RCA/insight records back into the file KB (self-enriching).
RAG_AUTO_INGEST_ENABLED=true

# --- B4.3 Automated Executive Reports (AI exec summary) ---
# B4 go-live 2026-06-27: enabled (cron shift/day/week → deep model synthesizes KPI summary).
EXEC_REPORT_ENABLED=true
EXEC_REPORT_SCHEDULE=shift,day,week
EXEC_REPORT_LANG=vi
EXEC_REPORT_TZ=Asia/Ho_Chi_Minh
# PUSH the report to managers (in-app + optional email) so they don't have to pull.
# In-app notification is ON by default once reports are on; safe no-op if no recipients.
EXEC_REPORT_NOTIFY_ENABLED=true
# Roles to notify (csv). Default admin,supervisor. Resolved against active users.
EXEC_REPORT_NOTIFY_ROLES=admin,supervisor
# Extra explicit user ids to notify (csv), merged + deduped with the role set.
EXEC_REPORT_NOTIFY_USER_IDS=
# Also email the report (HTML + text). Requires SMTP_HOST/SMTP_USER/SMTP_PASS configured. Default OFF.
EXEC_REPORT_EMAIL_ENABLED=false

# --- B5 MLOps (advisory; risky auto-promotion stays OFF) ---
# Self-learning cron: scans uncertainty + FLAGS retrain candidates only (never auto-trains). Safe.
AI_SELF_LEARNING_ENABLED=true
# Drift monitor: PSI + mean/std shift over inference confidence → advisory alert. Safe.
AI_DRIFT_MONITOR_ENABLED=true
# ⚠️ KEPT OFF on purpose: silent auto-promotion of a retrained model to production. Promote via human/canary.
# AI_AUTO_PROMOTE_ENABLED=false

# --- B4.2 golden-sample alignment (pure JS, safe) ---
ALIGN_BEFORE_DIFF=true

# --- SECS/GEM Connectivity FRAMEWORK (semiconductor equipment, SEMI E5/E30/E37) ---
# HONEST, FLAG-GATED FRAMEWORK — NOT a certified production GEM driver. Going live
# needs REAL equipment + full SECS-II codec / GEM state-machine validation (or a
# vetted SECS library). When OFF, secsGem.testConnection opens NO socket. Default OFF.
SECS_GEM_ENABLED=false
