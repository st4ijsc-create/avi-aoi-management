{
  "name": "avi-ai-local",
  "displayName": "AI Local (ST4I)",
  "description": "Trợ lý lập trình AI chạy nội bộ — agent sửa trực tiếp dự án qua lõi agent dùng chung, mọi lượt ghi qua một điểm ghi có kiểm toán.",
  "version": "0.3.1",
  "publisher": "st4i",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aviAiLocalThanhBen",
          "title": "AI Local",
          "icon": "media/thanh-ben.svg",
          "when": "aviAiLocal:khongHoTroThanhBenPhu"
        }
      ],
      "secondarySidebar": [
        {
          "id": "aviAiLocalThanhBenPhu",
          "title": "AI Local",
          "icon": "media/thanh-ben.svg",
          "when": "!aviAiLocal:khongHoTroThanhBenPhu"
        }
      ]
    },
    "views": {
      "aviAiLocalThanhBen": [
        {
          "id": "aviAiLocal.bangChat",
          "name": "AI Local",
          "type": "webview",
          "when": "aviAiLocal:khongHoTroThanhBenPhu"
        }
      ],
      "aviAiLocalThanhBenPhu": [
        {
          "id": "aviAiLocal.bangChatPhu",
          "name": "AI Local",
          "type": "webview",
          "when": "!aviAiLocal:khongHoTroThanhBenPhu"
        }
      ]
    },
    "commands": [
      {
        "command": "aviAiLocal.moBangChat",
        "title": "AI Local: Mở bảng trò chuyện"
      },
      {
        "command": "aviAiLocal.dangNhapThietBi",
        "title": "AI Local: Đăng nhập AI Local (device flow)"
      },
      {
        "command": "aviAiLocal.dangNhap",
        "title": "AI Local: Đăng nhập phiên (mật khẩu)"
      },
      {
        "command": "aviAiLocal.dangXuat",
        "title": "AI Local: Đăng xuất"
      },
      {
        "command": "aviAiLocal.suaDoanChon",
        "title": "AI Local: Sửa đoạn đang chọn (hỏi AI)"
      },
      {
        "command": "aviAiLocal.chatMoi",
        "title": "AI Local: Chat mới",
        "icon": "$(add)"
      },
      {
        "command": "aviAiLocal.lichSu",
        "title": "AI Local: Lịch sử",
        "icon": "$(history)"
      },
      {
        "command": "aviAiLocal.mcpServers",
        "title": "AI Local: Quản lý MCP server ngoài"
      },
      {
        "command": "aviAiLocal.nhoDieuNay",
        "title": "AI Local: Nhớ điều này"
      },
      {
        "command": "aviAiLocal.boNho",
        "title": "AI Local: Bộ nhớ dài hạn",
        "icon": "$(book)"
      },
      {
        "command": "aviAiLocal.doiMayChu",
        "title": "AI Local: Đổi địa chỉ máy chủ"
      },
      {
        "command": "aviAiLocal.hoanTacLuotChay",
        "title": "AI Local: Hoàn tác lượt chạy agent",
        "icon": "$(discard)"
      },
      {
        "command": "aviAiLocal.batTatGhostText",
        "title": "AI Local: Bật/tắt gợi ý chữ mờ (ghost-text)"
      }
    ],
    "keybindings": [
      {
        "command": "aviAiLocal.suaDoanChon",
        "key": "ctrl+alt+k",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aviAiLocal.chatMoi",
          "when": "view == aviAiLocal.bangChat",
          "group": "navigation"
        },
        {
          "command": "aviAiLocal.lichSu",
          "when": "view == aviAiLocal.bangChat",
          "group": "navigation"
        },
        {
          "command": "aviAiLocal.boNho",
          "when": "view == aviAiLocal.bangChat",
          "group": "navigation"
        },
        {
          "command": "aviAiLocal.chatMoi",
          "when": "view == aviAiLocal.bangChatPhu",
          "group": "navigation"
        },
        {
          "command": "aviAiLocal.lichSu",
          "when": "view == aviAiLocal.bangChatPhu",
          "group": "navigation"
        },
        {
          "command": "aviAiLocal.boNho",
          "when": "view == aviAiLocal.bangChatPhu",
          "group": "navigation"
        },
        {
          "command": "aviAiLocal.dangNhap",
          "when": "view == aviAiLocal.bangChat",
          "group": "1_taiKhoan@1"
        },
        {
          "command": "aviAiLocal.dangXuat",
          "when": "view == aviAiLocal.bangChat",
          "group": "1_taiKhoan@2"
        },
        {
          "command": "aviAiLocal.doiMayChu",
          "when": "view == aviAiLocal.bangChat",
          "group": "2_cauHinh@1"
        },
        {
          "command": "aviAiLocal.mcpServers",
          "when": "view == aviAiLocal.bangChat",
          "group": "2_cauHinh@2"
        },
        {
          "command": "aviAiLocal.nhoDieuNay",
          "when": "view == aviAiLocal.bangChat",
          "group": "3_boNho@1"
        },
        {
          "command": "aviAiLocal.dangNhap",
          "when": "view == aviAiLocal.bangChatPhu",
          "group": "1_taiKhoan@1"
        },
        {
          "command": "aviAiLocal.dangXuat",
          "when": "view == aviAiLocal.bangChatPhu",
          "group": "1_taiKhoan@2"
        },
        {
          "command": "aviAiLocal.doiMayChu",
          "when": "view == aviAiLocal.bangChatPhu",
          "group": "2_cauHinh@1"
        },
        {
          "command": "aviAiLocal.mcpServers",
          "when": "view == aviAiLocal.bangChatPhu",
          "group": "2_cauHinh@2"
        },
        {
          "command": "aviAiLocal.nhoDieuNay",
          "when": "view == aviAiLocal.bangChatPhu",
          "group": "3_boNho@1"
        },
        {
          "command": "aviAiLocal.dangNhapThietBi",
          "when": "view == aviAiLocal.bangChat",
          "group": "1_taiKhoan@0"
        },
        {
          "command": "aviAiLocal.hoanTacLuotChay",
          "when": "view == aviAiLocal.bangChat",
          "group": "4_agent@1"
        },
        {
          "command": "aviAiLocal.dangNhapThietBi",
          "when": "view == aviAiLocal.bangChatPhu",
          "group": "1_taiKhoan@0"
        },
        {
          "command": "aviAiLocal.hoanTacLuotChay",
          "when": "view == aviAiLocal.bangChatPhu",
          "group": "4_agent@1"
        }
      ]
    },
    "configuration": {
      "title": "AI Local",
      "properties": {
        "aviAiLocal.serverUrl": {
          "type": "string",
          "scope": "machine",
          "default": "http://localhost:3000",
          "description": "Địa chỉ máy chủ AI Local (box chạy model)."
        },
        "aviAiLocal.anhChoTroLy": {
          "type": "boolean",
          "default": false,
          "description": "Cho phép đính ảnh (dán/kéo/chọn) khi hỏi Trợ lý. Mặc định TẮT: máy chủ phải nạp model thị giác (tốn VRAM, thêm độ trễ). Chỉ bật khi quản trị đã bật đọc ảnh."
        },
        "aviAiLocal.nganSachNguCanh": {
          "type": "number",
          "default": 24000,
          "description": "Trần số ký tự mã nguồn gửi kèm mỗi lượt hỏi."
        },
        "aviAiLocal.uiLanguage": {
          "type": "string",
          "enum": [
            "vi",
            "en",
            "zh"
          ],
          "default": "vi",
          "description": "Ngôn ngữ trả lời."
        },
        "aviAiLocal.mcpServers": {
          "type": "object",
          "scope": "machine",
          "default": {},
          "description": "MCP server ngoài mà AI Local được phép gọi ra (khuôn mcpServers quen thuộc). Mỗi khoá là tên server, giá trị mang command/args/cwd/env. KHÔNG cho workspace ghi đè (bài học Đợt A: aviAiLocal.serverUrl thiếu scope từng để một repo thù địch chiếm đường dữ liệu qua .vscode/settings.json) — sửa ở User Settings, phạm vi Máy. Mỗi server phải được người dùng DUYỆT lần đầu (hộp thoại xác nhận trước khi tiến trình được chạy)."
        },
        "aviAiLocal.agentModel": {
          "type": "string",
          "scope": "machine",
          "default": "chat",
          "description": "Model logic của cổng /v1 cho agent (chat | code). Đổi khi quản trị cấu hình model lập trình riêng (GGUF_CODE_MODEL)."
        },
        "aviAiLocal.agentMaxTokens": {
          "type": "number",
          "scope": "machine",
          "default": 16000,
          "minimum": 512,
          "description": "Trần token sinh của MỘT lượt model trong agent (gồm cả suy luận). Lõi agent còn có trần tổng của lượt chạy."
        },
        "aviAiLocal.ghostText.enabled": {
          "type": "boolean",
          "scope": "machine",
          "default": false,
          "description": "Bật gợi ý chữ mờ khi gõ (ghost-text, kiểu Copilot) qua POST /v1/completions (model logic fim). Cần token /v1 (device flow). Chỉ gửi ~2.000 ký tự trước + ~800 ký tự sau con trỏ, đã che bí mật; không bao giờ gửi .env/khoá riêng/.git/tệp ngoài workspace. Phạm vi Máy: một repo lạ không tự bật được."
        },
        "aviAiLocal.ghostText.doTreMs": {
          "type": "number",
          "scope": "machine",
          "default": 250,
          "minimum": 50,
          "maximum": 2000,
          "description": "Thời gian ngừng gõ (ms) trước khi xin gợi ý ghost-text (gỡ dội)."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "build": "node build.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "test-that": "node build.mjs && node test-real-host/build.mjs && node test-real-host-out/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.12",
    "glob": "^13.0.6",
    "marked": "16.4.2",
    "mocha": "^11.8.0",
    "typescript": "^5.6.3"
  }
}
