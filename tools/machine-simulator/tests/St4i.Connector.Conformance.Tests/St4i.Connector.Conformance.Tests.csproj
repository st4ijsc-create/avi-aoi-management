<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- GP-6 — the negative-control proof: deliberately non-conforming fake IDeviceDriver implementations
         (see Fakes/) plus the tests proving DeviceDriverConformanceSuite's checks actually REJECT each one.
         Plain net10.0, matching St4i.Connector.Conformance.csproj itself — no St4i.EdgeCore/EngineApi in
         reach, same reasoning as St4i.Connector.Abstractions.Tests. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test-hygiene batch — the shared, disposable scratch root every test assembly installs before its
         first test runs (see tests/Shared/TestRunTempRoot.cs for the full rationale and the measured
         numbers). LINKED, not copied: one module initializer per assembly, one definition to maintain.
         Without it this suite writes into the real %TEMP% and the real %ProgramData%\ST4I\sim\creds and
         never cleans up either. -->
    <Compile Include="..\Shared\TestRunTempRoot.cs" Link="TestRunTempRoot.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\St4i.Connector.Conformance\St4i.Connector.Conformance.csproj" />
  </ItemGroup>
</Project>
