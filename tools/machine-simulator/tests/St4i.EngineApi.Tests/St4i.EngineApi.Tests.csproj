<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test-hygiene batch — the shared, disposable scratch root every test assembly installs before its
         first test runs (see tests/Shared/TestRunTempRoot.cs for the full rationale and the measured
         numbers). LINKED, not copied: one module initializer per assembly, one definition to maintain.
         Without it this suite writes into the real %TEMP% and the real %ProgramData%\ST4I\sim\creds and
         never cleans up either. -->
    <Compile Include="..\Shared\TestRunTempRoot.cs" Link="TestRunTempRoot.cs" />
    <!-- Task K-1 — the guard that measures the CONSEQUENCE rather than the naming: the REAL
         %ProgramData%\ST4I\sim\creds must not GAIN a file while this assembly's process runs (see
         tests/Shared/RealCredentialStoreLeakGuard.cs for what it does and does not see). LINKED into all
         five suites for the same reason as the line above — each process is its own measurement, and a
         guard installed in one suite says nothing about the other four. -->
    <Compile Include="..\Shared\RealCredentialStoreLeakGuard.cs" Link="RealCredentialStoreLeakGuard.cs" />
    <!-- Task X-1 — the same consequence-measuring shape turned on the OTHER directory that survives a run:
         this assembly's OWN OUTPUT DIRECTORY, which `dotnet build` does not clean and which three of the
         product's stores resolve to by default. THIS is the project the measurement was taken on: its
         output directory held a products.json of 625 products (623 of them minted one per run) and a
         machine-operating-config.json of 240,778 bytes. LINKED into all five anyway — see
         tests/Shared/OwnOutputDirectoryGuard.cs for the domain it declares and for the two stores it
         exempts because they have no relocation seam. -->
    <Compile Include="..\Shared\OwnOutputDirectoryGuard.cs" Link="OwnOutputDirectoryGuard.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- WS-D-D1 — TEST-ONLY (per the task's global constraint: no new PRODUCT NuGet). Lets
         AuthPipelineTests boot the REAL St4i.EngineApi composition root in-memory
         (WebApplicationFactory<Program>) instead of hand-duplicating Program.cs's DI/pipeline wiring —
         the only way to actually exercise the default-deny fallback policy end to end. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\St4i.EngineApi\St4i.EngineApi.csproj" />
  </ItemGroup>
</Project>
