<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- GP-2 (.superpowers/sdd/2026-07-28-wsg-plugin-connector-seam-blueprint/task-2-brief.md) — plain
         net10.0 (not -windows), matching St4i.Connector.Abstractions.csproj itself. This test project
         references ONLY that one assembly (see the ProjectReference below) — deliberately: a third-party
         driver author's own test suite for a sidecar built against the published contract would look
         exactly like this, with no St4i.EdgeCore/EngineApi/WPF host code in reach. If the round-trip test
         below only compiled because some host assembly's JSON options leaked in, that would prove
         nothing about the connector wire format actually being self-contained. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test-hygiene batch — the shared, disposable scratch root every test assembly installs before its
         first test runs (see tests/Shared/TestRunTempRoot.cs for the full rationale and the measured
         numbers). LINKED, not copied: one module initializer per assembly, one definition to maintain.
         Without it this suite writes into the real %TEMP% and the real %ProgramData%\ST4I\sim\creds and
         never cleans up either. -->
    <Compile Include="..\Shared\TestRunTempRoot.cs" Link="TestRunTempRoot.cs" />
    <!-- Task K-1 — the guard that measures the CONSEQUENCE rather than the naming: the REAL
         %ProgramData%\ST4I\sim\creds must not GAIN a file while this assembly's process runs (see
         tests/Shared/RealCredentialStoreLeakGuard.cs for what it does and does not see). LINKED into all
         five suites for the same reason as the line above — each process is its own measurement, and a
         guard installed in one suite says nothing about the other four. It reads the product source to
         derive the directory and adds no assembly reference, so this project's deliberate
         one-ProjectReference boundary is untouched. -->
    <Compile Include="..\Shared\RealCredentialStoreLeakGuard.cs" Link="RealCredentialStoreLeakGuard.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\St4i.Connector.Abstractions\St4i.Connector.Abstractions.csproj" />
  </ItemGroup>
</Project>
