<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test-hygiene batch — the shared, disposable scratch root every test assembly installs before its
         first test runs (see tests/Shared/TestRunTempRoot.cs for the full rationale and the measured
         numbers). LINKED, not copied: one module initializer per assembly, one definition to maintain.
         Without it this suite writes into the real %TEMP% and the real %ProgramData%\ST4I\sim\creds and
         never cleans up either. -->
    <Compile Include="..\Shared\TestRunTempRoot.cs" Link="TestRunTempRoot.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- GĐ3 sub-3 OU-1 (OPC-UA driver) — TEST-ONLY: the OPC Foundation reference SERVER stack (same
         1.5.378.156 MIT release as the Client package St4i.EdgeCore references), used ONLY to stand up an
         in-process loopback OPC-UA server (OpcUaDriverLoopbackTests) that proves OpcUaDriver's session
         round-trip end-to-end with no real PLC. Never shipped — the production driver is client-only, per
         the GĐ3 sub-3 blueprint's locked decision #2. -->
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Server" Version="1.5.378.156" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\St4i.EdgeCore\St4i.EdgeCore.csproj" />
    <!-- GP-6 — the shared conformance suite, applied to SimulatedDriver/ModbusTcpDriver/OpcUaDriver below
         (see Drivers/*ConformanceTests.cs). -->
    <ProjectReference Include="..\..\src\St4i.Connector.Conformance\St4i.Connector.Conformance.csproj" />
  </ItemGroup>
</Project>
