/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# SM-6 — the isolated %ProgramData%\ST4I\sim\* stand-in playwright.config.ts's webServer env block
# redirects the engine to (security/assets/alarms/etc.). Wiped before every run by
# scripts/reset-engine-state.mjs; never intentionally committed content.
/.e2e-data/

