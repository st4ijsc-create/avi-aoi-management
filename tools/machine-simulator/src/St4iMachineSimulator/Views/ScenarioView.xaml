<UserControl x:Class="St4iMachineSimulator.Views.ScenarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:St4iMachineSimulator.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ScenarioViewModel}"
             d:DesignWidth="1000" d:DesignHeight="760">
    <!--
        Task 19b — Scenario (doc 62 §5.10 "Scenario"): sliders + preset buttons that visibly change the
        RUNNING fleet's behavior for demonstrations. CycleRate/DefectRate/FaultRate/NetworkOutage apply
        LIVE the instant they change (every drag calls FleetService.ApplyScenario — see
        ScenarioViewModel's remarks), Burst is a one-shot 4s speed spike, and the 5 preset buttons are
        the exhibit's canned demo script (normal / high-defect lot / sensor drift / network outage /
        hot-folder AOI closed loop).
    -->
    <UserControl.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Bg.Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SectionSubtextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="SliderRowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SliderValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="MinWidth" Value="64" />
        </Style>

        <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Width" Value="280" />
            <Setter Property="Height" Value="92" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <!-- ═══ Header ═══════════════════════════════════════════ -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource Str_Scenario_Title}" FontSize="20" FontWeight="Bold" />
                <TextBlock Style="{StaticResource SectionSubtextStyle}"
                           Text="Sliders + preset trình diễn — thay đổi ở đây tác động THẬT lên fleet đang chạy (tốc độ chu kỳ, tỷ lệ lỗi tiêm thêm, sự cố mạng)." />
            </StackPanel>

            <!-- ═══ Status line ═════════════════════════════════════════ -->
            <Border Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Scenario_StatusHeader}" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="{Binding StatusLine}" Style="{StaticResource SectionSubtextStyle}" Margin="0,8,0,0" FontSize="13" />
                    <TextBlock Text="{Binding HotFolderStatus}"
                               Style="{StaticResource SectionSubtextStyle}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Visibility="{Binding HotFolderStatus, Converter={StaticResource NullToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- ═══ Sliders ═══════════════════════════════════════════ -->
            <Border Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Scenario_LiveAdjustHeader}" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Style="{StaticResource SectionSubtextStyle}"
                               Text="Mỗi lần kéo áp dụng ngay lên fleet đang chạy (FleetService.ApplyScenario) — không cần bấm nút nào thêm." />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str_Scenario_CycleRate}" Style="{StaticResource SliderRowLabelStyle}" />
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="0.25" Maximum="8" SmallChange="0.05" LargeChange="0.5"
                                Value="{Binding CycleRate, Mode=TwoWay}" VerticalAlignment="Center" Margin="12,0" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding CycleRate, StringFormat={}{0:0.00}x}" Style="{StaticResource SliderValueStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Str_Scenario_DefectRate}" Style="{StaticResource SliderRowLabelStyle}" Margin="0,14,0,0" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                Value="{Binding DefectRate, Mode=TwoWay}" VerticalAlignment="Center" Margin="12,14,12,0" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DefectRate, StringFormat={}{0:P0}}" Style="{StaticResource SliderValueStyle}" Margin="0,14,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Str_Scenario_FaultRate}" Style="{StaticResource SliderRowLabelStyle}" Margin="0,14,0,0" />
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                Value="{Binding FaultRate, Mode=TwoWay}" VerticalAlignment="Center" Margin="12,14,12,0" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding FaultRate, StringFormat={}{0:P0}}" Style="{StaticResource SliderValueStyle}" Margin="0,14,0,0" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <CheckBox Content="{DynamicResource Str_Scenario_NetworkOutage}" IsChecked="{Binding NetworkOutage, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="0,0,24,0" />
                        <Button Content="{DynamicResource Str_Scenario_Burst}" Style="{StaticResource TopBarButtonStyle}" Command="{Binding BurstCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ Presets ═══════════════════════════════════════════ -->
            <Border Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Scenario_PresetsHeader}" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Style="{StaticResource SectionSubtextStyle}"
                               Text="Mỗi nút đặt lại cả 3 slider + trạng thái mạng, rồi áp dụng một lần lên fleet đang chạy." />

                    <ItemsControl ItemsSource="{Binding Presets}" Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ScenarioPreset}">
                                <Button Style="{StaticResource PresetButtonStyle}"
                                        Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource SectionSubtextStyle}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
