<UserControl x:Class="St4iMachineSimulator.Controls.KpiTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:St4iMachineSimulator.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:KpiViewModel}"
             d:DesignWidth="180" d:DesignHeight="90">
    <!--
        One aggregate KPI tile (Task 15 dashboard top row: ONLINE / TOTAL CYCLES / FPY). Its DataContext
        IS the KpiViewModel instance — FleetViewModel.Kpis feeds an ItemsControl whose ItemTemplate is
        this control, so no dependency properties are needed (unlike StatusLight, which is bound from a
        DataContext that ISN'T its own display model).
    -->
    <Border Background="{StaticResource Brush.Bg.Panel}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="18,14"
            MinWidth="160">
        <StackPanel>
            <TextBlock Text="{Binding Label}"
                       Foreground="{StaticResource Brush.Text.Secondary}"
                       FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ValueText}"
                       Foreground="{StaticResource Brush.Accent}"
                       FontSize="28" FontWeight="Bold"
                       Margin="0,4,0,0" />
            <TextBlock Text="{Binding SubText}"
                       Foreground="{StaticResource Brush.Text.Muted}"
                       FontSize="11"
                       Margin="0,2,0,0"
                       Visibility="{Binding SubText, Converter={StaticResource NullToVisibilityConverter}}" />
        </StackPanel>
    </Border>
</UserControl>
