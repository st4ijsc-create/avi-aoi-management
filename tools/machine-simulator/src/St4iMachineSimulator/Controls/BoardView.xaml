<UserControl x:Class="St4iMachineSimulator.Controls.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:St4i.EdgeCore.Models;assembly=St4i.EdgeCore"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignWidth="640" d:DesignHeight="480">
    <!--
        Task 16 — AOI board view: draws each bound MeasurementResult's Bbox as a positioned rectangle
        over a fixed BoardWidthPx x BoardHeightPx coordinate space (defaults to 1600x1200, matching
        AoiInspectorSim's own bbox_px domain — see its BoardWidthPx/BoardHeightPx consts), wrapped in a
        Viewbox so the whole board scales UNIFORMLY to whatever size MachineDetailView gives this
        control, with no manual pixel-to-control scale math needed on the C# side.

        Only points that actually carry a Bbox draw a rectangle — this build's simulator only stamps
        one for NG points (see AoiInspectorSim.BuildOkMeasurement, which omits it), so OK points render
        nothing rather than stacking invisibly at (0,0). That's handled by the ItemContainerStyle's
        null DataTrigger below, applied to the generated ContentPresenter (Canvas positions its direct
        children via attached properties read off THOSE containers, not off the DataTemplate's root
        element, so Canvas.Left/Top must be set via ItemContainerStyle rather than in the DataTemplate).
    -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="{Binding BoardWidthPx, ElementName=Root}"
                Height="{Binding BoardHeightPx, ElementName=Root}"
                Background="{StaticResource Brush.Bg.PanelRaised}">
            <ItemsControl ItemsSource="{Binding Points, ElementName=Root}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Bbox.X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Bbox.Y}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Bbox}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:MeasurementResult}">
                        <Border Width="{Binding Bbox.W}" Height="{Binding Bbox.H}"
                                BorderThickness="2"
                                BorderBrush="{Binding Result, Converter={StaticResource ResultToBrushConverter}}"
                                ToolTip="{Binding PointCode}">
                            <TextBlock Text="{Binding PointCode}"
                                       FontSize="9" FontWeight="Bold"
                                       VerticalAlignment="Top" HorizontalAlignment="Left"
                                       Margin="1"
                                       Foreground="{Binding Result, Converter={StaticResource ResultToBrushConverter}}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>
    </Viewbox>
</UserControl>
