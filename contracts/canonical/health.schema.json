{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contracts/canonical/health.schema.json",
  "title": "Health",
  "description": "LDS-L1 canonical adapter/asset health heartbeat (doc 44 G2.5). Published on syn/{site}/{area}/{line}/{cell}/{equip}/health (retained; LWT sets status=offline). additionalProperties stays open.",
  "x-subject": "syn/+/+/+/+/+/health",
  "x-owner": "platform",
  "type": "object",
  "properties": {
    "asset_id": { "type": "string", "description": "Canonical asset identifier" },
    "status": { "type": "string", "enum": ["online", "degraded", "offline"], "description": "Connectivity/health status" },
    "last_seen": { "type": "string", "description": "ISO-8601 timestamp of last successful device exchange" },
    "latency_ms": { "type": "number", "description": "Round-trip latency to the device (ms)" },
    "error_rate": { "type": "number", "description": "Recent error rate 0..1 (rolling window)" },
    "adapter": {
      "type": "object",
      "description": "Adapter process resource usage",
      "properties": {
        "cpu": { "type": "number", "description": "CPU usage 0..1 (or percent — unit fixed per adapter)" },
        "mem_mb": { "type": "number", "description": "Resident memory (MB)" }
      }
    }
  },
  "required": ["asset_id", "status", "last_seen"]
}
