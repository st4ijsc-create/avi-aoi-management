# =============================================================================
# SYNAPSE — Environment Configuration
# Copy this file to .env and fill in your values before starting the server.
# =============================================================================

# --- Server ---
NODE_ENV=production
PORT=3000

# =============================================================================
# SYNAPSE Edition & collapsible deployment (doc 33 §3.1 / F1 · ADR-007).
# ONE codebase → machine | line | site. The edition BOUNDS the license (allowed
# modules + quota ceilings); it never grants beyond it. Default (unset) = site =
# fully backward-compatible. Source of truth: shared/editions.ts · see deploy/EDITIONS.md.
# =============================================================================
# EDITION=site                 # machine | line | site   (default: site)
# INFRA_PROFILE=external       # embedded | external     (default: edition's own default)
# EDITION_PROFILE=false        # F1 flag — when false, edition/infra resolution is advisory-only
# PLUGIN_MANIFEST=false        # F2 flag (SYNAPSE ADR-008) — advisory: plugin manifest catalogue +
#                              # apiVersion gate + auto-form. Manifests are metadata (no control path).
# SEC_PLATFORM=false           # F5 flag (SYNAPSE §5.11) — advisory: policy-as-code engine +
#                              # hash-chain WORM audit. Pure evaluators; callers opt in (write-gate).
# RBAC_SCOPED_ADMIN=false      # doc 48 R4 — scoped admin. OFF (default): admin passes every
#                              # permission check (legacy god-mode). ON: admin is subject to
#                              # EXPLICIT restriction rows (a permissions row with action=false
#                              # denies that admin+module+action); no row / expired / DB-down →
#                              # admin still passes (never lock an admin out of an unconfigured
#                              # module). Non-admins unaffected. Makes admin authority
#                              # restrictable + auditable per module without lockout risk.
# OBSERVABILITY=false          # F6 flag (SYNAPSE §5.12) — advisory: SLO/error-budget/burn-rate +
#                              # decision-trace + correlation backbone. Full OTLP export = later wave.
# SCHEMA_REGISTRY=false        # F7 flag (SYNAPSE §5.6/§8) — advisory: schema BACKWARD gate +
#                              # published OpenAPI/AsyncAPI + reconciliation engine. Pure; opt-in.
# RECONCILE_CRON=false         # I6 (SYNAPSE §5.9.2) — daily reconciliation cron. OFF → not scheduled;
#                              # the cycle is still invokable on demand. Providers (MES/ERP/WMS) plug in.
# RECONCILE_INTERVAL_MS=86400000 # reconciliation cadence when RECONCILE_CRON on (default 24h, min 60s).
# RECONCILE_EXAMPLE_URL=       # doc 33 §11 — register the example REST provider against this URL (GET →
#                              # {internal?,external,toleranceAbs?,toleranceRel?}). A real MES/ERP is the same interface.
# RECONCILE_EXAMPLE_TOL_REL=0  # relative tolerance for the example provider (fraction, e.g. 0.01 = 1%).
# RECONCILE_EXAMPLE_AUTH=      # optional Authorization header value for the example provider.
# TRAFFIC_SPACETIME=false      # H4 (SYNAPSE §5.4.3) — space-time interval reservation + time-expanded
#                              # A* + infra coordinator (elevator/door). Pure engines; traffic-mgr adopts.
# TWIN_DRIFT=false             # H6 (SYNAPSE §5.7.3) — twin↔reality drift detector + Monte-Carlo N≥30/CI.
# RL_ADVISOR=false             # H6 (SYNAPSE §5.3.4) — RL dispatch advisor shadow→suggest→auto + breaker.
# RL_ADVISOR_MODE=shadow       # D3 — mode when RL_ADVISOR on: shadow (log only, default) | suggest | auto.
#                              # The allocator logs a policy comparison to the decision-trace (never changes alloc).
# DEV_PORTAL=false             # P6 (SYNAPSE R3) — developer portal: published OpenAPI/AsyncAPI +
#                              # `synapse plugin new` scaffold + conformance checklist + sandbox validate.
# FOE_DURABLE=false            # F8 flag (SYNAPSE §5.1/§5.3) — advisory: DAG topo-check + event-sourced
#                              # crash-resume + P0-P3 priority/aging/four-eyes. Pure primitives; FOE adopts.
# PLUGIN_SIDECAR=false         # F3 flag (SYNAPSE §6.4.3) — out-of-process plugin sidecar framework:
#                              # lifecycle + watchdog/backoff + quota + Ed25519 signature + JSON-lines
#                              # stdio transport (doc 33 §11). OFF → supervisor not started at boot.
# PLUGIN_SIDECAR_CMD=          # command to supervise when PLUGIN_SIDECAR on (e.g. `node dist/sampleSidecar.js`
#                              # or a vendor connector). Unset → nothing supervised (honest no-op).
# PLUGIN_SIDECAR_ARGS=         # space-separated args for PLUGIN_SIDECAR_CMD.
# PLUGIN_SIDECAR_ID=sidecar    # plugin id used in supervisor status/incidents.

# --- Database (required) ---
DATABASE_URL=postgresql://user:password@localhost:5432/avi_aoi

# =============================================================================
# Docker Compose infra (chỉ dùng khi chạy `docker compose up`).
# Compose tự ghép DATABASE_URL/TSDB_URL từ các biến dưới — KHÔNG cần sửa tay.
# =============================================================================
POSTGRES_USER=aoi
POSTGRES_PASSWORD=aoi
POSTGRES_DB=aoi_management
# TimescaleDB (time-series energy_readings) — container riêng, cổng host 5433.
TSDB_USER=tsdb
TSDB_PASSWORD=tsdb_pass
TSDB_NAME=avi_aoi_ts
# EMQX dashboard (UI cổng 18083).
EMQX_DASHBOARD_PASSWORD=public

# --- Security (required) ---
# Generate a strong random secret: openssl rand -base64 64
JWT_SECRET=change_this_to_a_strong_random_secret_minimum_32_chars
# 21 CFR Part 11 §11.70 — HMAC secret for cryptographic supervisor sign-off (>=16 chars)
SIGNOFF_SECRET=change_this_signoff_secret_min_16_chars
# doc 54 A3 — AES-256-GCM key for reversible secret-at-rest (broker profile passwords via
# server/services/security/secretBox). If unset, the key is derived from JWT_SECRET (works
# out of the box). Set a DEDICATED 32+ char value to rotate independently of JWT_SECRET.
# ⚠ Changing this (or JWT_SECRET when this is unset) makes existing enc:v1: secrets
# undecryptable — re-enter broker passwords after a rotation.
# SECRET_ENCRYPTION_KEY=change_this_to_a_dedicated_strong_32char_key
#
# ─── CỔNG ẢNH (server/routes/_congAnh.ts + server/_core/anhKyUrl.ts) ─────────────────────────
# Trước lượt vá này, `/uploads/**` và 5 tuyến ảnh REST phục vụ ảnh kiểm THÔ của MỌI nhà máy mà
# không có một middleware xác thực nào. `/api/inspection/:id/images` nhận số nguyên TUẦN TỰ, nên
# đếm 1..N là gom được số serial + ảnh của mọi nhà máy.
#
# ⚠⚠ ANH_CONG_MO — "true"/không đặt = MỞ (hành vi CŨ, không phá client nào). "false" = CƯỠNG CHẾ.
#    Mặc định để MỞ vì đây là ĐỔI HỢP ĐỒNG API ĐANG DÙNG: trình duyệt `client/` sống sót nhờ
#    cookie same-origin tự động (ĐÃ ĐO), nhưng app RN `FactoryAlertSystem/` nạp ảnh bằng
#    `<Image source={{uri}}>` — KHÔNG cookie, KHÔNG header — nên các APK đã phát ra hiện trường
#    sẽ VỠ ngay khi bật. Chỉ đặt "false" SAU KHI đội máy đã lên bản app biết dùng vé ký.
#    (Hai tuyến /api/measurement-point/:id/reference-image và /api/product-model/:id/
#     reference-images đã cưỡng chế KHÔNG QUA CỜ — người gọi duy nhất đo được đã gửi sẵn khoá.)
# ANH_CONG_MO=false
#
# Khoá ký URL ảnh ngắn hạn. Ký + kiểm HOÀN TOÀN CỤC BỘ (node:crypto) — không internet, không bên
# thứ ba. Bỏ trống thì lùi về SESSION_SECRET → JWT_SECRET → MASTER_API_KEY.
# ANH_KY_SECRET=change_this_to_a_dedicated_image_url_signing_secret
# Hạn sống của một vé ảnh, giây (mặc định 900 = 15 phút; kẹp biên 60..86400).
# ANH_KY_TTL_SECONDS=900
#
# Comma-separated list of allowed browser origins for CORS + Socket.IO handshake
# Example: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Per-client rate limit (requests per minute) for /api/* and /trpc/* (default 300).
# W4-D (doc 27 B6): clients are keyed by hashed API key / bearer token / session
# cookie, falling back to IP only for anonymous requests (factory-NAT safe).
RATE_LIMIT_PER_MINUTE=300
# When REDIS_URL (below) is set, rate-limit counters live in Redis (shared across
# instances; fail-OPEN if Redis is down). Set RATE_LIMIT_REDIS=false to force the
# single-instance in-memory store even when REDIS_URL is configured.
# RATE_LIMIT_REDIS=true

# doc 48 R3 — DEDICATED high-throughput OT telemetry ingest tier.
# POST /api/ot/ingest is machine-to-machine (authenticated by a per-machine key) and
# is EXEMPT from RATE_LIMIT_PER_MINUTE above — it rides its OWN per-machine-key
# limiter so a gateway pushing hundreds of thousands of points/sec is not throttled by
# the 300/60 browser bucket. Value = max requests / 60s window PER machine key.
# Default is high but FINITE (a runaway client is still capped — never unlimited).
# The general /api + /trpc browser limiter is UNCHANGED (stays RATE_LIMIT_PER_MINUTE).
OT_INGEST_RATE_MAX=300000

# --- Process role (W4-D, doc 27 B7 — optional worker split) ---
# Unset (default): all-in-one process — HTTP + socket + MQTT + ALL schedulers
#                  (existing behaviour, nothing changes for dev/current deploys).
# ROLE=api       : serves HTTP/socket/MQTT/ingest but SKIPS the ~20 cron-like
#                  schedulers (reports, backups, retention, integrity scan, AI
#                  cron jobs, ERP outbox drain, ...). Pair with a worker process.
# ROLE=worker    : starts ONLY those schedulers — no HTTP bind. Start it with
#                  `npm run start:worker` (prod, dist/worker.js) or
#                  `npm run dev:worker` (dev). By default run exactly ONE worker;
#                  to run HA replicas, enable leader election below so only one
#                  replica runs the crons. The worker must see the same
#                  DATABASE_URL and (for image lifecycle) the same uploads volume
#                  as the API process.
# ROLE=

# --- Worker leader election (doc 48 R4) ---
# OFF (default): historical single-worker behaviour — schedulers start
# immediately, no lock. Turn ON to run >1 worker replica for HA: each replica
# competes for a session-level Postgres advisory lock; only the LEADER runs the
# ~30 singleton cron jobs, and a standby takes over automatically if the leader
# dies. A heartbeat re-verifies lock ownership and fail-stops the process on loss
# (supervisor restarts it as a standby) to prevent split-brain double-firing.
# WORKER_LEADER_ELECTION_ENABLED=false
# Ownership heartbeat interval in ms (default 15000).
# WORKER_LEADER_HEARTBEAT_MS=15000

# --- Database pools (W4-D, doc 27 B5) ---
# Primary pool for API/socket request traffic (default 25; was 10).
# Size against Postgres max_connections: api + worker + jobs pools must fit.
# DB_POOL_MAX=25
# Separate smaller pool for background jobs (retention DELETEs, integrity scans,
# matview refresh) so scheduler storms never starve API requests (default 8).
# DB_POOL_MAX_JOBS=8

# --- Application ---
# App identifier (also sent as OAuth clientId/projectId when OAUTH_SERVER_URL is set).
# REBRAND R-2: new deployments use synapse-platform. Existing deployments that log in
# via an OAuth portal registered with the old id should keep their current value
# until the portal registration is updated (sessions themselves are NOT invalidated).
VITE_APP_ID=synapse-platform

# --- Multi-tenant Row-Level Security (Phase 1 WS4 — DB-enforced tenant isolation) ---
# DEFAULT OFF. Leave unset/false for the current behaviour (app-layer scoping only).
# When "true", protected tRPC procedures derive the caller's tenant scope and the
# data layer enforces PostgreSQL RLS via server/db/tenantContext (SET LOCAL GUCs
# inside a transaction). Preconditions BEFORE enabling (see
# docs/ECOSYSTEM/PHASE1_TENANT_RLS_ROLLOUT.md):
#   1. Apply drizzle/0122_tenant_rls_extend.sql (policies are fail-open while OFF).
#   2. The app must connect (DATABASE_URL) as a NON-owner, NOBYPASSRLS role.
# Rollback = set this back to false (GUC never set -> policies allow all).
# TENANT_RLS_ENABLED=false

# --- About Page (optional) ---
# These values are shown at /about-system. Leave empty to use default i18n content.
# VITE_ABOUT_COMPANY_NAME=Your Company Name
# VITE_ABOUT_COMPANY_DESCRIPTION=System implementation and operations organization.
# VITE_ABOUT_DEVELOPER_TEAM=Your Engineering Team
# VITE_ABOUT_DEVELOPER_ROLE=Architecture, feature development, performance optimization.
# VITE_ABOUT_DEVELOPER_CONTACT=contact@your-company.com

# --- Storage ---
# "local" = store files on this server's filesystem
# "forge" = use external Forge API for image storage
STORAGE_MODE=local
LOCAL_STORAGE_DIR=./uploads

# --- Master API Key (for machine/device integration) ---
MASTER_API_KEY=change_this_master_api_key

# --- License ---
LICENSE_FILE_PATH=./license.lic
# LICENSE_SERVER_URL=https://license.example.com
# LICENSE_PRODUCT_CODE=SYNAPSE-PROD
# legacy AVI-AOI-* van duoc chap nhan (dual-accept R-2) — xem server/license/productCode.ts
# LICENSE_ENCRYPTION_SECRET=
# doc 33 F4 (SYNAPSE §4.3) — "không bao giờ dừng sản xuất vì license". Default TRUE: khi
# license hết hạn/khoá, thao tác SẢN XUẤT-CỐT-LÕI (inspection/session/andon/safety/telemetry)
# VẪN CHẠY; chỉ khoá cấu hình/tính năng cao cấp → gia hạn là chuyện thương mại, không dừng máy.
# Đặt =false để khôi phục hành vi cũ (locked chặn cứng). Ed25519+TPM: xem server/license/ed25519License.ts.
# LICENSE_NEVER_STOP_PRODUCTION=true

# --- Email / SMTP (optional) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_app_password
# SMTP_FROM=noreply@your-domain.com

# --- AI / OpenAI (optional — for AI chat and analysis features) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o

# --- Redis (optional — for session caching / rate limiting) ---
# REDIS_URL=redis://localhost:6379

# --- Cross-instance bus fan-out (U6-b, doc 21 §6 / G-10) ---
# DEFAULT OFF. eventBus + telemetryBus are in-process EventEmitters (correct for a
# single instance). For MULTI-INSTANCE / multi-site scale, set this to "true" AND
# set REDIS_URL above: each locally-originated domain event / telemetry batch is
# then published to a Redis channel and remote-instance events are subscribed back
# into the local bus (loopback-safe). ioredis is already a dependency, so no extra
# install is needed — only REDIS_URL. If this is "true" but REDIS_URL is unset (or
# Redis is unreachable), the buses log ONCE and STAY in-process (honest seam — no
# fake cross-instance delivery). Rollback = set back to false / unset.
# EVENTBUS_REDIS_ENABLED=false

# --- MQTT Broker (optional — for real-time machine communication) ---
# Local Aedes broker for AVI/AOI machines
MQTT_ENABLED=false
# MQTT_PORT=1883
# MQTT_WS_PORT=8883

# Doc 51 P0 (R3 ✔ đã tự kiểm chứng: grep authorizePublish|authorizeSubscribe = 0 match)
# Broker Aedes hiện KHÔNG có ACL topic nào → mọi client đọc/ghi MỌI topic, kể cả
# topic LỆNH (`configure`/`software-update`) của thiết bị khác, và nghe lén được
# trạm khác. ACL: client chỉ pub `avi/client/{deviceId-của-chính-nó}/*` + sub topic
# trạm được map; chỉ clientId của server mới pub nhánh `errors`/`configure`.
# Dev: true+warn-only · PROD: true + warn-only=false (cưỡng chế).
# MQTT_TOPIC_ACL_ENABLED=false
# WARN-ONLY = quan sát trước, cưỡng chế sau (cùng tinh thần QĐ#1): true → vi phạm
# chỉ LOG + đếm telemetry chứ KHÔNG chặn ⇒ biết client nào sẽ vỡ TRƯỚC khi siết.
# Chạy warn-only ≥1 tuần cho tới khi log sạch, rồi đặt false để chặn thật.
# MQTT_TOPIC_ACL_WARN_ONLY=true

# External MQTT Broker (optional — forward messages to cloud broker for third-party integration)
# Enable this to forward all local messages to an external broker (HiveMQ, Mosquitto, EMQX, etc.)
EXTERNAL_MQTT_ENABLED=false

# Broker URL format: mqtt://hostname:port or mqtts://hostname:port (for TLS)
# Examples:
#   - HiveMQ Cloud:    mqtt://broker.hivemq.com:1883
#   - Mosquitto Local: mqtt://localhost:1883
#   - EMQX:            mqtt://emqx-server.local:1883
#   - Secure TLS:      mqtts://secure-broker.com:8883
# EXTERNAL_MQTT_BROKER=mqtt://broker.hivemq.com

# EXTERNAL_MQTT_PORT=1883
# EXTERNAL_MQTT_USERNAME=your_mqtt_username
# EXTERNAL_MQTT_PASSWORD=your_mqtt_password

# Topic prefix (optional — add prefix to all forwarded topics)
# Example: "prod" → topics become "prod/avi/1/workshop/..."
# EXTERNAL_MQTT_TOPIC_PREFIX=   # (rebrand W7)

# TLS/SSL Configuration (only when using mqtts:// protocol)
# EXTERNAL_MQTT_USE_TLS=false
# EXTERNAL_MQTT_CA_CERT=/path/to/ca-certificate.crt
# EXTERNAL_MQTT_CLIENT_CERT=/path/to/client-certificate.crt
# EXTERNAL_MQTT_CLIENT_KEY=/path/to/client-private-key.key
# EXTERNAL_MQTT_REJECT_UNAUTHORIZED=true

# ─── UNS / Sparkplug-B Bridge (optional — Unified Namespace, ISA-95) ─────────
# Lớp chuẩn hoá topic AOI → UNS broker (EMQX/HA). Tắt mặc định, backward-compat:
# KHÔNG đổi topic AOI gốc (Aedes 1883), chỉ PHÁT THÊM bản chuẩn hoá sang broker UNS.
# Bật mirror topic AOI → UNS broker (ISA-95/Sparkplug). Cần broker UNS (cổng 1884).
UNS_BRIDGE_ENABLED=false
# Broker UNS đích (TÁCH với Aedes nội bộ 1883 → không tạo vòng lặp).
# UNS_BROKER_URL=mqtt://localhost:1884
# UNS_BROKER_USERNAME=
# UNS_BROKER_PASSWORD=
# Tên doanh nghiệp (Enterprise) cho ISA-95 path + suy ra group_id Sparkplug.
# UNS_ENTERPRISE_NAME=AVI-AOI   # (rebrand W7)
# Bật chiều phát telemetry chuẩn Sparkplug-B (NBIRTH/DBIRTH/DDATA/NDEATH).
# Read-direction only: KHÔNG subscribe/execute NCMD/DCMD (để F4 HITL).
UNS_SPARKPLUG_ENABLED=false
# group_id / edge_node_id Sparkplug (mặc định suy từ Enterprise / "avi-aoi-ot").
# UNS_SPARKPLUG_GROUP_ID=avi   # (rebrand W7)
# UNS_SPARKPLUG_EDGE_NODE_ID=avi-aoi-ot   # (rebrand W7)
# F3b — Bridge topic AOI cũ (NG alert / summary) → Sparkplug-B DDATA. Cần
# UNS_SPARKPLUG_ENABLED=true. Tắt mặc định; chỉ read-direction (telemetry).
UNS_SPARKPLUG_AOI_BRIDGE=false
# C5 (doc 24 Wave-4) — UNS-first PackML STATE: phát chuyển-trạng-thái PackML +
# identity của máy như một kênh Sparkplug hạng nhất (DBIRTH/DDATA) để subscriber
# tái dựng đầy đủ PackML state (digital thread). Cần UNS_SPARKPLUG_ENABLED=true
# (dùng chung transport). Tắt mặc định → publisher no-op, KHÔNG đổi hành vi cũ.
# Read-direction only: KHÔNG phát lệnh PackML, KHÔNG mở control path.
UNS_PACKML_STATE_ENABLED=false
# Doc 24 (Connectivity) — No-code Tag → UNS mapping designer. Khi BẬT, tag OT có
# mapping (bảng uns_tag_mappings) sẽ phát tới topic/metric đã ánh xạ kèm điều kiện
# (rename/scale/offset/unit/cast/deadband); tag KHÔNG có mapping giữ nguyên chuẩn
# hoá mặc định. Tắt mặc định ⇒ hành vi hiện tại không đổi. Chỉ chiều ĐỌC, không mở
# control path. Cần OT_INGEST_TO_UNS=true + UNS_BRIDGE_ENABLED=true để thực phát.
UNS_MAPPING_ENABLED=false

# --- Firebase Push Notifications (optional) ---
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# --- HTTPS (optional — leave false to use plain HTTP behind a reverse proxy) ---
HTTPS_ENABLED=false
# HTTPS_KEY_PATH=/path/to/privkey.pem
# HTTPS_CERT_PATH=/path/to/fullchain.pem
# HTTPS_CA_PATH=/path/to/chain.pem

# --- Logging ---
# LOG_LEVEL=info   (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# --- AOI Image Cache ---
# AOI_CACHE_DIR=./cache
# AOI_CACHE_TTL_DAYS=7

# --- Backup Off-site Replication (ISO 22301 geographic redundancy) ---
# Choose ONE replication target. If both are set, S3 takes precedence.
#
# Option A: AWS S3 / S3-compatible (MinIO, Wasabi, Cloudflare R2, Ceph RGW).
#   Requires `aws` CLI on PATH. Each backup file is copied to:
#     s3://${AWS_S3_BACKUP_BUCKET}/${AWS_S3_BACKUP_PREFIX}/<file>
#   plus a `<file>.sha256` sidecar for integrity verification.
# AWS_S3_BACKUP_BUCKET=my-backup-bucket
# AWS_S3_BACKUP_PREFIX=avi-aoi/prod
# AWS_REGION=ap-southeast-1
# AWS_S3_ENDPOINT_URL=https://minio.example.com         # MinIO / R2 / Wasabi only
# AWS_S3_SSE=AES256                                      # AES256 (SSE-S3) or aws:kms
# AWS_S3_SSE_KMS_KEY_ID=arn:aws:kms:...                  # only when AWS_S3_SSE=aws:kms
# AWS_S3_STORAGE_CLASS=STANDARD_IA                       # STANDARD | STANDARD_IA | GLACIER | DEEP_ARCHIVE
#
# Option B: Off-site filesystem mount (NAS, SMB share, second DC volume).
# OFFSITE_BACKUP_DIR=/mnt/offsite-backup

# --- Forge API (optional — only when STORAGE_MODE=forge) ---
# BUILT_IN_FORGE_API_URL=https://forge.example.com
# BUILT_IN_FORGE_API_KEY=

# --- OAuth Providers (optional) ---
# OAUTH_SERVER_URL=
# VITE_OAUTH_PORTAL_URL=
# OWNER_OPEN_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─── Local AI: GGUF engine (node-llama-cpp, offline-first) ───────────────────
# Directory where .gguf model files live (default: ./uploads/gguf-models)
# GGUF_MODELS_DIR=./uploads/gguf-models
# Default text model id (filename without .gguf) used when no modelId is given
# GGUF_DEFAULT_MODEL=qwen2.5-3b-instruct-q4_k_m
# Dedicated embedding model id (filename without .gguf). REQUIRED for embeddings —
# keeps embeddings off the text model. Use mxbai-embed-large for 1024-dim vectors.
# GGUF_EMBED_MODEL=mxbai-embed-large-v1-f16
# Expected embedding dimension; a mismatch throws an explicit error (default 1024)
# GGUF_EMBED_DIM=1024
# ─── B6.2: optional Thinking / reasoning tier (Qwen3-30B-A3B-Thinking) ───────
# Flag-gated, UNSET/OFF by default → ZERO behaviour change (deep tier stays GGUF_DEFAULT_MODEL).
# When BOTH the master switch is on AND the model file exists in GGUF_MODELS_DIR, the Model
# Router escalates ONLY the hardest reasoning tasks (difficulty "hard" AND task ∈ {rca, report})
# to the Thinking model; everything else is unchanged. Same size as the Instruct deep model
# (~17GB) → it CANNOT be hot at the same time; the engine loads it on demand and LRU-evicts.
# Fail-safe: if the file is missing, the router logs once and falls back to GGUF_DEFAULT_MODEL.
# The Thinking model emits <think>…</think> reasoning which the engine strips before display.
# AI_THINKING_TIER_ENABLED=false
# ─── doc69 G2-2: AI SAFETY LAYER (aiGateway.planInference) ───────────────────
# Injection scan (flag-only) + secret/PII redaction, wired into the AI Gateway choke-point
# used by aiProviderRouter (~10 services) + _core/llm.ts + aiChatAssistant. Redaction is
# always safe/non-breaking (masks substrings, never changes meaning) — default ON.
# AI_SAFETY_ENABLED=true              # false/0/off -> fully disable (pass-through, e.g. to isolate a false-positive)
# AI_SAFETY_BLOCK_HIGH_RISK=false     # true -> HARD-BLOCK requests whose injection scan is risk:'high' (default: flag only, never blocks)
# ─── doc 48 R5: PERSISTENT LLAMA-SERVER (deep model runs out-of-process) ──────
# By default the deep text model loads IN-PROCESS (node-llama-cpp) and competes
# with the always-resident embedder for the single GPU's VRAM → under contention
# the deep model fails to load and generation degrades to offline templates. Turn
# this on to run the deep model in a SEPARATE, persistent `llama-server` process
# (OpenAI-compatible) that owns its VRAM and stays warm; the API keeps only the
# small embedder in-process and forwards deep-model text generation over HTTP.
# No extra GPU needed — size the two to co-reside (runbook: scripts/ai/llama-server.md).
# OFF (default) → in-process path unchanged, byte-for-byte.
# LLAMA_SERVER_ENABLED=false
# Base URL of the running llama-server (llama.cpp `--host/--port`).
# LLAMA_SERVER_URL=http://127.0.0.1:8080
# Basename (sans .gguf) of the model the server serves. Defaults to GGUF_DEFAULT_MODEL.
# Only text generation for THIS model is routed to the server; embeddings, vision,
# and any other model stay in-process.
# LLAMA_SERVER_MODEL=
# Optional bearer token if the server was started with --api-key.
# LLAMA_SERVER_API_KEY=
# Request timeout (ms) for a server generation (default 120000).
# LLAMA_SERVER_TIMEOUT_MS=120000
# STRICT: on a server error, THROW instead of silently falling back in-process
# (honest-degrade → the caller's offline template kicks in). Default false = fall
# back to the in-process path when the server is unreachable.
# LLAMA_SERVER_STRICT=false
# GGUF_THINKING_MODEL=Qwen3-30B-A3B-Thinking-2507-UD-Q4_K_XL.gguf
# ─── B2.2: RAG reranker (re-orders retrieved KB chunks before the prompt) ────
# Master switch. When true (production default), retrieved candidates are reranked
# for precision; when false/unset, retrieval is plain cosine order (identity).
# RAG_RERANKER_ENABLED=true
# Backend: "llm" (DEFAULT) scores candidates with the fast text model (Qwen3-4B) —
# needs NO extra model. "gguf" uses a dedicated native cross-encoder reranker.
# RAG_RERANKER_MODE=llm
# Blend weight: final = blend*rerank + (1-blend)*cosine (0..1, default 0.85).
# RAG_RERANKER_BLEND=0.85
#
# Optional dedicated reranker (higher precision than llm mode). MUST be a native
# CROSS-ENCODER reranker with a rank head (node-llama-cpp createRankingContext/
# rankAll) — e.g. bge-reranker-v2-m3 (multilingual vi/en/zh) or a jina/bge reranker.
# NOTE: Qwen3-Reranker is a GENERATIVE reranker (no rank head) and is NOT compatible
# with rankAll → it would fail and auto-fall back to llm. Place the GGUF under
# GGUF_MODELS_DIR, then set the two lines below. Missing/invalid → safe fallback to
# RAG_RERANKER_MODE=llm (Qwen3-4B).
# RAG_RERANKER_MODE=gguf
# GGUF_RERANKER_MODEL=bge-reranker-v2-m3-Q8_0.gguf
# Run the reranker on CPU (default) so it does NOT take VRAM from the big chat/RCA
# models (a GPU-resident reranker can OOM the 30B load). Set true only with VRAM to spare.
# RAG_RERANKER_GPU=false
# ─── Vision (WS-G2): LOCAL llama.cpp mtmd sidecar (offline, 127.0.0.1) ───────
# node-llama-cpp 3.18.1 has NO multimodal binding, so real vision runs via a local
# `llama-server` (built with mtmd) spawned on localhost and called over HTTP.
# Vision model + its MATCHING multimodal projector (mmproj). Use a real pair such as
# Qwen2-VL-7B-Instruct GGUF + its Qwen2-VL mmproj (do NOT mix a LLaVA mmproj with Qwen).
# Filenames resolve inside GGUF_MODELS_DIR (or give an absolute path).
# GGUF_VISION_MODEL=Qwen2-VL-7B-Instruct-Q4_K_M.gguf
# GGUF_VISION_MMPROJ=mmproj-Qwen2-VL-7B-Instruct-f16.gguf
# Absolute path to the llama-server binary (must be built with mtmd / multimodal support).
# When this + the two files above are all present, vision is enabled; otherwise the system
# degrades honestly (fallbackUsed:true / VISION_NOT_AVAILABLE) — it never fabricates output.
# LLAMA_SERVER_BIN=/opt/llama.cpp/build/bin/llama-server
# Sidecar bind host/port (localhost only — no outbound network)
# LLAMA_VISION_HOST=127.0.0.1
# LLAMA_VISION_PORT=8081
# Healthcheck timeout while the model loads (ms, default 120000)
# LLAMA_VISION_READY_TIMEOUT_MS=120000
# Auto-kill the sidecar after this idle period (ms, default 600000 = 10 min)
# LLAMA_VISION_IDLE_TIMEOUT_MS=600000
# GPU layers (-ngl) passed to llama-server (default 999 = offload all)
# LLAMA_VISION_GPU_LAYERS=999

# ─── AOI-A: DINOv2 visual embedding — model path + embed-at-ingest (B4/A2/A4) ─
# DINOv2 ONNX model path (CONFIGURABLE — no hardcoded absolute path). May be absolute
# OR repo-relative; relative paths resolve from the repo root. Default: models/dinov2.onnx.
# The register-dinov2 / reembed-images-onnx scripts and the runtime loader all read this.
# HONEST DEGRADATION: if the file is ABSENT the pipeline falls back tier-by-tier —
#   onnx (real DINOv2)  →  text-of-image (GGUF describe→embed, 1024-d)  →  heuristic (sharp).
# The active tier is always labelled in outputs (embeddingSource / anomaly.source /
# getDinov2ModelHealth().activeTier); embeddings are NEVER fabricated. We do NOT ship a
# .onnx binary (models are gitignored) — drop a real DINOv2 ONNX at this path to activate
# the onnx tier.
# AI_DINOV2_MODEL_PATH=models/dinov2.onnx
#
# Embed-at-ingest worker (aoiImageEmbeddingWorker): on AOI package commit, embed new
# inspection images into ai_image_embeddings for visual search + anomaly banks.
# DEFAULT OFF — when off, enqueue is a no-op (zero behaviour change). Turn on in a local
# .env to exercise the pipeline; with no model present it runs on the degraded tier.
# AOI_EMBEDDING_ENABLED=false
# AOI_EMBEDDING_MODEL_CODE=dinov2-small   # ai_models.code of the ONNX embedding model
# AOI_EMBEDDING_CONCURRENCY=2             # inspections embedded in parallel (CPU-bound, max 8)
# AOI_EMBEDDING_RESULT_FILTER=NG          # NG (default) | ALL — which measurement results to embed
# AOI_EMBEDDING_MAX_POINTS=500            # cap on points/inspection per run

# ─── B3: real-time anomaly (PatchCore) + VL escalation gate (§B3/§B8ter) ─────
# Master flag for unsupervised anomaly scoring at AOI ingest AND the VL-escalation
# gate. DEFAULT OFF — when off the embed worker behaves exactly as before (embed only,
# no scoring, no VL). Coordinator flips this live after a memory bank is built.
# ANOMALY_DETECTION_ENABLED=false
#
# kNN / threshold tuning (build-time). Threshold = percentile(distances) of the OK bank.
# ANOMALY_KNN_K=5
# ANOMALY_THRESHOLD_PCT=99
# ANOMALY_CORESET_RATIO=0.25
# ANOMALY_BANK_SCAN_LIMIT=4000
#
# VL ESCALATION GATE (§B8ter sizing): at 20k img/8h-shift (~0.69 img/s) DINOv2
# embed+anomaly (~150ms) runs on 100% of images cheaply, but Qwen3-VL (~1.2s/img)
# MUST be gated — only NG/suspect images (typically 2-10%) reach VL or it becomes the
# bottleneck. shouldEscalateToVision() enforces this. Tunables:
#   suspect threshold = ANOMALY_VL_SUSPECT_ABS (absolute, if >0) OR
#                       profileThreshold × ANOMALY_VL_SUSPECT_RATIO (default 1.0 = any anomaly).
# ANOMALY_VL_SUSPECT_RATIO=1.0     # <1 widens (catch borderline), >1 tightens
# ANOMALY_VL_SUSPECT_ABS=0         # absolute score threshold; 0 = use ratio
# ANOMALY_VL_MAX_PER_MIN=6         # hard back-pressure cap on VL escalations/min (0 = off)
# ANOMALY_CREATE_ALERTS=false      # also raise a PATTERN_ANOMALY predictive alert (quality-gate hook)
#
# ANOMALY BANK AUTO-REBUILD (scheduled cron). Periodically rebuilds PatchCore memory
# banks per scope (machine, optionally product) from stored OK DINOv2 vectors as the OK
# pool grows. DEFAULT OFF — safe no-op when off. A scope rebuilds when: no bank yet, OR
# its bootstrap bank now has ≥ MIN_OK OK samples, OR its OK count grew by ≥ REBUILD_DELTA
# since the last build. Capped at MAX_SCOPES_PER_RUN per run (deferred scopes are logged,
# never silently dropped); each scope is fail-safe (one failure never aborts the run).
# ANOMALY_BANK_AUTO_REBUILD_ENABLED=false
# ANOMALY_BANK_REBUILD_CRON=0 3 * * *          # cron (default 03:00 daily)
# ANOMALY_BANK_TZ=Asia/Ho_Chi_Minh
# ANOMALY_BANK_MIN_OK=30                        # min OK samples for a NON-bootstrap bank
# ANOMALY_BANK_REBUILD_DELTA=20                 # min NEW OK samples since last build to rebuild
# ANOMALY_BANK_SCOPE=machine                    # machine | product | both
# ANOMALY_BANK_MAX_SCOPES_PER_RUN=25            # safety cap per run
# ANOMALY_BANK_MODEL_CODE=dinov2-small          # embedding modelCode in ai_image_embeddings
# ANOMALY_BANK_BACKFILL=true                    # after rebuild, backfill recent scores for the scope
# ANOMALY_BANK_BACKFILL_LIMIT=5000              # bound on backfilled rows per scope

# GPU acceleration: set to "false" to force CPU; anything else uses auto (CUDA/Vulkan)
# GGUF_GPU=auto
# Parallel sequences per model context (default 4)
# GGUF_SEQUENCES=4
# Max number of models kept resident at once; oldest idle one is evicted (default 2)
#
# ★★★ Pha 3 Task 3 — ĐÂY LÀ TRẦN **MỖI TIẾN TRÌNH**, và đó là một QUYẾT ĐỊNH (giữ nguyên), không
# phải một chỗ quên. Con số thật trên một card:
#       số model GGUF thường trú TỐI ĐA = số_tiến_trình × GGUF_MAX_LOADED_MODELS
# Với topology tách vai trò (`ROLE=api` + `ROLE=worker`) và giá trị 4 ⇒ **8 model trên MỘT card**.
#
# ⚠⚠ CỬA **BYTE** KHÔNG CỨU ĐƯỢC CỬA **ĐẾM**: từ Pha 3, cửa byte là *cục bộ + CHUNG* (`vram_leases`)
# nên hai tiến trình thấy byte của nhau; nhưng ràng buộc Đ4 (KHÔNG TRỘN HAI THƯỚC) buộc trần ĐẾM
# phải là một cửa ĐỘC LẬP với lý do riêng (`gguf-slot-cap`) và KHÔNG được quy ra byte. ⇒ 8 model
# NHỎ vẫn qua cửa byte và vẫn vượt trần đếm gấp đôi. Xem `vramBroker.kheGgufConThieu()`.
# GGUF_MAX_LOADED_MODELS=2
# Soft VRAM cap in MB for eviction. 0 = disabled (default; best-effort, opt-in)
# GGUF_MAX_VRAM_MB=0
# ── GGUF inference concurrency (GĐ2 Mục 4 — protect VRAM from OOM) ──
# Global FIFO semaphore serializing ALL GGUF inference (text/chat/json/stream/embed).
# Max concurrent inferences. Keep at 1 on a 6GB GPU (e.g. RTX 4050); raise on a
# bigger card (e.g. 2-3 on a 24GB RTX 4090) to allow parallel requests.
GGUF_MAX_CONCURRENCY=1
# Max requests allowed to wait for a slot before new ones are rejected (backpressure).
GGUF_QUEUE_MAX=8
# Max time (ms) a request waits for a free slot before failing.
GGUF_INFER_TIMEOUT_MS=120000

# ─── Local AI: legacy Ollama (optional fallback) ─────────────────────────────
# Master rollback switch for ALL local-AI paths (QA generation, KB embeddings,
# image-text embeddings, and tool-intent classification). Default false → everything
# runs in-process via the GGUF engine and NO Ollama daemon is required. Set to "true"
# only to roll back to the legacy Ollama HTTP backend.
# USE_LEGACY_OLLAMA=false
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=mxbai-embed-large
# OLLAMA_QA_MODEL=qwen2.5:3b

# ─── KB auto-sync (doc 11 · W1.2) ─────────────────────────────────────────────
# Keep the AI knowledge base fresh: a nightly cron runs `npm run kb:sync`
# (extract → chunk → embed-incremental → graph). Incremental embed only re-embeds
# new/changed chunks, so a run is cheap. The embed scripts now load .env, so the
# corpus is always built with GGUF_EMBED_MODEL (no accidental mxbai/Qwen3 mix);
# embed-incremental aborts if the corpus model would switch (override:
# KB_EMBED_ALLOW_MODEL_SWITCH=1, then run a full `npm run kb:embed`).
# Disabled by default — opt in on the box that hosts the GGUF models.
# KB_AUTOSYNC_ENABLED=false
# KB_AUTOSYNC_CRON=0 3 * * *
# KB_AUTOSYNC_TZ=Asia/Ho_Chi_Minh
# KB_AUTOSYNC_TIMEOUT_MS=1800000
# Answer-eval gate (doc 69 GĐ6/W5 B1): after a successful sync, run
# `node scripts/ai-kb/eval-rag.mjs --ci` and ROLL BACK the KB if recall regressed.
# ⚠ This spawns a SECOND Node process that loads the embed model on the GPU — it is a
# real VRAM consumer, budgeted as `cron:kb-eval-gate` (see VRAM_KB_EVAL_ESTIMATE_MB below).
# KB_AUTOSYNC_EVAL_GATE=true
# KB_AUTOSYNC_EVAL_TIMEOUT_MS=600000

# ─── VRAM orchestration — Pha 1: LEDGER + ALARM ONLY, never refuses ───────────
# A single GPU serves the 30B chat model, the embedder, the reranker, the ONNX
# inspection sessions, the vision sidecar and the nightly KB cron. Until Pha 1
# nobody counted them together, so "how much VRAM is left" had no answer.
# Pha 1 only OBSERVES: it records every allocation in an in-memory ledger, writes
# the history to the `vram_events` table, and every 60s compares the ledger against
# what the device actually reports. It NEVER refuses or evicts anything — enforcement
# is Pha 2. Every knob below is optional; the defaults are the shipped behaviour.
#
# Device ceiling. Leave UNSET on real hardware: the probe reads the true total from
# the GPU (nvidia-smi / llama.cpp getVramState) at the first measurement and the
# ledger follows it. Set it only to override a wrong/absent reading — an explicit
# value always wins over the measured one. Fallback when neither exists: 32607 (RTX 5090).
# VRAM_DEVICE_TOTAL_MB=32607
# Safety margin held back from headroom (headroom = total − reserve − ledger).
# ⚠ Does NOT cover the desktop/background VRAM of the machine (measured 996–2112 MiB
# here): that is outside the ledger, so headroom is optimistic by roughly that much.
# VRAM_SAFETY_RESERVE_MB=1024
# Ledger-vs-device mismatch that raises "unauthorized allocation". Below this,
# nothing is logged (see the report §3.1 — this censors the very distribution you
# need to pick the threshold; raise it before a long observation run, not after).
# VRAM_DRIFT_THRESHOLD_MB=512
# How often the reconciliation tick runs (ms). Each tick costs one device probe.
# VRAM_RECONCILE_INTERVAL_MS=60000
# Device-probe cache TTL (ms) shared by the background reconciler. The allocation
# path deliberately bypasses this cache and reads fresh.
# VRAM_PROBE_CACHE_MS=5000
# Event-log writer: flush interval (ms) and max queued events before dropping.
# Dropping telemetry is preferred over growing memory during a DB outage.
# VRAM_LOG_FLUSH_MS=5000
# VRAM_LOG_QUEUE_MAX=5000
# First-run estimates for the OUT-OF-PROCESS consumers (MiB). Only used until the
# first real measurement for that owner; they show up as estimateSource=config-default.
# Vision sidecar (llama-server, measured Đợt 2) + how long its lease may live.
# VRAM_SIDECAR_ESTIMATE_MB=7825
# VRAM_SIDECAR_TTL_MS=900000
# Nightly `npm run kb:sync` child process (measured Đợt 2, the kb:embed:inc step).
# VRAM_KB_SYNC_ESTIMATE_MB=1251
# KB answer-eval gate child process. Same figure as kb:sync on purpose: eval-rag.mjs
# embeds through the SAME scripts/ai-kb/_gguf-embed.mjs module kb:embed:inc uses.
# VRAM_KB_EVAL_ESTIMATE_MB=1251
# Python trainer sidecar (LOCAL_TRAINER_CMD → tools/trainer/train.py, YOLOv8-seg on
# CUDA; the script's own docstring sizes it at ~6 GB).
# VRAM_TRAINER_ESTIMATE_MB=6144
# LoRA/QLoRA fine-tune sidecar (LLM_FINETUNE_CMD → tools/trainer/finetune_lora.py).
# Normally UNSET: the estimate is anchored to the real base-model file size. Set this
# only as a fallback for when that file cannot be stat'ed.
# VRAM_FINETUNE_ESTIMATE_MB=

# ─── VRAM orchestration — Pha 3: SHARED LEDGER across processes ───────────────
# Until Pha 3 every Node process kept its OWN in-memory ledger, so `api` and
# `worker` both believed the card was free. Pha 3 publishes each process's leases
# to the `vram_leases` table and reads the siblings' rows back.
# ⚠⚠ TOPOLOGY CONSTRAINT: ONE DATABASE = ONE GPU DEVICE. The table has no
# host/device column and `vram:baseline` is a SINGLE row for the whole DB. Two
# machines sharing one Postgres would read card A's baseline as card B's — no
# mechanism detects that. See drizzle/0312_vram_leases.sql before wiring a
# second site/edge.
#
# Deadline for ONE shared-ledger sync round (ms). Default 120000 = TWO tick
# periods: one slow cycle is normal, two means the source is broken.
# VRAM_SHARED_LEDGER_SYNC_TIMEOUT_MS=120000
# How old the read replica's baseline row may be before it stops being evidence
# (ms). Default 60000 = one reconciler cycle, because that is exactly how late a
# sibling's refresh can reach us. Garbage/negative falls back to the default —
# a tolerance of 0 would turn the verified flag off permanently.
# VRAM_SHARED_BASELINE_STALE_MS=60000
# How long a cross-process reclaim waits for DEVICE evidence that the bytes were
# actually released (ms), i.e. the PID leaving `nvidia-smi --query-compute-apps`.
# Timeout ⇒ the reclaim reports FAILURE and KEEPS the lease. Measured stopSidecar()
# on real hardware: 485–500 ms, so the default has ~16x headroom.
# VRAM_RECLAIM_WAIT_MS=8000
# Deferral budget for `background` consumers refused by VRAM (hours). They back
# off 15→60 min and keep retrying until this runs out; after that the run is
# reported as skipped-with-reason, never as a failure.
# VRAM_DEFER_BUDGET_HOURS=6
# Per-REQUEST wait budget (ms) for the background consumers that serve a live
# request (reranker, eval gate, embed context). Default 0 = do NOT wait: degrade
# in place rather than make a user wait. Set it only if you would rather queue.
# VRAM_DEFER_REQUEST_BUDGET_MS=0

# ─── GraphRAG 1-hop expansion (doc 11 follow-up) ──────────────────────────────
# Flag-gated, additive widening of the RAG candidate pool using the precomputed
# semantic graph (knowledge/semantic-graph.json). After cosine scoring, the top
# KB_GRAPHRAG_SEEDS seeds pull in their strongest 1-hop neighbours (edge sim ≥
# KB_GRAPHRAG_MIN_SIM, up to KB_GRAPHRAG_HOPS_PER_SEED each) BEFORE the reranker
# takes its pool, so the reranker/LLM sees semantically-linked context (multi-part
# docs, router↔schema cross-refs). Injected neighbours get a blended score
# (seedScore × edgeSimilarity × KB_GRAPHRAG_DECAY) so they compete but don't
# outrank true cosine hits, and total injection is capped at KB_GRAPHRAG_MAX_INJECT.
# Default OFF → retrieval is byte-for-byte the legacy path. Fail-safe: a missing
# or corrupt graph file silently disables expansion. Set KB_GRAPHRAG_DEBUG=true to
# log how many neighbours were injected.
# KB_GRAPHRAG_ENABLED=false
# KB_GRAPHRAG_SEEDS=5
# KB_GRAPHRAG_HOPS_PER_SEED=3
# KB_GRAPHRAG_MIN_SIM=0.72
# KB_GRAPHRAG_DECAY=0.85
# KB_GRAPHRAG_MAX_INJECT=8
#
# ENABLE-AFTER-EVAL (doc69 B4, 2026-07-27): do not flip KB_GRAPHRAG_ENABLED=true on a hunch —
# run the WITH-vs-WITHOUT recall comparison first and only enable if it shows a real lift:
#   npm run kb:graph                        # (re)build knowledge/semantic-graph.json if stale/absent
#   node scripts/ai-kb/eval-rag.mjs --graph # prints recall@K WITHOUT vs WITH GraphRAG + the delta
# The script is HONEST when the graph file is missing/empty — it says so plainly instead of
# printing a fabricated delta. CAVEAT: --graph ISOLATES the graph signal (re-sort-then-cut of the
# seed pool) and does NOT replay production's reranker/pool-width interaction — treat the delta as
# an indicative measurement, not an exact prediction of the production recall change.
# Only set KB_GRAPHRAG_ENABLED=true if delta > 0 on that run, and
# record the printed numbers (or knowledge/rag-eval-results.json's `graphRag` block) as the
# evidence for the flip. This mirrors the doc69 C3 "grounding-after-smoke" discipline: the code
# ships flag-OFF; enabling it is an ops decision made AFTER reading a real eval result, not a
# code change. No live eval has been run for this note — the flag's default stays `false`.

# ─── AI Copilot — GĐ3b multi-step agentic orchestrator ───────────────────────
# CẢNH BÁO: bật chế độ agentic nhiều bước (planner → duyệt → tiến từng bước) cho
# vai trò manager / it_admin / admin. Orchestrator ĐỨNG TRÊN HITL: mỗi bước GHI
# vẫn cần NGƯỜI DÙNG xác nhận (confirm) — KHÔNG bao giờ tự thực thi. Mặc định TẮT.
AI_AGENTIC_ENABLED=0
# Số bước tối đa của một kế hoạch (planner cắt bớt nếu vượt).
AGENT_MAX_STEPS=6
# Số thao tác GHI tối đa cho phép trong một phiên agentic (vượt → phiên paused).
AGENT_MAX_WRITES_PER_SESSION=3

# ─── G2-C · VÒNG LẶP TOOL TỰ DO CÓ CHẶN cho ĐƯỜNG CHAT ───────────────────────
# KHÁC đường agentic ở trên: nó KHÔNG lập kế hoạch trước. Nó gọi tool → ĐỌC kết quả → quyết định
# gọi tiếp hay kết luận → lặp. Đó là thứ duy nhất giải được lớp câu hỏi mà bước sau phụ thuộc
# bước trước ("tuần này line 3 defect gì tăng, VÌ SAO?" — cần Pareto rồi mới phân tích được
# nguyên nhân TRÊN kết quả Pareto đó). Đo 2026-08-17, 8 ca đa bước THIẾT KẾ: cờ TẮT 0/8, cờ BẬT
# 8/8, 2,00 vòng TB, 391 ms TB (llama-server :8091, Qwen3-30B).
# MẶC ĐỊNH TẮT — bật là chấp nhận tới `MAX_ROUNDS` lượt suy luận chọn-tool mỗi câu hỏi có tool.
AI_TOOL_LOOP_ENABLED=0
# Trần SỐ VÒNG. 3 = ca thúc đẩy cần 2 vòng + đúng 1 bước hụt được phép.
AI_TOOL_LOOP_MAX_ROUNDS=3
# Trần THỜI GIAN cho TOÀN pha tool (ms). Pha sinh câu trả lời còn tốn 10–15 s nữa.
AI_TOOL_LOOP_MAX_MS=20000
# Trần TỔNG token kết quả tool tích luỹ. Bỏ trống ⇒ suy ra 25% ngân sách ngữ cảnh MỘT SLOT
# (`serverSlotContextTokens()`), tức 8.192 khi ctx/slot = 32.768. KHÔNG khai một hằng 32768 thứ hai.
# AI_TOOL_LOOP_MAX_TOOL_TOKENS=8192
# Trần ký tự MỘT khối kết quả tool trước khi bị cắt (mặc định 2000).
# AI_TOOL_LOOP_MAX_BLOCK_CHARS=2000
#
# ⚠ AN TOÀN — KHÔNG có cờ nào tắt được các mục sau, CỐ Ý:
#   • kết quả tool + chunk KB được QUÉT injection và BỌC trong khối "dữ liệu không tin cậy" kèm
#     chỉ dẫn không thi hành — ở MỌI cấu hình, kể cả khi AI_TOOL_LOOP_ENABLED=0. Lỗ này có TRƯỚC
#     vòng lặp (`scanForInjection` chỉ quét câu hỏi NGƯỜI DÙNG); gắn bản vá vào cờ vòng lặp nghĩa
#     là ở mặc định lỗ vẫn mở.
#   • một kết quả tool bị chấm "high" ⇒ KHÔNG có vòng sau (dữ liệu hết khả năng chọn hành động).
#   • mọi tool `kind:"write"` vẫn dừng ở HITL propose→confirm, ở vòng thứ N y như vòng 1.
#   • `AI_AUTONOMY_KILL_SWITCH` cắt được vòng đang chạy (từ vòng 2; vòng 1 = hành vi chat cũ).

# ─── AI Action Inbox — Auto-Proposer (server/services/aiAutoProposer.ts) ──────
# "AI Action Inbox" (push, 1-tap approve): on 'orchestration.triggered' the
# auto-proposer drafts a SAFE engineering write-action (NG-burst on a machine
# with an existing NG threshold → adjust_ng_threshold to a conservative,
# tool-bounded value) and PROPOSES it (HITL propose-only) into the inbox of the
# responsible maintenance/supervisor users who hold the tool's RBAC permission.
# NEVER confirms/executes; proposals expire (TTL). Requires ORCHESTRATION_ENABLED
# =true to receive triggers. Default OFF (safe no-op).
AI_AUTO_PROPOSE_ENABLED=false
# Per-scope (rule:machine) throttle/dedup window (ms). Falls back to
# AI_WATCHER_MIN_INTERVAL_MS, else 60000.
# AI_AUTO_PROPOSE_MIN_INTERVAL_MS=60000
# Max proposals created per trigger run (cap on fan-out to users). Default 5.
# AI_AUTO_PROPOSE_MAX_PER_RUN=5
# How much NG-burst tightens the warning threshold, relative (0–1). Default 0.2.
# AI_AUTO_PROPOSE_NG_TIGHTEN=0.2

# --- RCA Copilot (LUỒNG ③ — doc 06) ---
# "RCA Copilot": AI auto-diagnoses a defect/error (Pareto + SPC/Cpk + anomaly +
# vision + recent config changes + similar past incidents via GraphRAG + causal
# graph) and synthesizes ranked hypotheses with a recommended fix. A WRITE fix
# that maps to a known, in-bounds write-tool can be PROPOSED (HITL propose-only)
# for 1-tap confirm via aiCopilot.confirmAction. NEVER auto-confirms/executes;
# honest degrade (insufficient evidence/low confidence → "need human
# investigation", no fabricated cause). Default OFF (runRca is a safe no-op).
# AI_RCA_COPILOT_ENABLED=false
# Minimum hypothesis confidence (0–1) to retain; below → dropped. Default 0.2.
# AI_RCA_MIN_CONFIDENCE=0.2

# "Threshold/Param Advisor" (LUỒNG ②): AI computes the RIGHT threshold/parameter
# values from data (measurement-point LSL/USL/target via percentile + parametric
# + Bayesian shrinkage → projected Cpk; NG warning/critical % from the recent
# NG-rate distribution, clamped to the adjust_ng_threshold tool bounds). Read-only
# + fail-safe; applying always goes through the EXISTING HITL paths (threshold
# approval for MP limits, proposeAction + confirmAction for NG). The technician
# only approves. Default OFF (recommend* return a disabled no-op).
# AI_THRESHOLD_ADVISOR_ENABLED=false
# Minimum samples before a recommendation is "trusted"; below → degraded (honest
# note + conservative recommendation). Default 300 (doc 06 E.0).
# AI_THRESHOLD_ADVISOR_MIN_SAMPLES=300

# --- AI Threshold Auto-Tune cron ---
# Scheduled job (node-cron) that, once a scope has enough NEW recent data AND its
# threshold is suboptimal, creates a HUMAN-IN-THE-LOOP proposal — it NEVER applies.
# NG-rate thresholds → proposeAction(adjust_ng_threshold) to the responsible users'
# inbox (1-tap approve). Measurement-point limits → a threshold-approval REQUEST in
# the approval queue. Complements the Setup Advisor's "copy now, tune later".
# Reuses aiThresholdAdvisor + proposeAction + the threshold_approvals queue.
# Default OFF → safe no-op (the cron is not even registered).
# AI_THRESHOLD_AUTOTUNE_ENABLED=false
# Cron expression + timezone. Default 04:00 daily, Asia/Ho_Chi_Minh.
# AI_THRESHOLD_AUTOTUNE_CRON=0 4 * * *
# AI_THRESHOLD_AUTOTUNE_TZ=Asia/Ho_Chi_Minh
# Min recent samples in scope to consider tuning (else skipped). Default 300.
# AI_THRESHOLD_AUTOTUNE_MIN_SAMPLES=300
# Only propose a measurement point when its current Cpk < this target. Default 1.33.
# AI_THRESHOLD_AUTOTUNE_CPK_TARGET=1.33
# Min material change to bother (avoid churn): projectedCpk-currentCpk ≥ this for
# points, OR relative NG warning/critical shift ≥ this for NG thresholds. Default 0.1.
# AI_THRESHOLD_AUTOTUNE_MIN_DELTA=0.1
# Safety cap on proposals per run; the deferred count is logged (no silent truncation). Default 20.
# AI_THRESHOLD_AUTOTUNE_MAX_PER_RUN=20
# Which scopes to tune: ng | point | both. Default both.
# AI_THRESHOLD_AUTOTUNE_SCOPE=both
# Per-scope re-propose cooldown in ms (dedup — don't re-propose the same scope within
# this window). Default 86400000 (24h).
# AI_THRESHOLD_AUTOTUNE_THROTTLE_MS=86400000
# Recency window (days) for the sample counts + advisor lookback. Default 30.
# AI_THRESHOLD_AUTOTUNE_WINDOW_DAYS=30

# --- OEE Snapshot Scheduler (doc 32 Wave R5, R1 readiness gap) ---
# oee_metrics was only ever written on-demand (the manual "Calculate OEE" button),
# so OEE reports/BI were sparse/gappy. This periodic job snapshots OEE per ACTIVE
# machine per period into oee_metrics via the SAME canonical compute path
# (oeeService.computeOEE → persistOEEMetric — SEMI E10). Idempotent (never
# double-inserts the same machine+period+end), bounded, error-isolated.
# WRITES DATA → default OFF. Turn ON in prod (single worker only — no leader
# election) to give OEE reports continuous data.
# OEE_SNAPSHOT_ENABLED=false
# Hourly snapshot of the last completed hour (cron). Default :05 every hour.
# OEE_SNAPSHOT_HOURLY_CRON=5 * * * *
# Daily rollup of the previous day (cron). Default 01:20 daily.
# OEE_SNAPSHOT_DAILY_CRON=20 1 * * *
# OEE_SNAPSHOT_TZ=Asia/Ho_Chi_Minh
# Safety cap on machines processed per run. Default 5000.
# OEE_SNAPSHOT_MAX_MACHINES=5000

# --- LIVE daily_statistics rollup (doc 54 §11 P1.2 ⭐ — make OEE/health live) ---
# daily_statistics (source for getAllOEE / OEE dashboards / warRoom line-OEE) had
# ZERO live writer — only scripts/sim-factory/sim-live-daemon.mjs filled it, so for
# REAL machines the table (and every OEE/health surface reading it) was empty. This
# periodic service aggregates TODAY's product_inspections per ACTIVE machine and
# upserts daily_statistics with an ABSOLUTE recompute (idempotent + self-healing;
# ON CONFLICT(machineId,date)). ok/ng/ntf mapping: ntf = overallResult='NTF' OR
# ntfConfirmedAt not null; ng = 'NG' & not-confirmed; ok = 'OK' & not-confirmed;
# yieldRate = final yield (NTF counts as pass). factoryId/workshopId resolve via
# machine→station→line→workshop. WRITES DATA → default OFF.
#
# ⚠ MUTUALLY EXCLUSIVE with the sim daemon. sim-live-daemon writes daily_statistics
#   CUMULATIVELY (+= EXCLUDED); this rollup writes ABSOLUTELY. Enabling BOTH against
#   the same factory double-counts. Rule of thumb:
#     • Full-Sim eval env  → sim daemon ON,  LIVE_STATS_ROLLUP_ENABLED=false.
#     • PRODUCTION          → sim daemon OFF, LIVE_STATS_ROLLUP_ENABLED=true.
# LIVE_STATS_ROLLUP_ENABLED=false
# Sweep interval ms (default 60000; hard floor 15000).
# LIVE_STATS_ROLLUP_MS=60000

# --- Machine presence sweep (doc 40 MON-F1 — availability for every transport) ---
# Infers online/offline from ot_telemetry recency → machine_status_logs (feeds OEE
# availability/health) for machines connected over OT/MQTT/MTConnect, not just Socket.io.
# READ-ONLY on recency and does NOT touch daily_statistics, so it COMPLEMENTS the sim
# daemon with NO conflict — safe to enable in Full-Sim and production alike. Default OFF.
# MACHINE_PRESENCE_ENABLED=false
# MACHINE_PRESENCE_TTL_SECONDS=120   # telemetry newer than TTL ⇒ online
# MACHINE_PRESENCE_SWEEP_MS=60000    # sweep period (default 60s, floor 10s)

# --- Full-Sim OT telemetry emitter (doc 54 P1.1) ---
# Emits synthetic ot_telemetry (heartbeat/state/cycle/temp) for seeded machines so the
# presence sweep above flips them ONLINE without hardware. FULL-SIM ONLY — do NOT enable
# where ot_telemetry comes from real adapters/machines. Writes ot_telemetry (NOT
# daily_statistics) so it is safe alongside the sim daemon; rows carry meta.source='SIM-OT'.
# Default OFF.
# SIM_OT_TELEMETRY_ENABLED=false
# SIM_OT_TELEMETRY_INTERVAL_MS=30000  # emit period (default 30s, floor 5s)

# --- REST /api/export document + aggregate datasets (doc 32 Wave R5, item 19) ---
# XLSX/PDF are BUFFERED (renderReport can't stream) so the raw row-level datasets
# (inspections/measurements) are row-capped for those formats; CSV/JSON stay
# streamed/uncapped. Aggregate datasets (yield/oee/defect-pareto) are small rollups.
# EXPORT_XLSX_MAX_ROWS=100000
# EXPORT_PDF_MAX_ROWS=5000

# --- doc 54 P2.4 reporting breadth ---
# Render-layer OOM ceiling for buffered exports (PDF/XLSX/CSV/HTML). Over the cap the
# render keeps EXPORT_MAX_ROWS rows + appends a visible truncation marker/note + sets
# truncated=true (never silently drops). Default 100000.
# EXPORT_MAX_ROWS=100000
# Archive each scheduled report run into report_artifacts (re-downloadable). Default OFF.
# SCHEDULED_REPORT_ARCHIVE_ENABLED=false
# Email fallback chain: db-SMTP → env-SMTP → SendGrid → SES (all credential-gated; when a
# transport is unset the code logs "not configured" and stays retryable — never fakes send).
# SENDGRID_API_KEY=
# SENDGRID_FROM=
# SES_SMTP_HOST=            # e.g. email-smtp.us-east-1.amazonaws.com
# SES_SMTP_USER=
# SES_SMTP_PASS=
# SES_SMTP_PORT=587
# SES_FROM=
# REPORT_EMAIL_FROM=        # shared fallback From (else SMTP_FROM/SMTP_USER)
# REPORT_EMAIL_FROM_NAME=SYNAPSE Reports
# Mobile push (report delivery) via existing fcmService (also bridges iOS/APNs).
# FIREBASE_SERVICE_ACCOUNT_JSON=   # service-account JSON or base64
# FIREBASE_PROJECT_ID=
# APNS_KEY_ID=              # standalone APNs DETECTED but routed via FCM, not delivered directly
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_AUTH_KEY_BASE64=

# --- AI Setup Advisor (LUỒNG ① + E.0 — doc 06) ---
# When setting up a NEW machine, the wizard pre-fills the whole config from the
# MOST SIMILAR existing machine/product (measurement points, thresholds, NG
# thresholds, station, recommended model). The technician REVIEWS + APPROVES via
# the wizard's EXISTING RBAC'd create mutations — this advisor never writes and
# never throws. Default OFF (suggestSetup returns a disabled defaults bundle).
# AI_SETUP_ADVISOR_ENABLED=false
# Per-point sample threshold: ≥ this many recorded samples → compute limits via
# suggestThresholds (source:"data"); below → COPY the template's stored limits
# (source:"copied") and let the threshold auto-tune cron refine later. Default 200.
# AI_SETUP_ADVISOR_MIN_SAMPLES=200

# --- ONNX inference Execution Provider (B9 — GPU tăng tốc) ---
# Mặc định CPU. Trên Windows + RTX (vd 4050/4090) bật GPU qua DirectML (KHÔNG cần CUDA Toolkit/cuDNN):
# ENABLE_GPU=true                 # → dùng DirectML EP (DirectX 12) + fallback CPU
# AI_INFER_EP=dml                 # override tường minh: dml | cuda | tensorrt | cpu (ưu tiên hơn các cờ dưới)
# ENABLE_CUDA=true                # chỉ khi onnxruntime build có CUDA EP (npm Windows KHÔNG kèm)
# ENABLE_TENSORRT=true            # chỉ khi đã cài TensorRT runtime
# AI_INFER_MAX_BATCH=4            # VRAM 6-8GB → 2-4; RTX 4090 (24GB) → 8-16
# Kiểm tra môi trường: node scripts/check-tier3-env.mjs

# ─── Sprint F1.1 — OT Connectivity Framework ─────────────────────────────────
# Khung kết nối thiết bị công nghiệp (OPC-UA / Modbus / S7 / Mitsubishi MC /
# EtherNet-IP) chạy SONG SONG với OPCUA_GATEWAY_ENABLED cũ. Tắt mặc định.
# Bật framework: tải adapter từ DB (deviceAdapters.isEnabled) và bắt đầu ingest.
OT_GATEWAY_ENABLED=false
# Chu kỳ poll mặc định (ms) khi adapter không cấu hình riêng.
OT_DEFAULT_POLL_INTERVAL_MS=5000
# Bật driver stub (mô phỏng dữ liệu, không cần hạ tầng thật) — chỉ stub chạy trong F1.1.
OT_STUB_ENABLED=false
# Phát thêm bản chuẩn hoá sang UNS (yêu cầu UNS_BRIDGE_ENABLED=true). Tái dùng publisher hiện có.
OT_INGEST_TO_UNS=false
# Cờ chuẩn bị cho driver thật (F1.2/F1.3 — package CHƯA cài).
OT_OPCUA_ENABLED=false
OT_MODBUS_ENABLED=false
OT_S7_ENABLED=false
OT_MITSUBISHI_MC_ENABLED=false
OT_ETHERNET_IP_ENABLED=false

# ─── Telemetry STORE-AND-FORWARD (doc 24 C1) — no OT sample dropped on DB outage ─
# Today telemetryBus inserts canonical ot_telemetry rows DIRECTLY to the DB; a DB/TSDB
# outage means the sample is silently DROPPED (the audit's biggest production gap).
# When ON: a batch that fails to persist (DB down/degraded) is APPENDED to a durable
# local WAL (append-only JSONL + in-memory mirror) instead of being dropped; on the next
# healthy write the backlog is BACKFILLED in order, IDEMPOTENT by (adapterId, tag, ts).
# The buffer is BOUNDED (max entries + max age); overflow drops the OLDEST — never
# silently: every drop is counted + warned + metered. Mặc định OFF → behaviour EXACTLY
# as today (passthrough). Additive; no change to the canonical row shape or consumers.
OT_STORE_FORWARD_ENABLED=false
# WAL file path (JSONL). Restored on start so a restart replays the backlog. Default ./data.
# OT_STORE_FORWARD_FILE=./data/ot-store-forward.jsonl
# Max buffered rows before the OLDEST are dropped (counted + warned). Default 100000.
# OT_STORE_FORWARD_MAX=100000
# Max age (ms) a buffered row may live before it is dropped on the next sweep. Default 24h.
# OT_STORE_FORWARD_MAX_AGE_MS=86400000
# Rows drained per backfill batch (bounded work per attempt). Default 500.
# OT_STORE_FORWARD_DRAIN_BATCH=500

# ─── R4 (doc 48) — OT ingest COPY fast path (100k throughput lever) ────────────
# The default persist path is a multi-row parameterised INSERT into the 6-index
# ot_telemetry hypertable — doc 49 R3 measured it topping out ~10k pts/s single-node,
# and Postgres' 65535 bind-parameter ceiling caps one statement at ~5957 rows (11 cols),
# so it cannot even express a 100k batch. When ON, a batch AT/ABOVE the row threshold is
# instead STREAMED via COPY into a per-batch TEMP table, then INSERT…SELECT…ON CONFLICT
# DO NOTHING moves it into ot_telemetry: SAME rows, SAME dedup (uq_ot_telemetry_device_
# metric_ts), SAME return contract, no parameter ceiling, no per-row bind/parse. Default
# OFF ⇒ byte-for-byte the current INSERT path. Small batches stay on the INSERT path
# (COPY setup isn't worth it) — tune the cutover with OT_INGEST_COPY_MIN_ROWS. Degrade-
# safe: if the raw postgres.js client can't be reached, it falls back to INSERT.
OT_INGEST_COPY_ENABLED=false
# Minimum batch size (rows) to use COPY when enabled; below it → INSERT. Default 200.
# OT_INGEST_COPY_MIN_ROWS=200

# ─── OT connection HA supervision (doc 24 C3) ─────────────────────────────────
# When ON each OT adapter is supervised (health checks + exponential-backoff
# reconnect + dual-endpoint primary/secondary failover). PROD PROFILE: true.
OT_CONN_HA_ENABLED=false

# ─── Doc 27 W2-C (C3/R11) — INSPECTION ingest store-and-forward ───────────────
# Durability for machineApi.submitInspection: a TRANSIENT failure (DB down)
# buffers the FULL submission payload (incl. base64 images) to a disk WAL and
# ACKs the machine `{ success:true, queued:true, submissionId }`; a background
# worker replays it through the SAME pipeline with idempotency (submission key =
# machine+serial+timestamp hash; dedup vs an applied-ledger AND a live DB row
# check so machine-side retries + WAL replays can never double-insert).
# Permanently invalid payloads (bad key / validation) go to a .dead.jsonl
# dead-letter file. Unset → follows OT_STORE_FORWARD_ENABLED (one prod switch).
#
# ⚠️  BẮT BUỘC KHI GO-LIVE: `INSPECTION_STORE_FORWARD_ENABLED=true` (doc 51 QĐ#6 —
#     chủ hệ đã DUYỆT). Để `false` ở production = MẤT DỮ LIỆU KIỂM khi DB sập
#     (doc 51 R7: lưới an toàn có sẵn nhưng đang TẮT). Dev: false · PROD: true.
#     Điều kiện xuất xưởng kèm theo: smoke-test replay WAL (hạ DB → gửi inspection
#     → thấy {queued:true} → dựng DB → WAL drain về 0, KHÔNG ghi trùng).
#     Checklist đầy đủ: docs/ECOSYSTEM/52_P0_MACHINE_AUTH_ROTATION_RUNBOOK.md §6.
INSPECTION_STORE_FORWARD_ENABLED=false
# INSPECTION_STORE_FORWARD_FILE=./data/inspection-store-forward.jsonl
# Bounds — overflow drops the OLDEST, counted + warned (payloads carry images!).
# INSPECTION_STORE_FORWARD_MAX=20000
# INSPECTION_STORE_FORWARD_MAX_AGE_MS=259200000        # 72h
# INSPECTION_STORE_FORWARD_MAX_BYTES=536870912         # 512 MiB
# INSPECTION_STORE_FORWARD_DRAIN_BATCH=50              # replays per backfill pass
# INSPECTION_STORE_FORWARD_INTERVAL_MS=15000           # worker base interval (×2 backoff while DB down)
# INSPECTION_STORE_FORWARD_MAX_INTERVAL_MS=300000      # backoff ceiling
# INSPECTION_STORE_FORWARD_ALERT_DEPTH=500             # ERROR-log alert when WAL depth ≥ this

# ─── Doc 55 Item 1 (PA-A "reserve-id") — INSPECTION single physical transaction ──
# machineApi.submitInspection persists an inspection in TWO steps by default: the
# header commits in its own transaction, then the measurement rows commit in a
# SEPARATE one. A crash BETWEEN them leaves an EMPTY header (no measurements) that
# the idempotency short-circuit then resolves every retry to. The OFF-path already
# MITIGATES this with a live-process compensator (INGEST_COMPENSATE_ORPHAN_HEADER),
# but a hard crash in the window still slips through.
# ON (PA-A): reserve the inspection id from its sequence FIRST (so the pre-uploaded
# image keys + measurement rows share it), then commit header + measurements in ONE
# physical transaction — a failure rolls BOTH back, closing the window entirely. The
# only residue on a failure is orphaned images (reaped by the existing orphan-image
# reaper); there is no header compensation needed on this path.
# DEFAULT OFF = the two-phase path, byte-for-byte unchanged. Turn ON in PRODUCTION
# only after it is PROVEN in staging (the reserved-id path is the newer code path).
# INSPECTION_SINGLE_TX_ENABLED=false

# ─── Doc 51/55 CASE #11 — FIDUCIAL REGISTRATION on machineApi.syncMeasurementPoints ─
# Căn toạ độ điểm đo về khung CHUẨN (canonical) bằng một phép biến đổi SIMILARITY
# (tịnh tiến + xoay + phóng đều) suy ra từ các fiducial mà MÁY QUAN SÁT được cho lần
# push này (trường `observedFiducials`), khớp theo `code` với fiducial_marks của sản
# phẩm. Khi board đặt lệch/xoay dưới camera, positionX/Y máy gửi rơi SAI vị trí
# canonical (CASE #11); phép fit này chiếu chúng về đúng chỗ TRƯỚC khi ghi.
# OFF (mặc định) = giữ NGUYÊN đường resolveCoordinates cũ (byte-for-byte). ON = nếu
# đủ fiducial và fit đạt (RMS ≤ ngưỡng) thì thay thế nhánh scale-độ-phân-giải bằng
# phép similarity (similarity đã bao trùm uniform scale). Fit tệ (thiếu điểm / suy
# biến / RMS > ngưỡng) → KHÔNG báo lỗi cho máy, tự động RƠI VỀ hành-vi-cũ và gắn cờ
# lý do trong response (registrationRejectedReason). Chạy telemetry residual (đọc
# coordTransformations trong sync_logs + registrationResidualPx trong response) một
# thời gian TRƯỚC khi tin dùng cho production.
# ⚠ Chỉ căn theo PIXEL-space: sản phẩm coordinateMode='mm' vẫn fit trên đơn vị thô
# của fiducial_marks (không quy đổi đơn vị) — sửa vị trí chứ không đổi hệ đơn vị.
# MACHINE_FIDUCIAL_REGISTRATION=false
# Số fiducial QUAN SÁT tối thiểu để thử fit (sàn chính sách; lib cũng cần ≥2). <sàn → 'insufficient' + fallback.
# MACHINE_FIDUCIAL_MIN_MARKS=2
# Ngưỡng RMS reprojection (px) để CHẤP NHẬN fit. Vượt → 'residual_exceeded' + fallback. Mặc định 5.0.
# MACHINE_FIDUCIAL_MAX_RESIDUAL_PX=5.0

# ─── Doc 55 Item 3 — PRODUCT VARIANT (biến thể sản phẩm first-class) ──────────
# Bật tầng biến thể cho SYNC + INGEST của máy. OFF (mặc định) = MỌI điểm đo là
# base/chung như hôm nay: máy KHÔNG cần gửi variantCode, product_inspections.variantId
# luôn NULL, getPoints/deltaSyncPoints/checkPointsVersion/submitInspection giữ hành vi
# BYTE-IDENTICAL với trước biến thể. ON = máy CÓ THỂ gửi `variantCode` (optional) trong
# getPoints/deltaSyncPoints/checkPointsVersion/submitInspection:
#   • có variantCode → tải/đóng dấu ĐÚNG biến thể (tập điểm hiệu-lực = base − loại-trừ
#     + ghi-đè ∪ điểm-thêm; version = pointsConfigVersion RIÊNG của biến thể).
#   • thiếu variantCode + model có >1 biến thể → gán BASE + tag ingestMode=
#     'variant_unspecified' (đo tỷ lệ chưa-khai-báo, giống tag commissioning — QĐ#12).
#   • điểm-lạ auto-provision cho biến thể non-base = hàng measurement_point_defs có
#     variantId set (QĐ#11).
# Yêu cầu migration 0286 (product_variants + measurement_point_defs.variantId +
# product_inspections.variantId). Vắng 0286 ⇒ CỨ ĐỂ OFF (bật mà thiếu bảng sẽ lỗi đọc).
# PRODUCT_VARIANT_ENABLED=false

# ─── Doc 27 W2-C (C7/M4) + doc 51 P0 (QĐ#1) — machine credentials ─────────────
# Hai ĐƯỜNG YẾU để máy xác thực, cả hai đều là rủi ro R1 của doc 51 (ai ở trong
# LAN cũng giả mạo được máy → bơm inspection/NG giả). QĐ#1 chốt: SIẾT THEO
# MIGRATION CÓ KIỂM SOÁT — KHÔNG flip tắt đột ngột làm chết máy đang chạy.
#
# Cả 2 cờ dùng CHUNG bộ giá trị 3 nấc (vẫn nhận true/false kiểu cũ):
#   allow      (mặc định) — chấp nhận mọi nơi; MỖI lần dùng đều phát telemetry.
#   read-only             — chỉ cho scope ĐỌC (equipment:read); MỌI đường GHI
#                           (ingest:write / edge:sync / không khai scope) bị chối.
#                           Nấc trung gian: chặn ngay ingest giả, máy chưa rotate
#                           vẫn poll được cấu hình và lỗi hiện ra dạng 401-ghi
#                           dễ chẩn đoán thay vì mất tích hoàn toàn.
#   deny                  — không chấp nhận ở đâu cả (= `false` nghĩa cũ, giữ y nguyên).
#
# THỨ TỰ SIẾT (chi tiết: docs/ECOSYSTEM/52_P0_MACHINE_AUTH_ROTATION_RUNBOOK.md):
#   1. `node scripts/machine-key-rotation-report.mjs` → máy nào còn đường yếu?
#   2. machineApi.issueKey cho từng máy → nạp khoá mk_ vào máy, gửi qua HEADER
#      `Authorization: Bearer <mk_...>` hoặc `X-API-Key: <mk_...>` (KHÔNG nhét body).
#   3. Verify telemetry sạch (metric avi_aoi_security_events_total
#      {type="machine_weak_auth_allowed"} = 0 suốt ≥1 ca) → read-only → deny.
#   4. Xoá nốt machines.apiKey plaintext.
#
# Khoá SHARED plaintext dùng chung (machines.apiKey).
# Bản mẫu này ship sẵn `false` (= `deny`) từ W0.4/doc35 — cài mới thì AN TOÀN NGAY.
# Deployment ĐANG CHẠY với máy chưa rotate: tự đặt `allow` trong .env của mình rồi
# đi hết quy trình §3 doc 52. PROD (đích): deny.
MACHINE_SHARED_KEY_ALLOWED=false  # W0.4 doc35: secure ship default; existing deployments override in their own .env until machines rotate
# Đường machineCode-only — KHÔNG có bí mật nào cả (chỉ cần biết mã máy in trên vỏ).
# Để trống = `allow` (tương thích ngược — doc 51 §5.6: đây vẫn là phương thức được
# TÀI LIỆU HOÁ chính, tắt thẳng là chết máy đang chạy + demo/Full-Sim).
# PROD (đích): deny — sau khi đi hết quy trình §3 doc 52.
# MACHINE_CODE_ONLY_ALLOWED=allow
# Ingest requests per machine key per minute (in-memory fixed window; the Redis
# shared limiter is Đợt 4 / gap B6). 0 disables. Default 600.
# MACHINE_INGEST_RATE_LIMIT_PER_MIN=600
# Public machine.register throttle (gap M4): per-IP registrations/hour (0 = off,
# default 20) and a global cap on PENDING registrations (0 = off, default 200).
# MACHINE_REGISTER_RATE_LIMIT_PER_HOUR=20
# MACHINE_REGISTER_PENDING_CAP=200
# Doc 56 Đ0-A (RTM-6/GAP-1): auth máy trên Socket.io (sync_started/confirm_mapping) — off (mặc định, hành vi cũ) | log (nhận legacy-OR-mk_, đếm mismatch — cần 0 mismatch ≥1 tuần trước khi siết) | enforce (sai → từ chối).
SOCKET_MACHINE_AUTH_MODE=off
#
# Doc 51 P0 (R1 ✔ đã tự kiểm chứng) — endpoint PUBLIC `machineApi.config` trả về
# `machine.apiKey` PLAINTEXT khi chỉ cần biết serialNumber (hierarchyRouters.ts:706-722).
# Bất kỳ ai trong LAN đoán/đọc được serial (in trên vỏ máy) là lấy được credential.
# false (mặc định mới) = KHÔNG trả apiKey qua đường public; máy lấy khoá mk_ qua
# wizard admin / one-time claim-token. true = giữ hành vi CŨ, CHỈ dùng tạm trong
# cửa sổ migration nếu firmware cũ còn phụ thuộc. Dev: false · PROD: false.
# MACHINE_CONFIG_EXPOSE_APIKEY=false
#
# ─── Doc 51 P3 (§5.1) — ZERO-TOUCH ENROLLMENT (gỡ nghẽn single-admin) ────────
# Hôm nay: register→'pending', PHẢI admin approve+cấp khoá TỪNG máy. Enrollment
# token cho máy HỢP LỆ tự pending→approved + tự nhận khoá mk_ scoped, VẪN audit +
# revoke được. Máy đổi token qua machine.enroll; admin phát token qua
# machine.issueEnrollmentToken (one-time, hoặc allowlist serialPattern + maxUses).
# ENROLLMENT_ENABLED bật CÓ KIỂM SOÁT (QĐ#1): false (mặc định) = endpoint public
# `enroll` TỪ CHỐI (feature tắt); admin vẫn phát token sẵn được trước khi bật.
# Dev: tuỳ · PROD: bật khi đã sẵn sàng roll-out hàng loạt.
# ENROLLMENT_ENABLED=false
# TTL token enrollment (phút). Mặc định 60; kẹp (0, 30 ngày]. Batch allowlist có
# thể để dài hơn claim-token (15') vì phát trước cho cả dây chuyền.
# MACHINE_ENROLLMENT_TOKEN_TTL_MINUTES=60
# Chống brute-force allowlist: số lần enroll/IP/giờ (0 = tắt, mặc định 30).
# MACHINE_ENROLL_RATE_LIMIT_PER_HOUR=30
#
# ─── Doc 51 P3 (CASE #10) — HẠN MẶC ĐỊNH cho khoá máy mk_ ────────────────────
# issueMachineKey mặc định expiresAt=null (khoá VĨNH VIỄN). QĐ#1: để trống / 0 =
# GIỮ null (KHÔNG phá máy đang chạy — tương thích ngược). Đặt >0 = OPT-IN: khoá
# mới KHÔNG chỉ định hạn riêng sẽ nhận `now + N ngày`. Khoá cũ KHÔNG bị đụng.
# Ghép với listExpiringMachineKeys() + cron để CẢNH BÁO trước khi khoá hết hạn
# (kẻo cả ca ingest chết vì 401). Gợi ý PROD: 90.
# MACHINE_KEY_DEFAULT_TTL_DAYS=0
#
# ─── Doc 56 Đ1 (Trục 2) — RESULT ingest cho máy automation (bắt vít/keo/hàn) ──
# submitProcessResult + REST /api/v1/ingest/process-result. false (mặc định) =
# endpoint trả PRECONDITION_FAILED (ship-dark, đường cũ byte-identical).
# PROCESS_RESULT_INGEST_ENABLED=false
# WAL đĩa cho process-result khi DB chập chờn (mirror inspection store-forward).
# PROCESS_STORE_FORWARD_ENABLED=false
# Validate stepType ∈ process_step_types: off (mặc định) | log | enforce.
# PROCESS_ATTR_VALIDATE_MODE=off
#
# ─── Doc 56 Đ2a (Trục 1) — credential & identity hợp nhất (đều default OFF) ───
# mk_-only cho fleet MỚI: approve/claim máy automation/iot mint khoá mk_ (KHÔNG
# ghi machines.apiKey plaintext); authenticateMachine cấm machineCode-only +
# shared-key cho nhóm automation/iot. aoi_avi giữ nguyên.
# MACHINE_CRED_MK_ONLY_ENABLED=false
# Cảnh báo khoá mk_ sắp hết hạn (cron tuần → action inbox, listExpiringMachineKeys(14)).
# MACHINE_KEY_EXPIRY_ALERT_ENABLED=false
# IoT là machines-row first-class (QĐ1): mqtt_clients.machineId link + station ảo
# IOT-<workshop> (dưới line ảo IOT-<workshop>) + revoke MQTT khi retire.
# IOT_DEVICE_CLASS_ENABLED=false
# Mở approve/listPending máy cho non-admin có quyền machine_registration (grant per-USER).
# MACHINE_APPROVE_RBAC_OPEN_ENABLED=false
# Bridge MQTT synapse/.../telemetry → telemetryBus (fleet mới publish telemetry qua MQTT).
# MQTT_TELEMETRY_BRIDGE_ENABLED=false
#
# ─── Doc 56 Đ3/Đ5 (Trục phân tích) — ProcessAnalytics + SPC + fleet + mart (đọc) ─
# processResult.stats/metricSeries/spcChart/fleetRollup/dailyRollup/refreshDaily +
# tab "Kết quả process" (MachineCockpit) + trang /process-analytics. false (mặc
# định) = router trả rỗng (ship-dark) ⇒ UI về empty-state.
# PROCESS_ANALYTICS_ENABLED=false
#
# ─── Doc 56 Đ4 (Trục 3) — config-sync generic + governance (đều default OFF) ──
# check/get/ackConfigApplied + desired/reported shadow (mig 0293) + deploy→notify.
# false = 3 procedure trả PRECONDITION_FAILED (endpoint ship-dark).
# CONFIG_SYNC_GENERIC_ENABLED=false
# Heartbeat running[] → reported* shadow + Andon drift alert.
# CONFIG_DRIFT_REPORT_ENABLED=false
# Typed recipe schema (screw/dispense/weld/iot) tại recipes.create/approve: off|log|enforce.
# RECIPE_TYPED_SCHEMA_MODE=off
# Spec-gate server-authoritative tại submitProcessResult (process_spec_limits; đính
# metadata pass/fail — KHÔNG override result máy gửi).
# PROCESS_SPEC_GATE_ENABLED=false
#
# ─── Doc 56 Đ2b (Trục 1 — UI) — wizard đăng ký hợp nhất V2 (CLIENT, Vite) ─────
# DeviceOnboardingHubV2 3 nhánh (aoi_avi/automation/iot) tại /device-onboarding.
# doc 59 Cụm C USER duyệt: MẶC ĐỊNH ON — cửa thêm-thiết-bị duy nhất; /machine-onboarding
# + /aoi-onboarding redirect vào. Đặt =false để quay lại các wizard cũ.
# VITE_DEVICE_ONBOARD_WIZARD_V2_ENABLED=true
#
# ─── Doc 59 (CLIENT) — WorkspaceShell master-detail (hợp nhất giao diện) ──────
# Machine Workspace IS /device-monitor (rail fleet ⇄ cockpit ⇄ AI drawer). doc 59 P3
# USER duyệt: MẶC ĐỊNH ON. Đặt =false (hoặc localStorage 'workspaceShellEnabled'="false")
# để quay lại hub/trang cũ (byte-identical).
# VITE_WORKSPACE_SHELL_ENABLED=true
#
# ─── Doc 51 P3 — presence đa-instance + batch-ingest + heartbeat limit ───────
# §5.3: presence máy (online/offline) — 'auto' (mặc định: Redis nếu REDIS_URL có,
# else Map in-memory single-node), 'memory', 'redis'. Đa-instance CẦN redis.
# MACHINE_PRESENCE_STORE=auto
# MACHINE_PRESENCE_TTL_SEC=90
# CASE #2/#9: batch-ingest submitInspectionBatch — số inspection tối đa/batch (200)
# + concurrency trong batch (8, dưới pool-25). Reconnect-drain 5000 → ~25 batch.
# MACHINE_INGEST_BATCH_MAX=200
# MACHINE_INGEST_BATCH_CONCURRENCY=8
# §5.1: heartbeat có limiter RIÊNG (không ăn quota ingest). 0 = tắt, mặc định 120/phút/máy.
# MACHINE_HEARTBEAT_RATE_LIMIT_PER_MIN=120
# CASE #10: ngưỡng (ngày) cảnh báo key sắp hết hạn trong response heartbeat/batch (14).
# MACHINE_KEY_ROTATION_WARN_DAYS=14
#
# ─── Doc 51 P1 — ingest provenance / gate / image (all safe defaults) ────────
# CASE #3 clock-skew: yêu cầu inspectionTime có offset múi giờ. false (mặc định)
# = chấp nhận timestamp naive nhưng GẮN CỜ skew (không chặn — máy cũ vẫn chạy);
# true = từ chối naive (bật SAU khi vendor đã chuẩn hoá). Dev: false · PROD: false→true.
# INGEST_REQUIRE_TIME_OFFSET=false
# Ngưỡng cảnh báo lệch giờ máy vs server (giây). Vượt → cột clockSkewFlagged + alert.
# INGEST_CLOCK_SKEW_WARN_SECONDS=300
# Bật alert khi phát hiện skew. TRUE mặc định (khác chuẩn flag-OFF của repo — CÓ CHỦ
# ĐÍCH: detector im lặng = CASE #3 vẫn mù). Chống bão bằng cooldown/máy bên dưới.
# INGEST_CLOCK_SKEW_ALERT_ENABLED=true
# INGEST_CLOCK_SKEW_ALERT_COOLDOWN_SEC=900
#
# QĐ#2 (CASE #12) — spec-gate chấm theo SNAPSHOT giới hạn tại thời điểm board được đo
# (thay vì limit LIVE → hết split-brain OK/NG). false (mặc định) = giữ hành vi LIVE
# hiện tại; true = dùng snapshot cho board 'stale_config'. Ghi gateConfigVersion để truy vết.
# SPEC_GATE_SNAPSHOT_ENABLED=false
# CASE #5 — trần base64 mỗi ảnh trong submitInspection/uploadImage (byte, mặc định 20MB).
# Chặn payload bất thường trước khi giữ trong RAM app-server. Vượt → zod reject.
# MACHINE_INGEST_MAX_IMAGE_B64=20000000

# ─── 2026-08-18 — MÃ TENANT SUY TỪ MÁY, KHÔNG LẤY TỪ JSON (phamViGhiMay.ts) ──
# corporateCode/factoryCode/workshopCode/lineCode của một hàng ĐƯỢC GHI suy từ chuỗi
# machine → station → line → workshop → factory của MÁY ĐÃ XÁC THỰC; JSON chỉ còn là
# lời khai để ĐỐI CHIẾU (lệch ⇒ FORBIDDEN `machine_tenant_claim_mismatch`; không phân
# giải được ⇒ FORBIDDEN `machine_tenant_unresolved`, KHÔNG lưu NULL).
# ⚠⚠ Mặc định TRUE — khác chuẩn flag-OFF của repo, và đó là một SỐ ĐO: trên
# `aoi_management` (22.996 bản ghi) chuỗi suy phân giải 22.996/22.996 và **0** hàng khai
# lệch ⇒ bật mặc định từ chối ĐÚNG 0 hàng đang có thật.
# ⚠⚠ Đặt =false là MỞ LẠI LỖ (lời khai đi thẳng vào cột tenant). Nó chỉ tồn tại làm
# đường lùi 5 giây cho một sự cố ingest ban đêm.
# INGEST_TENANT_DERIVE_ENABLED=true
# TTL bộ nhớ đệm chuỗi phân cấp theo máy (ms). Một máy vừa bị DỜI TRẠM sẽ dùng chuỗi cũ
# tối đa chừng này. 0/không đặt → 60s.
# INGEST_TENANT_CACHE_TTL_MS=60000

# ─── MTConnect ingestion (open standard for CNC / machine tools) ─────────────
# Polls MTConnect Agent HTTP/XML endpoints (/probe, /current) and maps DataItems
# into telemetry. Additive + parallel to the OT framework. Tắt mặc định (OFF).
MTCONNECT_ENABLED=false
# Nguồn poll: JSON array hoặc CSV "agentUrl|machineCode|pollMs" (ngăn cách bằng ';').
# machineCode khớp machines.code → resolve machineId. pollMs >= 500 (mặc định 5000).
#   JSON:  [{"agentUrl":"http://192.168.1.50:5000","machineCode":"CNC-01","pollMs":3000}]
#   CSV:   http://192.168.1.50:5000|CNC-01|3000; http://192.168.1.51:5000|CNC-02|5000
# I3b-1: an optional 4th field `vendor` (JSON key "vendor" or CSV pipe field) threads the
# device MANUFACTURER so CONDITION alarms resolve per-vendor taxonomy rows (mapAlarm);
# absent → 'mtconnect'. The poller now ALSO derives the Unified Equipment Model
# (recipe_id/cycle_count/production_counter/utilization) from Program/PartCount/Execution.
# Alarm→Andon still requires EQ_INTEG_ENABLED=true (no-op passthrough when off).
#   JSON w/ vendor: [{"agentUrl":"http://a:5000","machineCode":"CNC-01","vendor":"fanuc"}]
#   CSV  w/ vendor: http://a:5000|CNC-01|3000|fanuc
MTCONNECT_SOURCES=

# ─── R0 PREDICTIVE MAINTENANCE LOOPS (doc 16 §9 Khối 4) — default OFF ─────────
# Two closed loops on the async analytics path (never on a control path).
#
# R0-1 — MQTT sensor ingest → machine_sensor_readings. Reuses the EXISTING Aedes
# broker (no new connection). When true, sensor messages on the convention topic
#   factory/{factoryId}/{machineCode}/sensor/{sensorType}
# are parsed and written to machine_sensor_readings (source='mqtt'). machineCode
# is resolved to machineId via machines.code; unknown machine → logged + skipped.
# Payload: bare number ("0.42") OR {"value":0.42,"unit":"mm/s","timestamp":"…"}.
PDM_SENSOR_INGEST_ENABLED=false
#
# R0-2 — Predictive risk → auto maintenance work-order. When true, the predictive
# maintenance cycle auto-creates a PREDICTIVE / OPEN maintenanceWorkOrder for any
# machine whose failure risk is above the alert threshold (PM_RISK_THRESHOLD).
# Idempotent: one open predictive WO per machine (no duplicate while one is open).
PDM_AUTO_WORKORDER_ENABLED=false

# ─── R0 ERP INTEGRATION GATEWAY (doc 16 §4 Khối 0 / §15) — default OFF ────────
# Khối 0: inbound order/BOM intake + durable outbound publishing. Both flags
# default OFF; when off the surfaces are safe no-ops (clear 503 / disabled).
#
# R0-3 — INBOUND ERP intake. When true, exposes idempotent, versioned POST
#   /api/v1/orders  → upsert production_orders (emits eventBus order.created)
#   /api/v1/bom     → upsert bom_definitions + bom_line_items
# Auth: scoped API key with the "erp:write" scope (master key implicitly has it).
# Every POST requires an idempotency key (X-Idempotency-Key header or body
# `idempotencyKey`) — a duplicate key REPLAYS the prior result (no double insert)
# — and a `schemaVersion` envelope field. When off → 503 erp_inbound_disabled.
ERP_INBOUND_ENABLED=false
#
# R0-4 — DURABLE OUTBOUND publishing via the integration_outbox table. When true,
# a background worker drains pending rows to their targetEndpoint with exponential
# backoff + a per-endpoint circuit-breaker; exhausted rows move to status='dead'
# (dead-letter). enqueueOutbox(event) is the producer helper. When off, the worker
# never starts (enqueue still persists rows, just nothing drains them).
ERP_OUTBOX_ENABLED=false
# Outbox tunables (optional; sensible defaults shown):
# ERP_OUTBOX_MAX_ATTEMPTS=6              # attempts before a row is dead-lettered
# ERP_OUTBOX_BACKOFF_BASE_MS=5000        # backoff = base * 2^(attempts-1), capped
# ERP_OUTBOX_BACKOFF_CAP_MS=600000       # 10 min cap
# ERP_OUTBOX_BATCH_SIZE=25               # rows drained per poll
# ERP_OUTBOX_POLL_MS=5000                # worker poll interval
# ERP_OUTBOX_HTTP_TIMEOUT_MS=10000       # per-delivery HTTP timeout
# ERP_OUTBOX_BREAKER_THRESHOLD=5         # consecutive failures → open the breaker
# ERP_OUTBOX_BREAKER_COOLDOWN_MS=30000   # cooldown before a half-open probe
#
# Outbox target endpoints (optional). A producer only enqueues an event family
# when its endpoint is configured AND ERP_OUTBOX_ENABLED is on — otherwise no-op.
# ERP_QUALITY_ENDPOINT=https://erp.example.com/hooks/quality       # quality-result (AOI/vision inspection)
# ERP_OEE_ENDPOINT=https://erp.example.com/hooks/oee               # oee-metric (periodic OEE)
# ERP_PRODUCTION_ENDPOINT=https://erp.example.com/hooks/production  # production-event (WIP station pass)
# ERP_GENEALOGY_ENDPOINT=https://erp.example.com/hooks/genealogy    # genealogy-record (component merge)

# ─── K0+ ERP HARDENING (doc 16 §4 Khối 0 / doc 18 §6) — default OFF ───────────
# Hardens the R0 ERP gateway to production-grade: OAuth2 client-credentials auth,
# ISA-95 / B2MML XML codec, and an mTLS transport seam. All ADDITIVE — existing
# API-key / bearer / MASTER_API_KEY auth and the JSON contract are UNCHANGED.
#
# K0+-a — OAuth2 client-credentials. When TRUE, POST /api/v1/oauth/token issues a
# short-lived signed JWT (HS256) to a registered erp_oauth_clients row exchanging
# its client_id + client_secret; that token is then accepted as an ALTERNATIVE
# Bearer credential on /orders /bom (falls back to API-key auth otherwise). When
# off, /oauth/token returns 503 oauth_disabled and only the existing auth applies.
# Manage clients via tRPC erpAdmin.* (admin_system perm; secret shown once).
ERP_OAUTH_ENABLED=false
# ERP_OAUTH_TOKEN_TTL_SECONDS=900         # access-token TTL (default 15 min; clamped 60s–24h)
# ERP_OAUTH_SIGNING_SECRET=               # optional; defaults to SESSION_SECRET / MASTER_API_KEY
#
# K0+-b — ISA-95 / B2MML codec. When TRUE, /orders and /bom ALSO accept
# Content-Type: application/xml (B2MML ProductionSchedule / MaterialInformation) —
# decoded to the SAME upsert path (JSON path unchanged). The outbox can also emit
# a B2MML ProductionPerformance body when a producer requests format:"b2mml". When
# off, an XML POST is refused with 415 b2mml_disabled. Codec is a pragmatic ISA-95
# subset (hand-rolled, dependency-free) covering our order/BOM/performance fields.
ERP_B2MML_ENABLED=false
#
# K0+-a mTLS HONEST SEAM (transport-level). mTLS is NOT enforced by this app layer;
# it requires the Node https server (requestCert:true, rejectUnauthorized:true, ca)
# or a reverse proxy (nginx ssl_verify_client) to REQUEST + VERIFY a client cert.
# When REQUIRE_CLIENT_CERT is set, the /api/v1 mtlsGuard FAILS CLOSED unless the
# transport surfaced a verified client cert (req.socket.getPeerCertificate() or a
# trusted proxy header X-SSL-Client-Verify: SUCCESS). Default unset → no-op. This
# never fabricates mTLS — see server/api/v1/erpMtls.ts.
# REQUIRE_CLIENT_CERT=false

# ─── G1 FLEET ORCHESTRATION (doc 16 §7 Khối 2 / §15 G1) — default OFF ─────────
# Khối 2: Dynamic Task Allocation Engine (server/services/fleet/taskAllocator.ts)
# + Zone Traffic/Path manager (server/services/fleet/trafficManager.ts), over the
# tasks / zones / zone_reservations entities (migration 0142).
#
# When TRUE:
#   • the eventBus `order.created` handler DECOMPOSES a production order into
#     `tasks` (idempotent on taskKey) and runs an allocation pass;
#   • fleet.* mutating tRPC actions (createTask/allocate/assign/reserve/…) are
#     accepted; when OFF they return CONFLICT "fleet orchestration disabled".
#
# Allocator scores candidate devices by: capability match (capabilityModel) →
# distance (robot pose) → battery (mobile/AGV) → queue length → order priority.
# Rebalancing reassigns an offline/e-stopped robot's open tasks to a peer.
#
# SAFETY: this engine writes orchestration STATE ONLY. It opens NO device path —
# every actual robot/device command still routes through the EXISTING gated
# dispatchers (robotCommandDispatcher / commandDispatcher, dry-run unless
# ROBOT_CONTROL_ENABLED / OT_CONTROL_ENABLED). FOE_ENABLED stays the operator
# toggle for feeding tasks into a FOE workflow; G1 does NOT force it on.
FLEET_ORCH_ENABLED=false
# Allocator weight tunables (optional; sensible defaults shown):
# FLEET_W_DISTANCE=2            # score penalty per metre to the task start
# FLEET_W_QUEUE=50             # score penalty per task already queued on a device
# FLEET_W_BATTERY=1.5          # score bonus per % battery (mobile robots)
# FLEET_BATTERY_FLOOR_PCT=20   # mobile robot below this % is excluded from allocation

# ─── G2 FLEET RESOURCE / SKILL / CHARGING (doc 16 §7 c&d / §15 G2) — default OFF ─
# Completes Khối 2 on top of G1 (migration 0143):
#   • G2-a Operation→Skill→Program registry (operation_codes, operation_program_map)
#         — skillRegistry.resolveOperation(code) → { requiredCapability,
#           requiredSkillIds, qualifiedPrograms[] }; operators matched via
#           masterdata.userCertifications.
#   • G2-b A/B program variants (program_variants) — variantPicker.pickVariant()
#         chooses an arm by WEIGHTED traffic split, DETERMINISTIC on a seed.
#   • G2-c Shared resources (shared_resources, resource_reservations) —
#         resourceManager claim/queue/release, mirroring the zone reservation model.
#   • G2-d Predictive charging (charger_stations, battery_charging_plans) —
#         chargingPlanner schedules a preemptive charge when projected battery would
#         drop below the (reused) G1 battery floor before the task queue completes.
#
# When TRUE: the fleet.* G2 mutating tRPC actions (createOperation/mapOperationProgram/
#   createVariant/recordVariantOutcome/createResource/reserveResource/releaseResource/
#   createCharger/sweepCharging) are accepted; OFF → CONFLICT "fleet resource layer
#   disabled". The allocator's operation-aware refinement (taskAllocator.refineByOperation)
#   is OPT-IN and additive — with this flag OFF the G1 allocator is byte-for-byte unchanged.
#
# SAFETY: orchestration STATE only. NO device path — dispatch stays with the EXISTING
# gated dispatchers (robotCommandDispatcher / commandDispatcher, dry-run by default).
FLEET_RESOURCE_ENABLED=false
# Charging energy model tunables (optional; HEURISTIC — sensible defaults shown):
# FLEET_ENERGY_PER_TASK_PCT=8        # battery % consumed per queued task (flat model)
# FLEET_CHARGE_RATE_PCT_PER_MIN=1.5  # charge rate used to estimate plan duration
# FLEET_CHARGE_TARGET_PCT=90         # target charge level a plan aims for
# FLEET_CHARGING_SWEEP_MS=300000     # background predictive-charging sweep interval (min 60000)
# (FLEET_BATTERY_FLOOR_PCT above is REUSED as the projected-battery floor.)

# ─── T1 DIGITAL TWIN (doc 16 §11.2 Khối 7 / §15 T1) — default OFF ─────────────
# Khối 7 backend: Equipment 3D Model registry (equipment_3d_models, migration 0144)
# + hierarchical scene graph (factory→zone→station→device) + WebSocket live
# streaming gateway (telemetry bus tap → room twin:{factoryId}) + replay from
# TimescaleDB + occupancy grid with REAL A* path planning.
#
# When TRUE:
#   • the twin streaming gateway STARTS — it taps the unified telemetry bus and
#     pushes throttled per-device deltas (position/state) to twin:{factoryId};
#   • twin.* mutating tRPC actions (models.register/models.archive) are accepted;
#     when OFF they return CONFLICT "Digital twin live disabled".
#   • the occupancy grid build reports enabled:true (FLEET_ORCH_ENABLED also enables it).
# When OFF: nothing is tapped/emitted → the FE keeps its 5s poll fallback
# (digitalTwin.* queries), backward-compatible. Read paths (sceneGraph/replay/
# occupancyGrid/models.list/resolve) stay available regardless of the flag.
#
# HONESTY: CAD STEP/IGES/URDF → glTF conversion is NOT done in-process (needs
# external CAD/robotics tooling, OUT OF SCOPE for T1). The registry stores
# ALREADY-CONVERTED model URIs + a conversionStatus provenance field; the backend
# never fakes a converter.
#
# SAFETY: signal-only. NO device-control path; no device/DB write on the stream.
TWIN_LIVE_ENABLED=false
# Stream + replay tunables (optional; sensible defaults shown):
# TWIN_STREAM_MAX_HZ=10          # max device-delta flush rate per factory room (1..30)
# TWIN_REPLAY_MAX_FRAMES=5000    # hard cap on replay snapshot frames (auto-widens step)

# ─── VISION / INSPECTION ADAPTERS — vendor-agnostic ingest ──────────────────
# Registry mapping vendorKey → adapter that normalizes a third-party inspection
# system payload (Cognex / Keyence / Koh Young / TRI / Omron / generic JSON) into
# the canonical inspection shape, then persists via the existing submitInspection
# path (no proprietary ZIP required). Default OFF — when not "true",
# visionAdapter.ingest is a no-op (persists nothing); listAdapters stays read-only.
VISION_ADAPTERS_ENABLED=false

# ─── HOT-FOLDER INGESTION (doc 27 gap C1) — AOI/AVI file-drop ────────────────
# Real AOI/AVI machines (I.C.T / Saki / Mirtec / custom) export per-board result
# files (CSV/XML/JSON) into a local or SMB folder. When "true", the service
# watches every ENABLED hot_folder_configs row (chokidar; awaitWriteFinish for
# partial-write safety, EBUSY retry, content-hash dedup, archive/error folders +
# .reason.txt sidecars) and persists via the EXISTING machineApi.submitInspection
# path. Default OFF — no watcher, no fs access. Config CRUD + dryRun stay
# available regardless (prepare folders first, then flip the flag).
HOT_FOLDER_INGEST_ENABLED=false

# ─── DIGITAL TWIN STREAM (G2.7) — READ-ONLY VISUALIZATION ───────────────────
# Bật WebSocket streaming twin:update (WIP flow + station load) + broadcaster
# định kỳ (SELECT-only, KHÔNG ghi máy/DB nghiệp vụ). Mặc định FALSE → FE fallback
# poll digitalTwin.wipFlowState như cũ (backward-compatible). Chỉ là tín hiệu
# trực quan: emitTwinUpdate no-op khi flag off hoặc socket chưa init.
TWIN_STREAM_ENABLED=false

# ─── OT CONTROL (GHI LỆNH XUỐNG THIẾT BỊ THẬT) — F4b ─────────────────────────
# ⚠️ CẢNH BÁO AN TOÀN: bật OT_CONTROL_ENABLED=true CHO PHÉP commandDispatcher
# gọi driver.writeTags() → GHI LỆNH THẬT XUỐNG PLC/thiết bị (qua HITL confirm +
# RBAC + allowlist tag.writable). Mặc định FALSE = dry-run (chỉ ghi commandLog
# status='simulated', KHÔNG chạm thiết bị). CHỈ bật trên line pilot SAU nghiệm thu.
OT_CONTROL_ENABLED=false
# Timeout (ms) cho mỗi lần driver.writeTags() khi OT_CONTROL_ENABLED=true.
OT_CONTROL_TIMEOUT_MS=5000
# W0-D G1.7 (doc 44) — trần cho deadlineMs per-command (caller truyền deadlineMs sẽ
# bị cap bởi giá trị này; không đặt = deadline caller dùng nguyên).
# OT_CONTROL_TIMEOUT_MAX_MS=60000
# doc 48 R1 (T1) — SAFETY-PLC PREFLIGHT (spec invariant #1: "safety-PLC BLOCKED ⇒ TỪ
# CHỐI actuation"). TRƯỚC mỗi real-write, dispatch đọc SafetyState READ-ONLY (adapter
# facade → safety-PLC status adapter). BLOCKED/tripped → REJECT (SAFETY_BLOCKED) TRƯỚC
# khi ghi; driver.writeTags KHÔNG được gọi. Mặc định BẬT khi KHÔNG đặt (đặt "false" để
# tắt — an toàn nên bật). KHÔNG-PHÁ-VỠ: UNKNOWN (không có safety_plc_configs bật /
# SAFETY_PLC_ADAPTER_ENABLED tắt — trường hợp phổ biến) VẪN CHO QUA (chỉ warn). Chỉ áp
# lệnh HITL trên đường ghi thật (dry-run/simulated không đụng). Đọc được OK/BLOCKED thật
# cần SAFETY_PLC_ADAPTER_ENABLED=true + ≥1 safety_plc_configs (seed mig 0270_*).
# OT_SAFETY_PREFLIGHT_ENABLED=true

# ─── doc 44 W0 — CỜ MỚI (mặc định OFF, bật theo canary) ─────────────────────────
# G1.2 — IPC-CFX (IPC-2591) inbound telemetry client (AMQP 1.0, monitoring-only).
CFX_ENABLED=false
# CFX_ENDPOINTS: JSON [{host,port,address,machineCode?,username?,password?,transport?}]
# hoặc CSV "host|port|address|machineCode;..."
CFX_ENDPOINTS=
# G1.6 — publish cmd_ack (LDS-L1 §8.5) lên UNS sau mỗi dispatch terminal
# (fire-and-forget QoS1; lỗi publish KHÔNG ảnh hưởng dispatch).
UNS_CMD_ACK_ENABLED=false
# UNS_CMD_ACK_TOPIC_ROOT=syn   # topic: {root}/{UNS_ENTERPRISE_NAME}/cmd_ack/adapter/{adapterId}
# G2.5 — Contract Schema Registry: hydrate tu DB + seed contracts/canonical/*.json
# qua BACKWARD compat gate luc boot. OFF = registry in-memory nhu cu.
CONTRACT_REGISTRY_PERSIST_ENABLED=false
# G4.27 — mo POST /api/v1/models/:id/promote|rollback (OFF => 501).
V1_MODEL_MUTATIONS_ENABLED=false
# G4.9 — PdM lead-time gate: default trong code da doi 24 -> 168h (1 tuan);
# pin lai 24 neu muon hanh vi cu.
# PM_TIMEFRAME_HOURS=168

# ── doc 44 W0-I — An ninh nen (G5.7/G5.8, default OFF/report-only) ──────────────
# CSP: off | report-only | enforce. Khuyen nghi chay report-only mot thoi gian
# (xem POST /api/csp-report + metric avi_aoi_security_events_total) truoc enforce.
SEC_CSP_MODE=off
# Origin-check chong CSRF (lop 2 sau cookie sameSite=lax): off | log | enforce.
SEC_ORIGIN_CHECK_MODE=off
# CSV origin tin cay them (bo sung ALLOWED_ORIGINS san co), vd https://factory.local
SEC_ALLOWED_ORIGINS=
# Backup bundle secrets (.env + license keys + CA keystore + contracts/canonical):
# default OFF; bat = BAT BUOC dat BACKUP_ENCRYPTION_KEY (64-hex hoac passphrase),
# thieu key -> skip honest, KHONG bao gio plaintext.
BACKUP_INCLUDE_SECRETS=false
BACKUP_ENCRYPTION_KEY=
# BACKUP_CONFIG_BUNDLE_RETENTION=30

# ── doc 44 W2-A — UNS topic v2 + Asset Registry + OT contract (default OFF) ────
# G2.1+G1.5 — dual-publish cây UNS v2 chuẩn syn/{site}/{area}/{line}/{cell}/{equipment}/{aspect}
# (cần UNS_BRIDGE_ENABLED + broker; cây cũ + Sparkplug giữ nguyên).
UNS_TOPIC_V2_ENABLED=false
# UNS_TOPIC_V2_ROOT=syn
# UNS_TOPIC_V2_CACHE_TTL_MS=300000
# UNS_TOPIC_V2_HEALTH_INTERVAL_MS=60000
# G2.3 — node tổng hợp _line/_area/_site (OEE tạm/throughput/NG-rate, retained)
UNS_AGGREGATES_ENABLED=false
# UNS_AGGREGATES_INTERVAL_MS=60000
# UNS_AGGREGATES_WINDOW_MS=3600000
# G1.11 — config-drift sweep (so hash cấu hình adapter+tags vs bản đã duyệt)
CONFIG_DRIFT_ENABLED=false
# CONFIG_DRIFT_INTERVAL_MS=600000
# G1.4 — report-by-exception per tag (mig 0253: device_tags.deadband/sampling_ms)
OT_TAG_DEADBAND_ENABLED=false
# DEADBAND_HEARTBEAT_MS=60000
# G1.9 — tuần tự hóa lệnh per-adapter (BUSY khi tràn hàng đợi, spec §13.3)
OT_CMD_SERIALIZE_ENABLED=false
# OT_CMD_QUEUE_MAX=10

# ── doc 44 W2-B — Data APIs + state store + governance (default OFF) ───────────
# G2.12 — state store path-addressable (OFF: REST /v1/state vẫn chạy db-fallback honest)
STATE_STORE_ENABLED=false
# STATE_STORE_TTL_MS=900000
# STATE_STORE_MAX_ENTRIES=5000
# G2.17 — WS uns:subscribe snapshot-then-stream (OFF = no-op)
WS_UNS_STREAM_ENABLED=false
# WS_UNS_MAX_DELTAS_PER_SEC=50
# WS_UNS_COALESCE_FLUSH_MS=250
# WS_UNS_HEARTBEAT_MS=30000
# G2.6 — cưỡng chế schema canonical tại ingest: off | log | quarantine
CONTRACT_VALIDATE_INGEST_MODE=off
# CONTRACT_QUARANTINE_RETENTION_DAYS=30

# ── doc 44 W3-A — Tầng Điều phối: Policy · Line Controller · Order (default OFF) ─
# G3.13 — DB policy store + sync Git→DB lúc boot (contracts/policies/*.policy.yaml)
POLICY_STORE_ENABLED=false
# G3.11 — default-deny theo nhóm action (CSV glob, vd: ot.command.*,robot.*,deploy.*
# — RỖNG = default-allow như cũ, chuyển tiếp an toàn)
POLICY_DEFAULT_DENY_ACTIONS=
# true = ghi decision-log MỌI PERMIT (mặc định chỉ PERMIT trong nhóm deny + mọi DENY)
POLICY_AUDIT_PERMIT_ALL=false
# G3.1 — Line Controller sweep quan sát nhịp/fault (FSM + API vẫn dùng được khi OFF)
LINE_CONTROLLER_ENABLED=false
# LINE_CONTROLLER_SWEEP_MS=30000
# LINE_CONTROLLER_STALL_MS=120000
# LINE_CONTROLLER_ALERT_COOLDOWN_MS=600000
# LINE_READINESS_CACHE_MS=30000
# G3.6/G3.7 — Order lifecycle (cần mig 0258; OFF = hành vi cũ, an toàn DB chưa migrate)
ORDER_LIFECYCLE_ENABLED=false

# ── doc 44 W3-B — RecipeSet · autohold · QT templates · cấp liệu (default OFF) ──
# G3.2 — autohold/auto-resume khi blocking kéo dài (2 cổng policy; OFF = observe+warn)
LINE_CONTROLLER_AUTOHOLD_ENABLED=false
# LINE_CONTROLLER_AUTORESUME_CLEAR_SWEEPS=3
# G3.8 — đăng ký 4 template QT-1..4 vào kho FOE (cần FOE_ENABLED)
QT_TEMPLATES_ENABLED=false
# G3.9 — watcher cấp liệu QT-3 (BOM reorder + Andon material → transport task idempotent)
MATERIAL_REPLENISH_ENABLED=false
# MATERIAL_REPLENISH_SWEEP_MS=60000
# MATERIAL_REPLENISH_ALERT_COOLDOWN_MS=600000
# G3.10 — fleet decomposition đa bước pick→transport→dock (cần FLEET_ORCH_ENABLED)
FLEET_MULTISTEP_DECOMP_ENABLED=false
# FLEET_MULTISTEP_PROMOTE_MS=30000
# G3.14 — gợi ý khi bật default-deny: thêm nhóm robot.command.*,foe.command.*,fleet.vda5050.*
# vào POLICY_DEFAULT_DENY_ACTIONS (policy mẫu allow đã có trong contracts/policies/)
# doc 48 R1 (T3) — nhóm ot.command.*,line.command.*,order.command.* GIỜ đã có allow-policy
# tường minh (allow-ot-command-engineer-fat / allow-line-command-fsm /
# allow-order-command-lifecycle) → thêm vào POLICY_DEFAULT_DENY_ACTIONS sẽ gate OT write +
# Line Controller FSM + order lifecycle mà KHÔNG vỡ transition hợp lệ.

# ── doc 44 W5-A1 — Twin fidelity loop (G4.1, default OFF) ──────────────────────
# So DES-du-doan vs line_balance-thuc → tu vo hieu twin khi lech >= N lan lien tiep.
# Twin untrusted = optimizer/advisor chi tham khao, KHONG dung cho quyet dinh tu dong.
TWIN_FIDELITY_ENABLED=false
# TWIN_FIDELITY_INTERVAL_MS=3600000     # chu ky sweep (san 5 phut)
# TWIN_FIDELITY_THRESHOLD_PCT=0.1       # nguong lech (fraction, 0.1 = 10%)
# TWIN_FIDELITY_BREACH_LIMIT=2          # so lan lech lien tiep truoc khi untrust

# ── doc 44 W5-A2 — Guardrail tham so per-param + closed-loop verify (default OFF) ─
# G4.18 — enforce dai min-max do ky su nhap tai set_machine_param (vi pham = REJECT
# honest, KHONG clamp im lang). OFF = hanh vi cu byte-for-byte.
PARAM_GUARDRAIL_ENABLED=false
# param KHONG co guardrail: OFF = cho qua + log; ON = reject NO_GUARDRAIL (chuan 95 diem)
PARAM_GUARDRAIL_STRICT=false
# G4.20 — closed-loop: sau thay doi X gio, so Cpk/FPY/NG truoc-sau -> degraded -> Andon
PARAM_VERIFY_ENABLED=false
# PARAM_VERIFY_DELAY_MS=14400000        # 4h cho tich luy du lieu truoc khi cham diem
# PARAM_VERIFY_INTERVAL_MS=3600000
# PARAM_VERIFY_EPSILON_PCT=0.5

# ── doc 44 W5-A3 — Hop dong Recommendation (guardrail + requires[], default OFF) ─
# G4.29 — cuong che requires[] tai confirm (policy_permit -> evaluatePolicy;
# twin_validation -> isTwinTrusted; guardrail double-check). OFF = flow cu nguyen ven.
ADVICE_CONTRACT_ENABLED=false
# twin_validation khong suy duoc twin ref: true = chan (fail-closed), false = bo qua
ADVICE_REQUIRES_STRICT=false

# ── doc 44 W5-A4 — Feature store + MLOps stage pipeline (default OFF) ───────────
# G4.23 — kich hoat ml_feature_cache (train/serve cung dinh nghia). OFF = duong cu.
FEATURE_STORE_ENABLED=false
# INFERENCE_AUDIT_SAMPLE_RATE=0         # ti le [0..1] ghi ml_inference_audit (bounded)
# G4.24/25 — stage staging|shadow|canary|production|retired + cong 2-nguoi/N-ngay
MODEL_STAGE_PIPELINE_ENABLED=false
# MODEL_SHADOW_MIN_HOURS=72
# MODEL_SHADOW_MIN_INFERENCES=100
# G4.28 — nguong p-value flag concept-drift (KS-test)
# AI_DRIFT_KS_PVALUE=0.01
# PDM_FEATURE_WINDOW_HOURS=72

# ── doc 44 W5-B1 — Vision: NTF classifier + class-imbalance + cost-sensitive (OFF) ─
# G4.12 — serve NTF/false-call classifier DA HUAN LUYEN (thay heuristic khi thang gate)
NTF_CLASSIFIER_ENABLED=false
# G4.14 — xu ly mat can bang lop tren logistic head (embedding + NTF)
HEAD_CLASS_BALANCE_ENABLED=false
# HEAD_FOCAL_GAMMA=0
# G4.15 — nguong quyet dinh cost-sensitive (fn>>fp = recall-first cho loi nang)
COST_SENSITIVE_THRESHOLD_ENABLED=false
# COST_FN=10  COST_FP=1  COST_REVIEW=2

# ── doc 44 W5-B2 — Vision: OCR engine + RCA dinh luong + SLO vision (OFF) ───────
# G4.13 — OCR engine ONNX (RapidOCR/PaddleOCR) confidence THAT tu rec-score;
# thieu model .onnx -> degrade honest OCR_MODEL_NOT_AVAILABLE. Owner tai model:
# models/ocr/rec.onnx + ppocr_keys.txt (RapidOCR ONNX — github.com/RapidAI/RapidOCR)
OCR_ENGINE_ENABLED=false
# OCR_VLM_FALLBACK=false
# OCR_MODEL_DIR=models/ocr
# G4.17 — RCA tuong quan dinh luong (Pearson/logistic tham so cong doan truoc <-> NG)
RCA_QUANTITATIVE_ENABLED=false
# G4.16 — do + canh bao SLO vision-inference-p95 (path ONNX, loai VLM)
VISION_SLO_OBSERVE_ENABLED=false
# VISION_SLO_P95_MS=200

# ── doc 44 W5-B3 — PdM: RUL Weibull + failure-mode (OFF) ───────────────────────
# G4.7 — RUL Weibull survival (fallback heuristic khi < RUL_MIN_OBSERVATIONS hong that)
RUL_WEIBULL_ENABLED=false
# RUL_MIN_OBSERVATIONS=5
# RUL_LOOKBACK_DAYS=365
# G4.8 — phan loai che-do-hong tu FFT/RMS/kurtosis (san sang nhan cam bien rung;
# thieu tag rung -> honest unknown, KHONG doan bua)
FAILURE_MODE_ENABLED=false

# ── doc 44 W0-H — Ha tang tuy chon theo profile (kien truc gap duoc) ───────────
# EMQX HA 3-node (deploy/compose/docker-compose.uns-ha.yml): secret cluster —
# openssl rand -hex 32, GIONG NHAU ca 3 node. Chi can khi dung UNS-HA.
EMQX_CLUSTER_COOKIE=
# PG read-replica cho getReadDb() (bo trong = doc tren primary, honest-degrade).
DATABASE_READ_URL=
# DB_POOL_MAX_READ=15
# NATS JetStream (docker compose --profile bus up -d nats) — client server dung o W4.
# NATS_URL=nats://localhost:4222

# ─── VISION → CONTROL (KHÉP VÒNG CHẤT LƯỢNG: NG/anomaly ⇒ ĐỀ XUẤT lệnh) — AOI-F ─
# ⚠️ ADVISORY BY DEFAULT. Bật VISION_CONTROL_ENABLED=true CHO PHÉP AI quality gate,
# khi ra verdict NG cứng (AUTO_NG) hoặc anomaly đã xác nhận, DRAFT một đề xuất điều
# khiển có kiểu (reject_divert / spi_printer_offset) và ĐẨY vào hộp thư người phụ
# trách dưới dạng ai_pending_actions (HITL). Đây CHỈ là ĐỀ XUẤT — KHÔNG tự thực thi,
# KHÔNG chạm driver. Mặc định FALSE = hành vi cũ (gate chỉ ghi kết quả + cảnh báo).
#
# THỨ TỰ ƯU TIÊN (compose với command dispatcher — KHÔNG cờ nào nới lỏng cờ khác):
#   (1) VISION_CONTROL_ENABLED  → có được TẠO đề xuất hay không? (cửa vào của AOI-F)
#   (2) người dùng CONFIRM đề xuất (HITL) → mới chạy execute → dispatch(kind='hitl')
#   (3) OT_CONTROL_ENABLED       → lệnh đã confirm mới được tới driver (nếu false → simulated)
#   (4) OT_COMMISSIONING_REQUIRED (C2) → adapter CHƯA nghiệm thu ⇒ simulated BẤT KỂ (3)
# ⇒ Đề xuất trên một adapter chưa nghiệm thu LUÔN dừng ở 'simulated' end-to-end.
# CHỈ bật trên line pilot SAU nghiệm thu, cùng với OT_CONTROL_ENABLED + commissioning.
VISION_CONTROL_ENABLED=false
# Số đề xuất tối đa mỗi lần verdict (chống spam inbox). Mặc định 5.
# VISION_CONTROL_MAX_PER_RUN=5

# ─── FACTORY ORCHESTRATION ENGINE (FOE) — Phase E2 ──────────────────────────
# Bật engine điều phối quy trình đa-máy (ISA-88-style workflow runtime): tuần tự/
# song song/branch/wait/interlock/HITL-gate/compensation. Mặc định FALSE = engine
# tắt (deployWorkflow/startRun trả về disabled). AN TOÀN: mọi lệnh điều khiển vẫn đi
# qua equipmentRegistry.sendCommand → commandDispatcher/robotCommandDispatcher (HITL
# + dry-run gate OT_CONTROL_ENABLED). Khi OT_CONTROL_ENABLED=false, CẢ workflow chạy
# ở chế độ SIMULATION (không chạm thiết bị) — lý tưởng để kiểm thử. FOE KHÔNG mở
# đường điều khiển trực tiếp nào.
FOE_ENABLED=false

# ─── AI-ASSISTED ORCHESTRATION ADVISOR — Phase E5 ───────────────────────────
# When ON, the deep local model can PROPOSE/OPTIMIZE a multi-machine WorkflowDefinition
# (GBNF/JSON-schema-constrained → validated by validateWorkflow → simulated on the twin).
# HITL ABSOLUTE: the AI ONLY proposes — the human reviews it in the Studio and deploys/runs
# it SEPARATELY via the orchestration router (own RBAC + HITL/dry-run). The advisor opens
# NO device path and NEVER calls deployWorkflow/startRun. Default OFF → suggest/optimize are
# honest disabled no-ops (available:false). Requires a loaded GGUF deep model to actually run.
# AI_ORCHESTRATION_ADVISOR_ENABLED=false

# ─── EDGE CONTROL RUNTIME — Phase E4 ────────────────────────────────────────
# Bật khung EDGE CONTROL RUNTIME: chạy workflow FOE gần máy (edge host) với khả năng
# CHỊU LỖI KHI MẤT MẠNG (đệm lệnh/kết quả + đồng bộ idempotent khi nối lại) + điều phối
# trung tâm (registry node + giao run cho node + reconcile kết quả). Mặc định FALSE =
# tắt: coordinator/runtime trả về `disabled`, heartbeat-checker KHÔNG khởi động.
# ⚠️ TRUNG THỰC: đây là COORDINATION + ĐỆM OFFLINE + WRAPPER thực thi (TÁI DÙNG FOE
# engine) — KHÔNG phải hard real-time. Determinism/RT dưới mili-giây cần một edge host
# CHUYÊN DỤNG (RTOS / agent C/Rust). AN TOÀN (E-stop/interlock/motion) LUÔN ở PLC L1.
# Mọi lệnh edge phát ra vẫn qua equipmentRegistry → HITL/dry-run dispatcher.
EDGE_RUNTIME_ENABLED=false
# Mã định danh của edge node này (khi runtime chạy trên một edge host). Mặc định "edge-local".
# EDGE_NODE_CODE=edge-line-1
# Đường dẫn file đệm offline (JSONL) để replay sau khi khởi động lại. Bỏ trống = chỉ in-memory.
# EDGE_BUFFER_FILE=./data/edge-buffer.jsonl
# Chu kỳ heartbeat của edge node (ms) và chu kỳ/ngưỡng health-checker phía trung tâm.
# EDGE_HEARTBEAT_INTERVAL_MS=30000
# EDGE_NODE_HEALTH_INTERVAL_MS=30000
# EDGE_NODE_STALE_THRESHOLD_MIN=2

# ─── INTERLOCK AUTO-BLOCK (RULE TỰ GHI LỆNH CHẶN/DỪNG XUỐNG MÁY) — F5b ───────
# ⚠️ CẢNH BÁO AN TOÀN TỐI CAO: bật INTERLOCK_AUTO_BLOCK_ENABLED=true CHO PHÉP một
# interlock rule TẤT ĐỊNH (người soạn + đã DUYỆT) TỰ ĐỘNG ghi lệnh
# block_downstream/stop_line/reduce_speed xuống máy qua commandDispatcher — KHÔNG
# cần thao tác người tại thời điểm fire. AI KHÔNG bao giờ có code path tới đường này.
# Để auto-block thực sự ghi xuống thiết bị cần ĐỦ 6 lớp rào:
#   (1) INTERLOCK_ENGINE_ENABLED=true   (engine chạy)
#   (2) INTERLOCK_AUTO_BLOCK_ENABLED=true  (cờ này)
#   (3) OT_CONTROL_ENABLED=true          (đường ghi thật, nếu false → simulated)
#   (4) rule.enabled=true + approvedBy đã đặt + requiresHumanConfirm=false
#   (5) approvedBy khớp + action thuộc allowlist + targetAdapterId/commandTag khớp
#   (6) tag.writable=true (allowlist)
# Mặc định FALSE. CHỈ bật trên LINE PILOT SAU nghiệm thu đầy đủ.
INTERLOCK_AUTO_BLOCK_ENABLED=false
# Bật vòng quét engine interlock (alert + — khi đủ cờ — auto-block). Mặc định off.
INTERLOCK_ENGINE_ENABLED=false

# ─── ROBOTICS (Phase 3) — robot gateway + motion control gate ────────────────
# Bật robotManager: nạp robot enabled từ DB, connect driver theo vendor, poll
# state → robot_telemetry. KHÔNG ghi lệnh máy ở nhánh này. Mặc định FALSE.
ROBOT_GATEWAY_ENABLED=false
# ⚠️ CẢNH BÁO AN TOÀN: bật ROBOT_CONTROL_ENABLED=true CHO PHÉP robotCommandDispatcher
# gọi driver.runJob() → GHI LỆNH CHUYỂN ĐỘNG THẬT xuống robot (qua HITL confirm).
# Với Techman (TM): runJob mở socket TM "Listen Node" và gửi chuỗi TMSCT. Mặc định
# FALSE = dry-run (chỉ ghi robot_jobs status='simulated' + lưu TMSCT dự định, KHÔNG
# mở socket / KHÔNG chạm robot). CHỈ bật trên cell pilot SAU khi đã NGHIỆM THU
# register-map Modbus + cú pháp TMSCT/Listen-Node trên TM thật (xem techmanDriver.ts).
ROBOT_CONTROL_ENABLED=false
# Timeout (ms) cho mỗi driver.runJob() khi ROBOT_CONTROL_ENABLED=true.
ROBOT_CONTROL_TIMEOUT_MS=10000

# ─── VDA 5050 (AGV/AMR fleet connectivity, MQTT) ─────────────────────────────
# Bật adapter manager VDA 5050: nạp robot kind='agv' enabled (connectionOptions
# chứa manufacturer + serialNumber, endpoint = broker URL), subscribe topic
# state/connection của AGV → robot_telemetry + online/offline. CHỈ ĐỌC ở nhánh này.
# Mặc định FALSE. (Import service cũng đăng ký driver "vda5050" vào robot registry.)
VDA5050_ENABLED=false
# ⚠️ AN TOÀN: lệnh AGV (Order/InstantActions) LUÔN đi qua robotCommandDispatcher →
# HITL + DRY-RUN trừ khi ROBOT_CONTROL_ENABLED=true (dùng CHUNG cờ với robotics).
# DRY-RUN = build Order JSON nhưng KHÔNG publish gì lên MQTT. CHỈ bật điều khiển
# thật SAU khi đã NGHIỆM THU mapping topic/field VDA 5050 vs AGV/fleet thật.

# ─── Phase E1 — Unified Machine API (/api/v1) — outbound WEBHOOKS ─────────────
# Khi BẬT (true/1): các sự kiện nội bộ (inspection.committed, andon.raised,
# equipment.command.executed, spc.violation, ng.alert) được FAN-OUT (POST, HMAC-
# signed, retry, fail-safe) tới các subscriber trong bảng webhook_configs.
# Mặc định FALSE → KHÔNG có HTTP outbound nào rời máy chủ (an toàn). Việc đăng ký
# webhook (webhookRouter) vẫn hoạt động; chỉ riêng việc GỬI bị cờ này khoá.
WEBHOOKS_ENABLED=false

# ─── U1 (doc 21 §6) — UNIFIED EVENT BACKBONE ────────────────────────────────
# Master gate for the U1 OUTBOUND ecosystem-event bridge. When ON, the orphaned
# (safety.event, quality_gate.breach) + new domain events (anomaly.detected,
# workorder.created, task.assigned/completed/failed, program.deployed) are fanned
# out to external webhooks (`ecosystem.<kind>`, still ALSO gated by WEBHOOKS_ENABLED)
# and ingested into the local KB for significant classes (still ALSO gated by
# RAG_AUTO_INGEST_ENABLED). Default FALSE → no HTTP leaves the box and nothing is
# written; the IN-PROCESS bus publishing + the client `ecosystem:event`/`alerts:stream`
# re-broadcast are ALWAYS on and harmless (signal-only, no device/control path).
ECOSYSTEM_EVENTS_ENABLED=false

# ─── MES BOM / FEEDER / COMPONENT GENEALOGY — G2.4 ──────────────────────────
# Cờ này CHỈ gate phần SIDE-EFFECT đụng tồn kho: khi feeder xuống dưới mức đặt lại
# (reorder), recordComponentInstallation sẽ raiseAndon('material', vàng, signal-only).
# CRUD master (BOM/line item/feeder) + ghi nhận lắp + trừ tồn + genealogy luôn bật
# bất kể cờ. KHÔNG có đường ghi lệnh máy ở bất kỳ nhánh nào. Mặc định FALSE.
MES_BOM_ENABLED=false

# ─── APS CONSTRAINT SOLVER — G2.5a (CP-SAT, DRAFT-only) ─────────────────────
# OR-Tools CP-SAT sidecar sinh schedule DRAFT (đề xuất). Apply vẫn qua HITL
# (applyScheduleRun). KHÔNG ghi máy/lệnh. Mọi lỗi (ortools thiếu/timeout/infeasible)
# → fallback heuristic schedulePriority (solverMode=fallback_heuristic).
# Mặc định OFF — bật bằng "true".
APS_SOLVER_ENABLED=false
# Override lệnh Python (mặc định: .venv python + scripts/aps_solver.py). Script
# path tự nối vào cuối. Bỏ trống để dùng mặc định.
APS_SOLVER_CMD=
# Hard timeout spawn (ms) → SIGKILL rồi fallback.
APS_SOLVER_TIMEOUT_MS=30000
# Ngân sách thời gian CP-SAT (giây) trong tiến trình Python.
APS_SOLVER_MAX_TIME_SEC=20
# Trọng số mục tiêu: W_LATE*tardiness + W_MAKESPAN*makespan + W_SETUP*setup.
APS_W_LATENESS=4
APS_W_MAKESPAN=1
APS_W_SETUP=1
# Changeover mặc định (phút) khi không có machine_capacity.changeoverDefaultMin.
APS_DEFAULT_SETUP_MIN=15
# Trần số đơn nạp vào solver (chống mô hình quá lớn).
APS_MAX_JOBS=200

# --- Energy advanced analytics (Sprint G2.6a) ---
# Per-recipe energy + peak demand + power factor + forecast là READ-ONLY analytics
# trên energy_readings/process_results — KHÔNG cần feature flag để bật.
# recordReading ghi DỮ LIỆU telemetry (energy_readings), KHÔNG phải lệnh máy.
# Đường time-series tái dùng TSDB_URL hiện có: khi TSDB_URL được set, recordReading
# mirror sang hypertable TimescaleDB và peak/forecast dùng time_bucket; khi trống →
# mọi truy vấn chạy trên main PG (window AVG). Không có biến môi trường riêng cho energy.
# Lưu ý migration: drizzle/0117 (main PG, tự động qua migrate-standalone) +
# drizzle/timescale/0002 (apply RIÊNG cho container TimescaleDB).

# --- B4.3 Automated Executive Reports (AI exec summary, shift/day/week) ---
# Additive + flag-gated, DEFAULT OFF. When enabled, a cron job generates an AI
# executive summary from REAL KPIs (deep model via Model Router task:"report"),
# persists it into ai_insights (source='exec_report'), retrievable via the
# executiveReport tRPC router. Safe no-op when EXEC_REPORT_ENABLED is not true.
# EXEC_REPORT_ENABLED=false
# EXEC_REPORT_SCHEDULE=shift,day,week        # which periods to run
# EXEC_REPORT_LANG=vi                        # vi | en (output language)
# EXEC_REPORT_TZ=Asia/Ho_Chi_Minh
# EXEC_REPORT_SHIFT_HOURS=8                  # shift window length (hours)
# EXEC_REPORT_PDM_MAX_MACHINES=20            # cap machines scored for PdM risk
# Cron overrides (node-cron, 6-field). Defaults: shift every 8h, day 06:00, week Mon 07:00.
# EXEC_REPORT_SHIFT_CRON=0 0 6,14,22 * * *
# EXEC_REPORT_DAY_CRON=0 5 6 * * *
# EXEC_REPORT_WEEK_CRON=0 15 7 * * 1
# PUSH the finished report to managers so they don't have to pull. Additive, fail-safe
# (push failures never break report generation). DEFAULT OFF in example.
# EXEC_REPORT_NOTIFY_ENABLED=false           # in-app notification (+ optional email) to managers
# EXEC_REPORT_NOTIFY_ROLES=admin,supervisor  # roles to notify (csv); resolved vs active users
# EXEC_REPORT_NOTIFY_USER_IDS=               # extra explicit user ids (csv), merged + deduped
# EXEC_REPORT_EMAIL_ENABLED=false            # also email the report (needs SMTP_* configured)

# --- B5 MLOps closed-loop + governance (additive, DEFAULT OFF) ---
# Closed loop: feedback → aiDatasetBuilder → aiTrainingPipeline → aiEvalHarness
# (quality gate) → A/B canary (aiABTesting) → activate. The self-learning cron
# (aiSelfLearningScheduler) is a SAFE NO-OP unless AI_SELF_LEARNING_ENABLED=true.
#
# B5.1 Self-learning cron (uncertainty sweep + optional retrain FLAGGING only):
# AI_SELF_LEARNING_ENABLED=false      # master switch; cron stays a no-op when off
# AI_SELF_LEARNING_CRON=0 3 * * *     # 03:00 daily (node-cron)
# AI_SELF_LEARNING_TZ=Asia/Ho_Chi_Minh
# AI_SELF_LEARNING_UNCERTAINTY=0.5    # min normalized entropy to enqueue for labeling
# AI_SELF_LEARNING_SINCE_HOURS=24
# AI_SELF_LEARNING_MAX_ITEMS=200
# AI_SELF_LEARNING_AUTORETRAIN=false  # only FLAGS retrain candidates; never trains
#
# B5.2 PROMOTION GATE — automated retrain must NEVER swap the production model
# silently. An automated (autoContext) retrain activates a new version ONLY when
# the eval quality gate PASSES *and* this flag is explicitly on; otherwise the
# version is created as READY for human/canary promotion. Human-initiated
# pipelines (tRPC startPipeline) are unaffected (gate PASS = the explicit human go).
# AI_AUTO_PROMOTE_ENABLED=false
#
# B5.2 Drift monitor — confidence-distribution drift (PSI + mean/std shift) on
# recent vs baseline inference windows; advisory-only (writes a model_drift_alerts
# CONFIDENCE_SHIFT row, never retrains/swaps). Self-gating no-op when off.
# AI_DRIFT_MONITOR_ENABLED=false
# AI_DRIFT_PSI_THRESHOLD=0.25         # significant-drift cutoff (PSI)
# AI_DRIFT_MEAN_THRESHOLD=0.15        # mean-confidence shift cutoff
# AI_DRIFT_BASELINE_HOURS=168         # baseline window (7d)
# AI_DRIFT_RECENT_HOURS=24            # recent window (1d)
# AI_DRIFT_MIN_SAMPLES=50             # min rows per window before judging
#
# B5.3 Calibration (ECE/temperature) — no flag; run on demand via aiCalibration
# (collectCalibrationSamples → computeECE / fitTemperature).
# B5.4 Model cards — no flag; list/seed via aiEval tRPC (modelCards / seedPortfolioCards).

# ============================================================================
# S1 SAFETY / WORKFORCE (doc 16 Khối 3 / §15 S1) — the SOFTWARE-ONLY slice
# ============================================================================
#
# ⚠ CRITICAL HONESTY / SAFETY: NOTHING in S1 is safety-rated. The safety_events
# table + near-miss advisor + Andon→robot loop are ADVISORY monitoring / logging /
# orchestration ONLY. The software does NOT perform a SIL 2/3 stop and gives NO
# sub-second guarantee. A real hardware-rated protective stop (Safety PLC / UWB /
# LiDAR / vision-on-edge) is DEFERRED to S2. Every S1 write is STATE/log only — it
# opens NO device-control path; actual robot/device commands still route through the
# EXISTING gated dispatchers (robotCommandDispatcher / commandDispatcher, dry-run).
#
# WORKFORCE_ENABLED — mixed-workforce assignments + human↔robot handover handshake.
#   When ON: safety.assignOperator/reassign/confirm/close + collaboration.* mutate.
#   When OFF: those services are no-ops (enabled:false); the current-board READ still
#   works (it just shows robots + any pre-existing assignments). Conflict detection
#   rejects double-booking an operator across overlapping windows; a missing
#   certification is WARNED (not blocked).
WORKFORCE_ENABLED=false
#
# SAFETY_AUDIT_ENABLED — advisory safety-event audit + near-miss CV advisory.
#   When ON: safety_events are recorded by (a) the robotIngest e-stop TRANSITION hook
#   (detectedBy=telemetry, outcome=logged_only — the software only LOGGED it), (b) the
#   interlock engine stop/reduce hook (detectedBy=interlock), (c) the near-miss advisor
#   (safety.ingestProximity). The near-miss advisor, below NEAR_MISS_MARGIN_MM, records
#   a near_miss + raises a YELLOW Andon + PROPOSES a speed reduction via the EXISTING
#   gate — it NEVER auto-executes a command. When OFF: all hooks + ingest are no-ops;
#   the feed/trend READS still work (reading an advisory log is safe).
SAFETY_AUDIT_ENABLED=false
# Near-miss advisor tunables (optional; sensible defaults shown):
# NEAR_MISS_MARGIN_MM=500             # distance (mm) below which a detection is a near-miss
# NEAR_MISS_MIN_CONFIDENCE=0.5        # min detection confidence (0..1) to act on
#
# ANDON_ROBOT_DISPATCH_ENABLED — close the Andon→robot loop: a 'call'/help Andon for a
#   reason in {maintenance, material, other} creates a fleet ASSIST task so the EXISTING
#   taskAllocator picks an idle capable robot. Requires FLEET_ORCH_ENABLED (the fleet
#   layer) to actually allocate. When OFF (or fleet off): a complete no-op — the existing
#   Andon behaviour is UNCHANGED. Opens NO control path (creates an orchestration task
#   only; dispatch stays with the gated robot/command dispatchers).
ANDON_ROBOT_DISPATCH_ENABLED=false

# ============================================================================
# S2a SAFETY ZONE (software advisory) — Dynamic Safety Zoning (doc 20 §2/§5 / doc 16 §8)
# ============================================================================
#
# ⚠ CRITICAL HONESTY / SAFETY: SAFETY_ZONE_SW_ENABLED is ADVISORY, NOT SIL. It adds a
# model of dynamic safety zones with THREE graduated reaction thresholds
# (speedReduce ≥ stop ≥ ratedStop, mm) + a PURE intrusion evaluator that, given human
# + robot positions, computes the required reaction LEVEL
# (none | speed_reduce | stop | rated_stop). The software DETECTS all three levels and
# LOGS/PROPOSES — it does NOT perform a safety-rated stop and gives NO sub-second
# guarantee. A 'rated_stop' finding is LOGGED as an advisory safety_event with an
# explicit note that a CERTIFIED Safety PLC (SIL 2/3 + UWB/LiDAR, <100ms dual-channel)
# must perform the ACTUAL rated stop — that is S2 HARDWARE, deferred. 'speed_reduce' /
# 'stop' are only ever PROPOSED through the EXISTING gated dispatcher
# (INTERLOCK_AUTO_BLOCK_ENABLED + OT_CONTROL_ENABLED + HITL), exactly as S1 — this
# subsystem opens NO new device-control path. Human positions are SIMULATED until real
# UWB/LiDAR/vision (S2b).
#
# When ON: safety.listZones/evaluateZones/zoneStatus reads + createZone/updateZone/
#   ingestSimulatedHuman mutations are allowed; safety.ingestProximity ALSO drives the
#   zone evaluator (additive; S1 near-miss behaviour unchanged). Advisory events only
#   PERSIST when SAFETY_AUDIT_ENABLED is also on (the evaluator still returns reactions
#   with audit off — advisory read).
# When OFF (default): all zone reads/mutations are no-ops (enabled:false) and
#   ingestProximity returns zone:null — S1 behaviour is completely unchanged.
SAFETY_ZONE_SW_ENABLED=false

# ============================================================================
# S2b VISION + SAFETY-PLC (software advisory) — doc 20 §2/§5 / doc 16 §8
# ============================================================================
#
# ⚠ CRITICAL HONESTY / SAFETY: BOTH flags are ADVISORY, NOT SIL. They feed the S2a
# evaluator; they open NO new device-control path and NEVER perform a safety-rated stop.
#
# SAFETY_VISION_ENABLED — vision human-detection PRODUCER. Turns PERSON DETECTIONS
#   (pixel bounding boxes) + a per-camera pixel→floor HOMOGRAPHY into FLOOR positions,
#   then drives the S2a evaluator (advisory 3-level reaction). Detections come from a
#   pluggable backend: (a) INJECTED (caller/test/external detector — the value delivered
#   now), (b) an optional ONNX hook, (c) NO-BACKEND (default) that produces NOTHING.
#   ⚠ MODEL-EXPORT SEAM: onnxruntime-node is present, but yolo26n.pt is a PyTorch
#   checkpoint — onnxruntime cannot load .pt. A ONE-TIME export is required
#   (`yolo export model=yolo26n.pt format=onnx opset=13 imgsz=640`) + register the .onnx
#   as an ACTIVE ai_model with a 'person' label before the ONNX hook returns anything.
#   Until then the producer NEVER fabricates a person. Advisory events PERSIST only when
#   SAFETY_AUDIT_ENABLED is also on (reactions still returned with audit off).
#   When ON: safety.listCameraCalibrations/visionStatus reads +
#     upsertCameraCalibration/ingestDetectionFrame mutations are allowed.
#   When OFF (default): all vision reads/mutations are no-ops (enabled:false).
SAFETY_VISION_ENABLED=false
#
# SAFETY_PLC_ADAPTER_ENABLED — READ-ONLY safety-PLC status adapter (Pilz PNOZmulti/PSS,
#   Sick Flexi Soft). These certified controllers expose NON-safety-rated STATUS
#   (e-stop / zone-occupied / reset-required / muting) over Modbus-TCP / OPC-UA. The
#   adapter OBSERVES that status and maps it to ADVISORY safety_events (detectedBy
#   'plc' for a real read / 'sim' for the sim backend; source also noted in the notes).
#   Backends: 'sim' (default — a clearly-labelled
#   scripted status stream, for testing until a real endpoint is set) and 'modbus'/'opcua'
#   (a REAL read via the EXISTING OT driver — read path only, NEVER writeTags).
#   ⚠ READ-ONLY: this NEVER actuates a rated stop. The certified Safety PLC performs the
#   rated stop ITSELF in hardware (SIL 2/3, <100ms dual-channel); this only MONITORS it.
#   When ON: safety.listSafetyPlcConfigs/plcStatus reads +
#     upsertSafetyPlcConfig/readSafetyPlc mutations are allowed.
#   When OFF (default): all safety-PLC reads/mutations are no-ops (enabled:false).
SAFETY_PLC_ADAPTER_ENABLED=false
#
# SAFETY_SIM_TRACKS_ENABLED — SIMULATED safety-track publisher (doc 22 P2, Khối 3). A
#   background worker that periodically synthesises person↔robot proximity tracks and
#   drives them through the EXISTING advisory ingest path (near-miss advisor + S2a zone
#   evaluator), so the 3-tier zone evaluator + the 'safety:event' socket + the Safety
#   Cockpit are exercised END-TO-END without a live sensor.
#   ⚠ Every track is SIMULATED (source 'test' → detectedBy 'sim'), clearly labelled —
#   NOT a real sensor. Commands NO device, actuates NO stop; a rated-band crossing is
#   LOGGED only. Advisory events PERSIST only when SAFETY_AUDIT_ENABLED is also on; the
#   evaluator only runs when SAFETY_ZONE_SW_ENABLED is on.
#   When OFF (default): the worker is never scheduled — a complete no-op.
#   Optional: SAFETY_SIM_TRACKS_INTERVAL_MS=5000 (tick period, clamped [1s,5min]);
#            SAFETY_SIM_TRACKS_ROBOT_ID=1 (which robot the synthetic human approaches).
SAFETY_SIM_TRACKS_ENABLED=false

# =============================================================================
# E1 EQUIPMENT STANDARDS — Equipment Standardization & Governance (Khối 5, doc 16 §10 / §15 E1)
# =============================================================================
# EQ_GOVERN_ENABLED — the governance/standardization LAYER over the existing
#   capability model (capabilityModel.ts + packml.ts). When ON, the equipmentStandards
#   router MUTATIONS are allowed: register a draft device type, upsert an ISA-18.2
#   alarm mapping, and run the Equipment Standards Board change-request workflow
#   (submit -> review -> publish a NEW versioned device_types row, with backward-compat
#   enforced: ADD-only = minor/patch, remove/alter a published field = major + flagged).
#   When OFF: all mutations CONFLICT (no-op); READS still work — the registry tree,
#   resolveType, alarm taxonomy list/map, conformance run and compliance metrics are
#   always served from the in-memory SEED (built from capabilityModel) unioned with any
#   persisted rows. This layer is GOVERNANCE METADATA only — it opens NO device-control
#   path (device commands still route through the existing gated dispatchers).
EQ_GOVERN_ENABLED=false

# =============================================================================
# I1 EQUIPMENT INTEGRATION — multi-vendor integration extensions (Khối 1B, doc 16 §6 / §15 I1)
# =============================================================================
# EQ_INTEG_ENABLED — extends multi-vendor equipment integration: the FOCAS (Fanuc CNC)
#   and Euromap (63/77/83 injection-molding) adapter FRAMEWORKS, recipe versioning
#   genealogy, and adapter->Andon ALARM NORMALIZATION.
#   HONESTY: FOCAS/Euromap are READ-ONLY MONITORING FRAMEWORKS — no real device is
#   attached, no native FOCAS (Fwlib32) / Euromap transport is linked, and NO telemetry
#   is fabricated. A future connector feeds each adapter's local last-value cache; until
#   then snapshots report source:'none'|'cache'. They open NO control path.
#   When ON: (a) the equipmentIntegration router MUTATIONS are allowed — create / release
#   / archive / rollback a recipe version + record-load (genealogy in recipe_load_log,
#   reusing the existing machine_recipes/recipe_deployments versioning); (b) the
#   adapter->Andon alarm normalizer maps a raw vendor alarm via the E1 ISA-18.2
#   alarm_taxonomy (mapAlarm) and raises a NORMALIZED Andon (standardCode + severity)
#   instead of the raw code.
#   When OFF (default): all recipe mutations CONFLICT (no-op); the alarm normalizer is a
#   complete NO-OP passthrough (existing Andon behaviour UNCHANGED); READS still work
#   (integration status, framework snapshot, recipe versions/load history).
EQ_INTEG_ENABLED=false

# ─── I3b — Euromap 77/83 OPC-UA adapter (validated vs OPC-UA sim) ────────────
# I3b turns the I1 Euromap FRAMEWORK into a READ-ONLY OPC-UA adapter that pulls the
# Unified Equipment Model over the existing opcuaDriver from a CONFIGURED node-map.
# Reuses EQ_INTEG_ENABLED for the alarm→Andon path. All additive; defaults empty/off.
# HONESTY: no endpoint / server unreachable → a CLEAR error (nothing fabricated). A real
# run points the endpoint at an OPC-UA sim server (open62541/Prosys) loaded with the
# Euromap-77 nodeset, or a real Euromap-77 machine (see doc 20 §7 runbook).
#   Endpoint of the machine's / sim's OPC-UA server:
EUROMAP_OPCUA_ENDPOINT=
#   UEM-field → OPC-UA nodeId map (JSON matching EuromapNodeMap). The exact nodeIds are
#   PER MACHINE — fill from the server's address space (browse) once. alarmNodes are
#   boolean nodes; each `code` is the native alarm code fed to mapAlarm.
#   {"activeMould":"ns=4;s=ActiveMould","shotCounter":"ns=4;s=ShotCounter",
#    "goodPartsCounter":"ns=4;s=GoodPartsCounter","actualCycleTime":"ns=4;s=ActualCycleTime",
#    "targetCycleTime":"ns=4;s=TargetCycleTime","machineMode":"ns=4;s=MachineMode",
#    "alarmNodes":[{"nodeId":"ns=4;s=Alarm.HotRunner","code":"E77-1200","message":"Hot runner"}]}
EUROMAP_OPCUA_NODEMAP=
#   Optional per-machine vendor key for alarm-taxonomy resolution (default 'euromap').
EUROMAP_OPCUA_VENDOR=

# =============================================================================
# X1 FIELD ABSTRACTION — Field & Device Abstraction Layer (Khối 1, doc 16 §5 / §15 X1)
# =============================================================================
# FIELD_V2_ENABLED — COMPLETES the field/device abstraction layer (already ~75%):
#   (a) UDM/UEM extension surfaced from robot_telemetry's new columns
#       (battery_level / joint_states / safety_zone_id / firmware_version /
#        last_heartbeat). battery_level is wired from the VDA5050 battery extraction
#       for AGVs; joint_states/firmware_version are SEAMS (honest NULL until a real
#       driver provides them — NEVER fabricated).
#   (b) heartbeat TTL stale-detection sweep — marks a device 'lost_connection' once
#       now()-last_heartbeat exceeds its TTL + emits an ADVISORY event (safety/fleet
#       react via the EXISTING gated paths). NOT a safety-rated stop.
#   (c) device push-streaming with TIERED sampling — taps the SAME unified telemetry
#       bus as the twin stream (no duplicate gateway) and pushes UDM deltas to the
#       per-device room `device:{id}` (FE keeps its 5s poll fallback when off).
#   (d) hot-plug discovery — OPC-UA browse is a REAL probe; mDNS/Modbus/S7/EtherNet-IP
#       are HONEST SEAMS (no library linked → empty + flagged, never fabricated).
#       Registration adds a DISABLED adapter row (no restart needed).
#   (e) COMMAND-LEVEL AUTHORIZATION — when ON, the dispatcher enforces a command
#       descriptor's requiredPermission (deny if the caller lacks it). When OFF
#       (default) the current behaviour is preserved (descriptor permission advisory).
#       This NEVER weakens the existing HITL / dry-run / connected-driver gates — it
#       can only tighten (deny). Opens NO new control path.
#   When OFF (default): the fieldRouter MUTATIONS (discover/register) CONFLICT; the
#   sweep + device stream do not start; command-authz is a pass-through; READS still
#   work (deviceState/health/healthSummary served from existing data).
FIELD_V2_ENABLED=false
# Heartbeat TTL (ms) before a device is considered stale. Default 2000 (2s for fast
# devices). A per-device override lives in field_device_health.heartbeatTtlMs.
# FIELD_HEARTBEAT_TTL_MS=2000
# Multiple of the TTL past which a stale device is declared 'lost_connection'
# (default 5 → with a 2s TTL: >2s stale, >10s lost). Min 1.
# FIELD_HEARTBEAT_LOST_FACTOR=5
# Stale-sweep interval (ms). Default = the TTL (min 500ms).
# FIELD_HEARTBEAT_SWEEP_MS=2000
# Device push-stream TIER rates (Hz). Position (AMR pose) ~10Hz, machine state ~1Hz,
# slow analog (temperature) ~0.1Hz, everything else 1Hz. The flush timer runs at the
# fastest tier; slower metrics are rate-limited by their tier window (coalesced).
# FIELD_STREAM_HZ_POSITION=10
# FIELD_STREAM_HZ_STATE=1
# FIELD_STREAM_HZ_SLOW=0.1
# FIELD_STREAM_HZ_DEFAULT=1

# ============================================================================
# D1 IR & TRANSPILER (Khối 6, doc 16 §11.1 / doc 18 §6) — IR programming layer
# ============================================================================
# Gates the IR-specific MUTATIONS (irRouter.saveFlow / requestBuild). Reads
# (lint / transpile-preview / list / get) do NOT require it. Default OFF.
# An IR program still reaches a device ONLY through the EXISTING gated deploy
# (DPC_DEPLOY_ENABLED + HITL + Simulation Gate) — this flag opens NO new path.
DPC_IR_V2_ENABLED=false
# DEV NOTE (doc 24 Wave-1 P1): to exercise the visual IR editor's Save/Build end-to-end
# in local dev, set DPC_IR_V2_ENABLED=true in your local .env (the drag-and-drop graph
# canvas, lint and transpile-preview work with the flag OFF too; only save/build are gated).
# Semantic safety-linter ceilings (block transpile on error). All optional; the
# linter falls back to safe defaults when unset. Tune per cell.
# DPC_IR_MAX_SPEED_MMS=250          # max Cartesian linear speed (mm/s)
# DPC_IR_MAX_FORCE_N=150            # max gripper force (N)
# DPC_IR_MAX_GRIP_TIMEOUT_MS=30000  # max grip actuation timeout (ms)
# DPC_IR_MAX_BLEND_RADIUS_MM=100    # max blend radius (mm)
# Declared reachable workspace AABB (mm) — poses outside are an error.
# DPC_IR_WORKSPACE_MIN_X=-1000
# DPC_IR_WORKSPACE_MIN_Y=-1000
# DPC_IR_WORKSPACE_MIN_Z=0
# DPC_IR_WORKSPACE_MAX_X=1000
# DPC_IR_WORKSPACE_MAX_Y=1000
# DPC_IR_WORKSPACE_MAX_Z=1500

# ============================================================================
# I2 AI LOOP COMPLETION (Khối 4, doc 16 §9 / doc 18 §6) — closes the AI/analytics loop
# ============================================================================
# I2-a — Robot-behaviour anomaly detection (ADVISORY ONLY). When ON, each robot
# telemetry ingest runs a time-series scan (trajectory deviation via EWMA on
# joint/pose, grip-force via EWMA IF force telemetry present, cycle-time drift via
# CUSUM on robot_jobs durations) and raises a SMART ALERT + an advisory
# robot_behavior_anomalies row. Opens NO robot-command path. Default OFF → no scan.
AI_ROBOT_ANOMALY_ENABLED=false
# EWMA residual σ threshold for trajectory/grip-force anomalies (default 3.0).
# AI_ROBOT_ANOMALY_TRAJ_SIGMA=3.0
# CUSUM threshold for the rising cycle-time trend (default 4.0).
# AI_ROBOT_ANOMALY_CYCLE_CUSUM=4.0
#
# I2-b — Model auto-rollback. When ON, a periodic sweep checks each ACTIVE model
# version's live accuracy/drift (from model_performance_snapshots) vs its eval
# baseline and AUTOMATICALLY rolls back to the previous stable version (flipping
# model_versions.status via the SAME activation op), records a model_rollback_events
# row + emits an alert. Default OFF → manual activation only (today's behaviour).
# NOTE: live accuracy needs a FEEDBACK SIGNAL (a perf snapshot). With no snapshot the
# monitor does NOTHING (it never fabricates a live metric to justify a rollback).
AI_MODEL_AUTOROLLBACK_ENABLED=false
# Max tolerated live-accuracy drop (fraction 0..1) vs baseline before rollback (default 0.05).
# AI_MODEL_AUTOROLLBACK_ACC_DROP=0.05
# Drift score at/above which a rollback fires regardless of accuracy (default 0.25).
# AI_MODEL_AUTOROLLBACK_DRIFT=0.25
# Auto-rollback sweep interval (ms). Default 600000 (10 min); min 60000.
# AI_MODEL_AUTOROLLBACK_SWEEP_MS=600000

# doc 22 P2 — Model performance snapshot producer. When ON, a periodic sweep
# aggregates recent ai_feedback (⋈ ai_suggestions) per model version into live
# accuracy + a confidence distribution and writes a model_performance_snapshots row.
# This is the FEEDBACK SIGNAL the auto-rollback monitor above reads (previously the
# table was never written → auto-rollback had no live signal). ADVISORY ONLY: this
# producer NEVER rolls a model back itself. Default OFF (writes nothing).
AI_MODEL_PERF_SNAPSHOTS_ENABLED=false
# Feedback window (hours) aggregated into one snapshot. Default 24.
# AI_MODEL_PERF_SNAPSHOTS_WINDOW_HOURS=24
# Min evaluated feedback samples per model version before a snapshot is written. Default 5.
# AI_MODEL_PERF_SNAPSHOTS_MIN_SAMPLES=5
# Snapshot sweep interval (ms). Default 3600000 (1h); min 60000.
# AI_MODEL_PERF_SNAPSHOTS_SWEEP_MS=3600000

# ============================================================================
# T2b KINEMATIC SIM GATE (doc 20 §1/§5 · doc 16 §11.2) — real Simulation Gate
# ============================================================================
# When ON, the IR adapter's simulate() runs a REAL kinematic Simulation Gate instead of
# the structural block-timeline preview: forward-kinematics over an authored kinematic
# model (sample UR5-ish 6-DOF arm / SCARA until real URDF import lands in T2a) + geometric
# collision (link bounding volumes vs scene-graph obstacles) + joint-limit + workspace +
# safety-zone checks + a trapezoidal cycle-time estimate. A program that collides / exceeds
# a joint limit / intrudes a safety zone FAILS the gate (sim ok=false) BEFORE it can deploy.
# Deploy stays gated separately (DPC_DEPLOY_ENABLED + HITL) — this opens NO device path.
# Default OFF → today's honest structural preview is unchanged. A device type with no
# kinematic model returns an honest "no model — structural only" result (never a fake pass).
SIM_KINEMATIC_ENABLED=false
# DEV NOTE (doc 24 Wave-1 P1): set SIM_KINEMATIC_ENABLED=true in your local .env to run the
# REAL kinematic Simulation Gate (FK + collision + joint-limit + workspace + cycle-time)
# during a build's simulate() step instead of the structural preview. No device path.
# Waypoints sampled PER motion segment (interpolation density). Higher = finer motion
# sweep (more FK evaluations), catches thin obstacles better. Default 8; min 1.
# SIM_WAYPOINT_RESOLUTION=8
# Collision margin (mm): a link↔obstacle (or link↔link) separation ≤ this flags a
# collision/near-miss. 0 = touch; a positive value adds a safety buffer. Default 0.
# SIM_COLLISION_MARGIN_MM=0
#
# ── T2 — REAL RIGID-BODY PHYSICS (doc 24 Wave-1) — Rapier dynamics gate ──
# When ON, the Simulation Gate binds a REAL rigid-body physics engine (Rapier, WASM) behind
# the existing PhysicsBackend seam INSTEAD of the quasi-static holding-torque estimator. Each
# link becomes a Rapier rigid body whose mass + full inertia tensor + COM are computed from its
# geometry (density calibrated to any declared massKg), and the SAME sampled trajectory is
# evaluated with genuine rigid-body inverse dynamics: required actuator TORQUE per joint
# (inertial + Coriolis/centrifugal + gravity, not just holding torque), dynamic INSTABILITY
# (infeasible required accel), base TIP-OVER (whole-arm COM outside the support footprint), and
# link↔link CONTACT (Rapier narrow-phase). Under this flag a physics violation BLOCKS the gate
# (fails sim → blocks deploy) exactly like a collision — deploy stays gated separately
# (DPC_DEPLOY_ENABLED + HITL), this opens NO device path.
# Default OFF → the internal quasi-static dynamics runs ADDITIVELY and NEVER changes `pass`
# (today's behaviour, byte-for-byte). HONEST DEGRADATION: if a model lacks usable mass/geometry
# the torque is labelled `degraded` (not fabricated); if the Rapier WASM cannot load at runtime
# the gate falls back to the internal quasi-static backend (non-blocking) and notes the failure —
# never a fabricated physics pass. Set true in your local .env to exercise the real engine.
SIM_PHYSICS_ENABLED=false

# ============================================================================
# T2a — MODEL PIPELINE (doc 20 §1/§5) — URDF → glTF converter + kinematic chain.
# ============================================================================
# When ON, the twin model pipeline can CONVERT a URDF source into a real, renderable
# glTF 2.0 asset (hand-rolled emitter: box/cylinder/sphere → triangle buffers with
# POSITION/NORMAL/indices + node hierarchy from the joint tree) written under
# uploads/models/urdf/<key>.gltf and recorded in the equipment_3d_models registry with
# conversionStatus='ready' — so DigitalTwinCenter renders the real robot instead of a
# primitive block. The SAME parse ALSO feeds the T2b sim gate: urdfToChainStub now returns
# a REAL kinematic chain (exact rest transforms + axes + limits + per-link bounding volumes)
# derived from the URDF, so the Simulation Gate runs on real robot geometry.
# HONEST seams (never faked): external <mesh> refs that are not cheap ASCII-STL become
# labelled PLACEHOLDER boxes (recorded in the row's notes); STEP/IGES→glTF is a PHASE-2 seam
# (needs a CAD kernel — occt-import-js WASM OpenCASCADE / assimp) and registers 'pending', not
# 'ready'. A conversion failure registers 'failed' with the real error, never a fake 'ready'.
# Mutations are also RBAC-gated (machine_control/canCreate). Default OFF → no-op, no writes.
MODEL_PIPELINE_ENABLED=false

# ============================================================================
# I3a — URSIM + ROS2 HARNESS (doc 20 §3/§5/§7) — validate the automation stack
#        against REAL controllers/middleware in simulation (no physical robot).
# ============================================================================
# Both harnesses target FREE simulators the operator stands up in Docker (see doc 20 §7
# runbook). All flags default OFF — off = nothing connects, no socket opened. HONEST: when
# a sim endpoint is unreachable the harness returns a clear error; it NEVER fabricates a
# connected/accepted/running state.
#
# ── URSim (Universal Robots controller simulator) ──
# When ON, an IR/URScript program may be deployed to a configured URSim endpoint through
# the EXISTING gated deploy flow (real deploy ⇔ URSIM_ENABLED && DPC_DEPLOY_ENABLED && HITL
# sign-off), and validateUrscriptOnUrsim can send the D1-transpiled URScript to the
# (virtual) controller + poll robotmode/programState — the end-to-end IR→controller proof.
# Stand up URSim:  docker run --rm -it -e ROBOT_MODEL=UR5 \
#   -p 5900:5900 -p 6080:6080 -p 29999:29999 -p 30001-30004:30001-30004 \
#   universalrobots/ursim_e-series
URSIM_ENABLED=false
# URSim controller host/IP (the Docker host). Empty = no default endpoint (pass per-call).
URSIM_HOST=
# UR interface ports (defaults match the container's published ports).
# URSIM_PRIMARY_PORT=30001      # URScript send (primary interface; 30002 = secondary)
# URSIM_DASHBOARD_PORT=29999    # load/play/stop/power/robotmode/programState (line protocol)
# URSIM_TIMEOUT_MS=5000         # per-socket connect/read timeout
#
# ── ROS2 bridge (via rosbridge_server WebSocket — pure JS, no native ROS2 dep) ──
# When ON + ROSBRIDGE_URL set, the bridge subscribes ROS2 telemetry topics
# (/joint_states, /odom, /tf) → normalizes → telemetryBus (unified ot_telemetry), and
# publishes platform commands to ROS2 ONLY through the existing robotCommandDispatcher gate
# (idempotency + HITL + dry-run) — no new control path. Stand up rosbridge:
#   ros2 launch rosbridge_server rosbridge_websocket_launch.xml   # default ws://HOST:9090
ROS2_BRIDGE_ENABLED=false
# rosbridge WebSocket URL (e.g. ws://127.0.0.1:9090). Empty = bridge not started.
ROSBRIDGE_URL=

# ── Data retention & image lifecycle (doc 27 §11 decisions #2/#5) ──────────────
# Decision #2: 12-month retention for EVERYTHING (inspection rows, images, logs).
# Decision #5: blob = local FS (32TB volume) + lifecycle + disk alert at 80%.
# Master switch for BOTH the row sweeper (dataRetentionService) and the image
# lifecycle (imageLifecycleService). Production profile: true.
# The app-level sweeper automatically SKIPS tables that already have a native
# TimescaleDB retention policy (migration 0173) — no double-delete.
# command_log is NEVER pruned (append-only control/compliance ledger).
DATA_RETENTION_ENABLED=true
# First run in a new environment: preview deletions without deleting.
# DATA_RETENTION_DRY_RUN=true
# DATA_RETENTION_BATCH=5000                  # rows deleted per batch
# DATA_RETENTION_INTERVAL_MS=86400000        # sweep interval (default 24h)
# Per-table 12-month windows (days; 0 disables that table):
# RETENTION_PRODUCT_INSPECTIONS_DAYS=365
# RETENTION_MEASUREMENT_RESULTS_DAYS=365
# RETENTION_AUDIT_LOGS_DAYS=365
# RETENTION_NOTIFICATIONS_DAYS=365
# RETENTION_MQTT_ALERT_HISTORY_DAYS=365
# RETENTION_MQTT_NG_RATE_ALERT_DAYS=365
# RETENTION_MQTT_CONNECTION_LOGS_DAYS=365
# RETENTION_MQTT_RECONNECT_LOGS_DAYS=365
# RETENTION_PACKAGE_ACTIVITY_LOGS_DAYS=365
# Image lifecycle (files under LOCAL_STORAGE_DIR/inspections/<id>/):
# RETENTION_INSPECTION_IMAGES_DAYS=365       # max image age (mtime fallback sweep)
# IMAGE_LIFECYCLE_INTERVAL_MS=86400000       # image prune interval (default 24h)
# IMAGE_LIFECYCLE_MAX_DIRS_PER_RUN=5000      # bound work per run
# UPLOADS_DISK_ALERT_PCT=80                  # uploads volume usage alert threshold (%)
# UPLOADS_DISK_CHECK_INTERVAL_MS=3600000     # disk usage check interval (default 1h)
# ─── Doc 51 P3 (CASE #5) — ORPHAN-IMAGE REAPER theo DB-diff ──────────────────
# Sweep-theo-tuổi (RETENTION_INSPECTION_IMAGES_DAYS) bỏ sót ảnh MỒ CÔI mới (object
# trong storage KHÔNG có measurement_results nào trỏ tới — upload OK nhưng DB row fail).
# Reaper đối chiếu storage↔DB, xoá object mồ côi đủ già. DEFAULT OFF + DRY-RUN.
# ORPHAN_IMAGE_REAPER_ENABLED=false          # bật scheduler reaper (dry-run trừ khi DELETE=true)
# ORPHAN_IMAGE_REAPER_DELETE=false           # false = chỉ báo cáo; true = xoá thật
# ORPHAN_IMAGE_REAPER_GRACE_HOURS=24         # bỏ qua object mới hơn (đang trong lúc ghi)
# ORPHAN_IMAGE_REAPER_INTERVAL_MS=86400000   # chu kỳ (default 24h)

# =============================================================================
# Doc 27 Đợt 7.5 (W7-D) — model infra: fetch/verify models, production AI
# profile (phased, decision #6), GPU micro-batching (gap V4/V6)
# =============================================================================
# Model weights are NOT committed (models/*.onnx|*.gguf gitignored). Provision:
#   node scripts/fetch-models.mjs           # manifest-driven, resume + sha256 + size guard
#   node scripts/fetch-models.mjs --verify  # re-verify checksums
#   node scripts/validate-models.mjs        # load session + dummy-tensor shape check
# Startup logs ONE consolidated [AIModels] line + writes db_feature_status row
# 'ai_models' (admin DB & Ingest health card shows model state).
#
# Override the DINOv2 download URL / enforce a hash (default URL in models/manifest.json,
# hash pinned in models/manifest.lock.json on first fetch):
# MODEL_DINOV2_URL=https://huggingface.co/Xenova/dinov2-small/resolve/main/onnx/model.onnx
# MODEL_DINOV2_SHA256=
# MODEL_DINOV2_BASE_URL=       # optional 768-d dinov2-base
# MODEL_DINOV2_BASE_SHA256=
#
# PRODUCTION AI PROFILE (phased — decision #6, RTX 5090 32GB local inference):
#   Phase 1 (ON once the DINOv2 model is fetched):
# AOI_EMBEDDING_ENABLED=true
# ANOMALY_DETECTION_ENABLED=true
# AI_DRIFT_MONITOR_ENABLED=true
# AI_MODEL_PERF_SNAPSHOTS_ENABLED=true
#   Phase 2 (OFF until preconditions exist — do NOT enable blind):
# AOI_DL_HEAD_ENABLED=false          # first-party embedding-head serving; enable after the
#                                    # FIRST trained head exists (labels from corrections 7.2)
# AI_MODEL_AUTOROLLBACK_ENABLED=false# auto-rollback needs canary/A-B baseline data (7.1)
# AI_AUTO_PROMOTE_ENABLED=false      # human/canary promotion only — keep OFF in production
#
# GPU MICRO-BATCHING (gap V6, aiInferenceEngine): classification requests for the
# same model coalesce into ONE [N,C,H,W] session.run; detection (YOLO) stays N=1
# (per-image NMS; box outputs not split-safe). Models that reject N>1 fall back
# to per-item runs automatically and are remembered as no-batch.
# AI_BATCH_MAX=8                     # max images per stacked run (1 disables batching)
# AI_BATCH_WINDOW_MS=25              # collection window before a partial flush (ms)
# AI_GPU_CONCURRENCY=2               # concurrent session.run across ALL models (semaphore,
#                                    # shared with the DINOv2 embedding path)
# AI_SESSION_CACHE_MAX=5             # LRU ONNX session cache size (8 documented-OK @32GB VRAM)

# ============================================================================
# Doc 34 — AI Local Automation Programming Copilot (P0 serving + P1 knowledge)
# ============================================================================
# --- P0: coder/FIM tiers + OpenAI-compatible gateway ---
# GGUF_CODE_MODEL=                         # coder model basename; unset -> reuse GGUF_DEFAULT_MODEL (30B-A3B, decision D2)
# GGUF_FIM_MODEL=                          # small fill-in-middle model for autocomplete; unset -> fim tier falls back to GGUF_FAST_MODEL (4B)
# AI_CODE_ROUTER_ENABLED=false            # enable router 'code'/'fim' tiers (else code->deep, fim->fast unchanged)
# OPENAI_GATEWAY_ENABLED=false            # expose OpenAI-compatible /v1/* (chat/completions, completions(FIM), embeddings, models)
# OPENAI_GATEWAY_PATH=/v1                  # base path for the shim
# OPENAI_GATEWAY_API_KEY=                  # bearer token required by the gateway (empty + enabled -> gateway refuses to start)
# LLAMA_CODER_BIN=                         # persistent llama-server binary for coder (defaults to LLAMA_SERVER_BIN)
# LLAMA_CODER_PORT=8090                    # port for the persistent coder llama-server (prefix-cache + FIM + own slot budget)
# LLAMA_CODER_CTX=32768                    # coder context window
# --- P1: programming knowledge base (manuals RAG + golden code) ---
# PROG_KB_ENABLED=false                    # enable the programming knowledge retrieval service (separate from ops KB)
# PROG_KB_DIR=knowledge/programming        # per-vendor programming chunk/embedding collections live here
# PROG_KB_MANUALS_DIR="D:/SOURCES/AI Local/Manual"  # source vendor PDF manuals to ingest (folder is 'Manual', singular)
# PROG_KB_RERANKER_ENABLED=true            # rerank retrieved programming chunks (bge-reranker already on disk)
# PROG_KB_PGVECTOR=false                   # use pgvector for programming corpus if DB supports it (else file brute-force)
# GOLDEN_CODE_DIR=knowledge/golden-code    # per-language golden example corpus (few-shot source)
# AI_PROGRAMMING_COPILOT_ENABLED=false     # (existing) LLM codegen via aiProgrammingCopilot — flip in P2
# PROG_CODEGEN_VALIDATE_REQUIRED=true      # every AI-generated program must pass programmingAdapter.validate before display (P2)
# PROG_WORKSPACE_DIR=programming-workspace  # root dir the read_project_file / write_project_file(HITL) tools are confined to (P2)
# GGUF_CODE_CTX=8192                        # codegen context cap; keeps the 30B KV-cache small so it fits alongside RAG (P2/P4 load-order fix)
# AI_CODEGEN_SELF_REPAIR=true               # P4c #1: feed programmingAdapter diagnostics back to the model to auto-fix invalid codegen (default ON)
# AI_CODEGEN_REPAIR_MAX=2                    # max self-repair rounds (default 2, cap 4)

# ═══════════════════════════════════════════════════════════════════════════════
# doc 35 — deep-audit remediation flags (W2-W5). ALL default OFF; enable staged
# (staging → smoke → prod) per the doc 19/23 flag-flip runbook. Current behavior is
# byte-identical until a flag is turned on.
# ═══════════════════════════════════════════════════════════════════════════════
# — W2 data-integrity —
# ALERT_ESCALATION_SWEEP_ENABLED=false      # start the configured alert_escalation_rules sweep at boot (was admin-mutation-only → never fired)
# ANDON_SLA_ESCALATION_ENABLED=false        # periodic Andon SLA-breach sweep → escalateAndon (was dead code)
# ANDON_SLA_SWEEP_MS=300000                 # sweep interval (min 60000)
# ANDON_SLA_RED_MIN=15                       # per-state SLA minutes before escalation
# ANDON_SLA_CALL_MIN=10
# ANDON_SLA_YELLOW_MIN=30
# RETENTION_OT_TELEMETRY_DAYS=90            # interim app-level prune (was 0=unbounded). Set to 0 AFTER the TimescaleDB cutover (install extension → re-apply 0172/0173 → native retention)
# — W4 process (require migrations 0225-0229 applied) —
# PM_SCHEDULE_GEN_ENABLED=false             # auto-generate PREVENTIVE work orders from maintenance_schedules.nextDueAt
# PM_SCHEDULE_GEN_INTERVAL_MS=3600000
# WIP_HOLD_ENFORCED=false                    # exclude held (NG) serials from WIP dispatch/advance
# FAI_GATE_ENABLED=false                     # block inspection-program release until a passing First-Article (FAI) exists
# GOLDEN_REVALIDATION_REQUIRED=false         # on release of a product with approved goldens, raise golden-revalidation-pending until a diff runs
# FEEDER_VERIFY_ENFORCED=false               # block run on a feeder slot<->BOM mismatch (recording works regardless)
# MSD_TRACKING_ENABLED=false                 # MSD floor-life clock scheduler/alerts (J-STD-020)
# STENCIL_TRACKING_ENABLED=false             # stencil cycle-count side-effects/alerts
# — W5 analytics (dim/fact mart requires migration 0230) —
# SPC_CENTRAL_ALERT_ENABLED=false            # route SPC out-of-control -> central alert engine (predictive_alerts + notify)
# SPC_CENTRAL_ALERT_ANDON=false              # additionally raise an advisory Andon on CRITICAL SPC OOC
# SPC_CENTRAL_ALERT_COOLDOWN_MS=300000       # de-dup window per (pointDef, ruleKind)
# REPORTING_MART_ENABLED=false               # hourly dim/fact reporting-mart refresh (fact_inspection_hourly)
# REPORTING_MART_INTERVAL_MS=3600000
# REPORTING_MART_WINDOW_HOURS=3              # incremental look-back per refresh
# — pilot enablers (already-built, flag-off) —
# ERP_INBOUND_ENABLED=false                  # POST /api/v1/orders,/bom (routing now resolvable via routing_master, mig 0229)
# ERP_OUTBOX_ENABLED=false                   # transactional ERP outbound (needs a real endpoint; else dead-letters)

# ══════════════════════════════════════════════════════════════════════════════
# doc 44 W6 — UX & An ninh cắt ngang (tất cả default OFF)
# ══════════════════════════════════════════════════════════════════════════════
# W6-2 (G5.11) — impact-based alert priority + dedup fingerprint (OFF = sort severity+tuổi cũ)
IMPACT_ALERT_ENABLED=false
# W6-3 (G5.22) — MQTT mTLS: permissive (log) | strict (reject no-cert). Bat firewall listener plaintext truoc strict.
MQTT_MTLS_ENABLED=false
MQTT_MTLS_MODE=permissive
# MQTT_MTLS_CA=
SERVICE_MTLS_ENABLED=false
# W6-3 (G5.23) — secret manager OpenBao/Vault KV v2 (OFF = process.env nhu cu)
SECRET_MANAGER_ENABLED=false
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=
# VAULT_KV_MOUNT=secret
# VAULT_SECRET_PATH=synapse/prod
# SECRET_MANAGER_TTL_MS=300000
# W6-3 (G5.18) — SIEM export tu audit hash-chain (syslog RFC5424 | webhook)
SIEM_EXPORT_ENABLED=false
# SIEM_TRANSPORT=webhook
# SIEM_SYSLOG_HOST=127.0.0.1
# SIEM_SYSLOG_PORT=514
# SIEM_WEBHOOK_URL=
ANOMALOUS_LOGIN_ENABLED=false
# ANOMALOUS_LOGIN_FAIL_BURST=3
# W6-4 (G5.20) — DORA metrics (deployment_events, mig 0267)
DORA_ENABLED=false
# W6-4 (G5.19) — SAML SP SSO (production can @node-saml/node-saml cho signature-verify)
SAML_ENABLED=false
# SAML_IDP_METADATA_URL=
# SAML_IDP_ENTITY_ID=
# SAML_IDP_SSO_URL=
# SAML_IDP_CERT=
# SAML_SP_ENTITY_ID=
# SAML_SP_ACS_URL=
# SAML_REQUIRE_SIGNED=true
# W6-5 (G5.24) — connector WMS/PLM/CMMS + reconciliation thuc (can ERP_OUTBOX_ENABLED cho outbound)
WMS_INTEGRATION_ENABLED=false
PLM_INTEGRATION_ENABLED=false
CMMS_INTEGRATION_ENABLED=false
# WMS_OUTBOUND_ENDPOINT=   WMS_INVENTORY_URL=   WMS_RECONCILE_URL=
# PLM_PULL_URL=
# CMMS_OUTBOUND_ENDPOINT=   CMMS_SCHEDULE_URL=
# MES_RECONCILE_URL=   MES_RECONCILE_INTERNAL_URL=

# ══════════════════════════════════════════════════════════════════════════════
# doc 44 W7 — Edge gateway + Editions + Streaming + Rebrand R-3 (default OFF)
# ══════════════════════════════════════════════════════════════════════════════
# W7-1 (G1.14) — Edge gateway process THAT (chay `npm run start:edge`, khong bind HTTP).
# Bien tu chu: buffer telemetry >=24h khi mat central + backfill dung thu tu no-loss/no-dup.
# EDGE_GATEWAY_MODE tu bat khi dung entrypoint edge; tren central TAT OT_GATEWAY_ENABLED cho
# adapter da giao edge (tranh double-poll).
# EDGE_GATEWAY_NODE_CODE=   EDGE_GATEWAY_FACTORY_CODE=   EDGE_GATEWAY_LINE_CODES=
# EDGE_GATEWAY_CONFIG_FILE=deploy/gitops/edge-node.yaml
# EDGE_UNS_STORE_FORWARD_MAX=500000   EDGE_UNS_STORE_FORWARD_MAX_AGE_MS=86400000
# W7-2 (§11 R-3) — MQTT topic avi/ -> synapse/ DUAL-PUBLISH (giu avi/ suot grace period).
# Thu tu: buoc 1 dual-publish -> chuyen client (2-4 tuan) -> buoc 3 tat legacy.
MQTT_TOPIC_DUAL_PUBLISH=false
MQTT_TOPIC_LEGACY_DISABLE=false
# W7-2 (§9) — Join wizard (Machine Edition join Site); mDNS can `npm i bonjour-service`,
# static-peer + bridge dung duoc ngay
JOIN_WIZARD_ENABLED=false
# JOIN_SITE_BROKER_URL=   JOIN_STATIC_PEERS=host:port[:nodeId],...   SITE_ID=
# W7-3 / W4 (G2.7/G2.8) — streaming bridge: inprocess (dung ngay) | nats (can `npm i nats`)
STREAM_BRIDGE_BACKEND=inprocess
# NATS_URL=nats://127.0.0.1:4222   NATS_STREAM_PREFIX=syn
STREAM_PROCESSOR_ENABLED=false
STREAM_TELEMETRY_TAP_ENABLED=false
# doc48 R3 (G-L2) — COLD-TIER LAKE SINK: durable NATS consumer archives the telemetry
# stream → time-partitioned gzipped-NDJSON (columnar-ready; TODO swap to Parquet).
# Default OFF; needs STREAM_BRIDGE_BACKEND=nats + NATS_URL for a DURABLE tier (on the
# in-process backend it runs as a labelled NON-durable source). Prove: `npm run lake:verify`.
LAKE_SINK_ENABLED=false
LAKE_DIR=./data/lake
# LAKE_SOURCE_TOPIC=syn/telemetry/*   LAKE_CONSUMER=lake_sink
# LAKE_BATCH_MAX=500   LAKE_FLUSH_MS=10000   LAKE_ACK_WAIT_MS=60000   LAKE_DELIVER_POLICY=all
# Optional MinIO/S3 target (else local FS). See deploy/compose/docker-compose.lake.yml:
# LAKE_S3_ENDPOINT=http://127.0.0.1:9000   LAKE_S3_BUCKET=synapse-lake   LAKE_S3_REGION=us-east-1
# LAKE_S3_ACCESS_KEY=   LAKE_S3_SECRET_KEY=   LAKE_S3_FORCE_PATH_STYLE=true   LAKE_S3_PREFIX=telemetry

# ═══════════════════════════════════════════════════════════════════════════════
# Sprint 5 §2.2/§2.5/§2.7 — routeAlert: gộp THÔNG BÁO vs GHI nhật ký (aiSmartAlertRouter.ts)
# ═══════════════════════════════════════════════════════════════════════════════
# ⚠ Cả 3 khoá dưới đây CHỈ chi phối cảnh báo GẮN MÁY (event.machineId != null).
# decideNotify() không bao giờ chạm tới cảnh báo KHÔNG có machineId: router chỉ
# tra cảnh báo mở khi có machineId, nên thiếu machineId ⇒ decideAlertWrite luôn
# trả action="insert" ⇒ decideNotify luôn báo (nhánh "first"). Cảnh báo không-máy
# BÁO MỌI LẦN bất kể 3 khoá này — đó là quyết định để mở, chưa chốt (không phải
# bug ở đây, chỉ ghi lại vì chưa nơi nào nói rõ phạm vi).
#
# Sprint 5 §2.7 — gộp THÔNG BÁO cảnh báo đang mở (không ảnh hưởng nhật ký/KPI).
# Cảnh báo tái diễn chỉ báo lại khi: mức tăng, hoặc CRITICAL, hoặc hết cooldown.
# ⚠ CÔNG TẮC TẮT KHẨN: đặt =0 thì `elapsed >= 0` luôn đúng ⇒ báo MỌI lần tái diễn,
# tức quay lại đúng hành vi trước Sprint 5 (22 lượt/ngày thay vì ≤6). Tính năng
# này hỏng theo kiểu NGƯỜI VẬN HÀNH THÔI NHẬN THÔNG BÁO — khó phát hiện nhất
# trong mọi chế độ hỏng — nên công tắc tắt này cần được biết tới, không giấu.
ALERT_RENOTIFY_COOLDOWN_MINUTES=240
# 0 = CRITICAL luôn báo ngay, không bao giờ gộp.
ALERT_RENOTIFY_COOLDOWN_CRITICAL_MINUTES=0
# Van an toàn chống vòng lặp hỏng phía phát. KHÔNG phải cổng chống nhiễu.
ROUTE_ALERT_MAX_PER_WINDOW=200

# ═══════════════════════════════════════════════════════════════════════════════
# Đợt sửa cuối §4 (Phần 4) — CÔNG TẮC QUAY LUI cho mã lỗi máy-đọc-được (appCode).
# ═══════════════════════════════════════════════════════════════════════════════
# errorFormatter (server/_core/trpc.ts) gắn appCode/appParams vào MỌI phản hồi lỗi
# tRPC được dựng bằng appError() — 43 commit trên toàn `server/routers/**`. Nếu sau
# khi lên production phát hiện một câu dịch sai lan rộng (hoặc appCode làm hỏng một
# tích hợp bên thứ ba đang đọc `.message` thô), cách duy nhất để lùi lại trước đây
# là revert 43 commit + build lại FE — quá chậm cho một sự cố đang diễn ra.
#
# ⚠ CÔNG TẮC TẮT KHẨN: đặt =false thì client TỰ ĐỘNG rơi về ĐÚNG hành vi trước sprint
# mã-lỗi (message thô làm câu hiện cho người dùng, không có appCode/appParams trong
# shape.data) — KHÔNG CẦN đụng bundle FE, vì client/src/lib/trpcErrors.ts đã tự rơi
# về `fallback` khi không thấy appCode. Mặc định BẬT (thiếu biến = không đổi gì).
# APP_ERROR_CODES_ENABLED=false
