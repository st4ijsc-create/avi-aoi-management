# =============================================================================
# AVI-AOI Management System — Environment Configuration
# Copy this file to .env and fill in your values before starting the server.
# =============================================================================

# --- Server ---
NODE_ENV=production
PORT=3000

# --- Database (required) ---
DATABASE_URL=postgresql://user:password@localhost:5432/avi_aoi

# --- Security (required) ---
# Generate a strong random secret: openssl rand -base64 64
JWT_SECRET=change_this_to_a_strong_random_secret_minimum_32_chars
# 21 CFR Part 11 §11.70 — HMAC secret for cryptographic supervisor sign-off (>=16 chars)
SIGNOFF_SECRET=change_this_signoff_secret_min_16_chars
# Comma-separated list of allowed browser origins for CORS + Socket.IO handshake
# Example: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Per-IP rate limit (requests per minute) for /api/* and /trpc/* (default 300)
RATE_LIMIT_PER_MINUTE=300

# --- Application ---
VITE_APP_ID=avi-aoi-management

# --- About Page (optional) ---
# These values are shown at /about-system. Leave empty to use default i18n content.
# VITE_ABOUT_COMPANY_NAME=Your Company Name
# VITE_ABOUT_COMPANY_DESCRIPTION=System implementation and operations organization.
# VITE_ABOUT_DEVELOPER_TEAM=Your Engineering Team
# VITE_ABOUT_DEVELOPER_ROLE=Architecture, feature development, performance optimization.
# VITE_ABOUT_DEVELOPER_CONTACT=contact@your-company.com

# --- Storage ---
# "local" = store files on this server's filesystem
# "forge" = use external Forge API for image storage
STORAGE_MODE=local
LOCAL_STORAGE_DIR=./uploads

# --- Master API Key (for machine/device integration) ---
MASTER_API_KEY=change_this_master_api_key

# --- License ---
LICENSE_FILE_PATH=./license.lic
# LICENSE_SERVER_URL=https://license.example.com
# LICENSE_PRODUCT_CODE=AVI-AOI-PROD
# LICENSE_ENCRYPTION_SECRET=

# --- Email / SMTP (optional) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_app_password
# SMTP_FROM=noreply@your-domain.com

# --- AI / OpenAI (optional — for AI chat and analysis features) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o

# --- Redis (optional — for session caching / rate limiting) ---
# REDIS_URL=redis://localhost:6379

# --- MQTT Broker (optional — for real-time machine communication) ---
# Local Aedes broker for AVI/AOI machines
MQTT_ENABLED=false
# MQTT_PORT=1883
# MQTT_WS_PORT=8883

# External MQTT Broker (optional — forward messages to cloud broker for third-party integration)
# Enable this to forward all local messages to an external broker (HiveMQ, Mosquitto, EMQX, etc.)
EXTERNAL_MQTT_ENABLED=false

# Broker URL format: mqtt://hostname:port or mqtts://hostname:port (for TLS)
# Examples:
#   - HiveMQ Cloud:    mqtt://broker.hivemq.com:1883
#   - Mosquitto Local: mqtt://localhost:1883
#   - EMQX:            mqtt://emqx-server.local:1883
#   - Secure TLS:      mqtts://secure-broker.com:8883
# EXTERNAL_MQTT_BROKER=mqtt://broker.hivemq.com

# EXTERNAL_MQTT_PORT=1883
# EXTERNAL_MQTT_USERNAME=your_mqtt_username
# EXTERNAL_MQTT_PASSWORD=your_mqtt_password

# Topic prefix (optional — add prefix to all forwarded topics)
# Example: "prod" → topics become "prod/avi/1/workshop/..."
# EXTERNAL_MQTT_TOPIC_PREFIX=

# TLS/SSL Configuration (only when using mqtts:// protocol)
# EXTERNAL_MQTT_USE_TLS=false
# EXTERNAL_MQTT_CA_CERT=/path/to/ca-certificate.crt
# EXTERNAL_MQTT_CLIENT_CERT=/path/to/client-certificate.crt
# EXTERNAL_MQTT_CLIENT_KEY=/path/to/client-private-key.key
# EXTERNAL_MQTT_REJECT_UNAUTHORIZED=true

# --- Firebase Push Notifications (optional) ---
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# --- HTTPS (optional — leave false to use plain HTTP behind a reverse proxy) ---
HTTPS_ENABLED=false
# HTTPS_KEY_PATH=/path/to/privkey.pem
# HTTPS_CERT_PATH=/path/to/fullchain.pem
# HTTPS_CA_PATH=/path/to/chain.pem

# --- Logging ---
# LOG_LEVEL=info   (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# --- AOI Image Cache ---
# AOI_CACHE_DIR=./cache
# AOI_CACHE_TTL_DAYS=7

# --- Backup Off-site Replication (ISO 22301 geographic redundancy) ---
# Choose ONE replication target. If both are set, S3 takes precedence.
#
# Option A: AWS S3 / S3-compatible (MinIO, Wasabi, Cloudflare R2, Ceph RGW).
#   Requires `aws` CLI on PATH. Each backup file is copied to:
#     s3://${AWS_S3_BACKUP_BUCKET}/${AWS_S3_BACKUP_PREFIX}/<file>
#   plus a `<file>.sha256` sidecar for integrity verification.
# AWS_S3_BACKUP_BUCKET=my-backup-bucket
# AWS_S3_BACKUP_PREFIX=avi-aoi/prod
# AWS_REGION=ap-southeast-1
# AWS_S3_ENDPOINT_URL=https://minio.example.com         # MinIO / R2 / Wasabi only
# AWS_S3_SSE=AES256                                      # AES256 (SSE-S3) or aws:kms
# AWS_S3_SSE_KMS_KEY_ID=arn:aws:kms:...                  # only when AWS_S3_SSE=aws:kms
# AWS_S3_STORAGE_CLASS=STANDARD_IA                       # STANDARD | STANDARD_IA | GLACIER | DEEP_ARCHIVE
#
# Option B: Off-site filesystem mount (NAS, SMB share, second DC volume).
# OFFSITE_BACKUP_DIR=/mnt/offsite-backup

# --- Forge API (optional — only when STORAGE_MODE=forge) ---
# BUILT_IN_FORGE_API_URL=https://forge.example.com
# BUILT_IN_FORGE_API_KEY=

# --- OAuth Providers (optional) ---
# OAUTH_SERVER_URL=
# VITE_OAUTH_PORTAL_URL=
# OWNER_OPEN_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─── Local AI: GGUF engine (node-llama-cpp, offline-first) ───────────────────
# Directory where .gguf model files live (default: ./uploads/gguf-models)
# GGUF_MODELS_DIR=./uploads/gguf-models
# Default text model id (filename without .gguf) used when no modelId is given
# GGUF_DEFAULT_MODEL=qwen2.5-3b-instruct-q4_k_m
# Dedicated embedding model id (filename without .gguf). REQUIRED for embeddings —
# keeps embeddings off the text model. Use mxbai-embed-large for 1024-dim vectors.
# GGUF_EMBED_MODEL=mxbai-embed-large-v1-f16
# Expected embedding dimension; a mismatch throws an explicit error (default 1024)
# GGUF_EMBED_DIM=1024
# ─── Vision (WS-G2): LOCAL llama.cpp mtmd sidecar (offline, 127.0.0.1) ───────
# node-llama-cpp 3.18.1 has NO multimodal binding, so real vision runs via a local
# `llama-server` (built with mtmd) spawned on localhost and called over HTTP.
# Vision model + its MATCHING multimodal projector (mmproj). Use a real pair such as
# Qwen2-VL-7B-Instruct GGUF + its Qwen2-VL mmproj (do NOT mix a LLaVA mmproj with Qwen).
# Filenames resolve inside GGUF_MODELS_DIR (or give an absolute path).
# GGUF_VISION_MODEL=Qwen2-VL-7B-Instruct-Q4_K_M.gguf
# GGUF_VISION_MMPROJ=mmproj-Qwen2-VL-7B-Instruct-f16.gguf
# Absolute path to the llama-server binary (must be built with mtmd / multimodal support).
# When this + the two files above are all present, vision is enabled; otherwise the system
# degrades honestly (fallbackUsed:true / VISION_NOT_AVAILABLE) — it never fabricates output.
# LLAMA_SERVER_BIN=/opt/llama.cpp/build/bin/llama-server
# Sidecar bind host/port (localhost only — no outbound network)
# LLAMA_VISION_HOST=127.0.0.1
# LLAMA_VISION_PORT=8081
# Healthcheck timeout while the model loads (ms, default 120000)
# LLAMA_VISION_READY_TIMEOUT_MS=120000
# Auto-kill the sidecar after this idle period (ms, default 600000 = 10 min)
# LLAMA_VISION_IDLE_TIMEOUT_MS=600000
# GPU layers (-ngl) passed to llama-server (default 999 = offload all)
# LLAMA_VISION_GPU_LAYERS=999
# GPU acceleration: set to "false" to force CPU; anything else uses auto (CUDA/Vulkan)
# GGUF_GPU=auto
# Parallel sequences per model context (default 4)
# GGUF_SEQUENCES=4
# Max number of models kept resident at once; oldest idle one is evicted (default 2)
# GGUF_MAX_LOADED_MODELS=2
# Soft VRAM cap in MB for eviction. 0 = disabled (default; best-effort, opt-in)
# GGUF_MAX_VRAM_MB=0
# ── GGUF inference concurrency (GĐ2 Mục 4 — protect VRAM from OOM) ──
# Global FIFO semaphore serializing ALL GGUF inference (text/chat/json/stream/embed).
# Max concurrent inferences. Keep at 1 on a 6GB GPU (e.g. RTX 4050); raise on a
# bigger card (e.g. 2-3 on a 24GB RTX 4090) to allow parallel requests.
GGUF_MAX_CONCURRENCY=1
# Max requests allowed to wait for a slot before new ones are rejected (backpressure).
GGUF_QUEUE_MAX=8
# Max time (ms) a request waits for a free slot before failing.
GGUF_INFER_TIMEOUT_MS=120000

# ─── Local AI: legacy Ollama (optional fallback) ─────────────────────────────
# Master rollback switch for ALL local-AI paths (QA generation, KB embeddings,
# image-text embeddings, and tool-intent classification). Default false → everything
# runs in-process via the GGUF engine and NO Ollama daemon is required. Set to "true"
# only to roll back to the legacy Ollama HTTP backend.
# USE_LEGACY_OLLAMA=false
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=mxbai-embed-large
# OLLAMA_QA_MODEL=qwen2.5:3b

# --- ONNX inference Execution Provider (B9 — GPU tăng tốc) ---
# Mặc định CPU. Trên Windows + RTX (vd 4050/4090) bật GPU qua DirectML (KHÔNG cần CUDA Toolkit/cuDNN):
# ENABLE_GPU=true                 # → dùng DirectML EP (DirectX 12) + fallback CPU
# AI_INFER_EP=dml                 # override tường minh: dml | cuda | tensorrt | cpu (ưu tiên hơn các cờ dưới)
# ENABLE_CUDA=true                # chỉ khi onnxruntime build có CUDA EP (npm Windows KHÔNG kèm)
# ENABLE_TENSORRT=true            # chỉ khi đã cài TensorRT runtime
# AI_INFER_MAX_BATCH=4            # VRAM 6-8GB → 2-4; RTX 4090 (24GB) → 8-16
# Kiểm tra môi trường: node scripts/check-tier3-env.mjs
