# doc 34 — generated programming KB corpus (~2GB: vendor-manual chunks + embeddings).
# Regenerate on the server via: node scripts/ai-kb/ingest-manuals.mjs && node scripts/ai-kb/embed-programming.mjs
# (source PDFs live at PROG_KB_MANUALS_DIR, not in the repo). Never commit the corpus.
knowledge/programming/

# doc 34 P2 — AI programming-copilot workspace (read/write_project_file confined here).
# Keep the dir (README) but never commit AI-written files.
programming-workspace/*
!programming-workspace/README.md

# doc 27 V17 — vision validation harness output (npm run vision:validate)
validation-reports/

# doc 34 P4 — eval run reports (regenerate via scripts/ai-eval/*). Keep cases/harness, not runs.
scripts/ai-eval/reports/

# FE live-verify session cookies (never commit — contain auth tokens)
scripts/.fe-auth/

# doc 54 — tool output + local model binaries (not source)
.playwright-mcp/
uploads/models/

# doc65 audit artifacts (local only)
scripts/audit/.s6-shots/
scripts/audit/.s6-results.json
