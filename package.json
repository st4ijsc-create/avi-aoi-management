{
  "name": "synapse-platform",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "dev:worker": "cross-env NODE_ENV=development tsx watch server/worker.ts",
    "dev:edge": "cross-env NODE_ENV=development EDGE_GATEWAY_MODE=true tsx watch server/edge/edgeGatewayMain.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && esbuild server/worker.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && esbuild server/edge/edgeGatewayMain.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && node -e \"require('fs').copyFileSync('server/license/sdk/index.cjs','dist/index.cjs')\" && node -e \"require('fs').mkdirSync('uploads/mqtt-releases',{recursive:true})\" && node scripts/copy-font-assets.mjs",
    "build:secure": "node scripts/build-secure.mjs",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "start:worker": "cross-env NODE_ENV=production node dist/worker.js",
    "start:edge": "cross-env NODE_ENV=production node dist/edgeGatewayMain.js",
    "check": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit",
    "check:tests": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit -p tsconfig.tests.json",
    "format": "prettier --write .",
    "lint:tokens": "node scripts/lint-frontend-tokens.mjs",
    "test": "vitest run",
    "test:db:setup": "node scripts/setup-test-db.mjs",
    "vision:validate": "tsx scripts/run-vision-validation.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "db:push": "node scripts/migrate-standalone.mjs",
    "db:generate": "drizzle-kit generate",
    "monitor:ai-analytics": "node scripts/monitor-ai-analytics-rollout.mjs",
    "monitor:ai-analytics:summary": "node scripts/analyze-ai-analytics-metrics.mjs",
    "kb:extract": "node scripts/ai-kb/extract-codebase-knowledge.mjs",
    "kb:operational-cards": "node scripts/ai-kb/build-operational-cards.mjs",
    "kb:operational-cards:test": "node scripts/ai-kb/buildOperationalCards.test.mjs",
    "kb:chunk": "node scripts/ai-kb/build-knowledge-chunks.mjs",
    "kb:embed": "node scripts/ai-kb/generate-embeddings.mjs",
    "kb:embed:inc": "node scripts/ai-kb/embed-incremental.mjs",
    "kb:sync": "node scripts/ai-kb/extract-codebase-knowledge.mjs && node scripts/ai-kb/build-operational-cards.mjs && node scripts/ai-kb/build-knowledge-chunks.mjs && node scripts/ai-kb/embed-incremental.mjs && node scripts/ai-kb/build-semantic-graph.mjs",
    "kb:graph": "node scripts/ai-kb/build-semantic-graph.mjs",
    "kb:phase1": "node scripts/ai-kb/run-phase1.mjs",
    "kb:test": "node scripts/ai-kb/test-phase2-api.mjs",
    "kb:eval": "node scripts/ai-kb/eval-rag.mjs",
    "kb:stale-check": "node scripts/ai-kb/check-kb-stale.mjs",
    "eval:specialist": "tsx scripts/ai-eval/eval-specialist.mjs",
    "hooks:install": "node scripts/ai-kb/install-git-hooks.mjs",
    "ai:backfill": "tsx scripts/ai/backfill-ai-data.mjs",
    "sim:factory": "node scripts/sim-factory/seed.mjs",
    "sim:production": "node scripts/sim-factory/seed-production.mjs",
    "sim:scenario": "node scripts/sim-factory/scenario.mjs",
    "sim:esop": "tsx scripts/sim-factory/seed-esop.mjs",
    "sim:live": "node scripts/sim-factory/sim-live-daemon.mjs",
    "bench:ingest": "node scripts/bench/bench-inspection-ingest.mjs",
    "lake:verify": "tsx scripts/streaming/lake-verify.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "ai:bench": "node scripts/ai-bench/bench.mjs"
  },
