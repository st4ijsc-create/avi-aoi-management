# ─────────────────────────────────────────────────────────────────────────────
# .env.edge TEMPLATE — the edge gateway host (doc 81 Dot 10, docs/EDGE_GATEWAY.md section 8).
# Copy to .env.edge on the EDGE host (outside any repo checkout), fill in, and run:
#   docker compose -f deploy/edge/docker-compose.edge.yml --env-file .env.edge --env-file edge-node.env up -d
# `edge-node.env` comes from the node bundle (scripts/edge-node-credential.ts issue --bundle DIR on CENTRAL).
#
# ⛔ NEVER on the edge host — not here, not in edge-node.env, not in the shell:
#      DATABASE_URL            (the edge has NO central DB login; every DB accessor refuses with AVI_PROCESS_ROLE=edge)
#      JWT_SECRET              (central's session signing secret)
#      SECRET_ENCRYPTION_KEY   (central's master key; device secrets arrive already sealed for THIS node)
#      EDGE_NODE_CREDENTIAL    (the credential is a FILE — EDGE_NODE_CREDENTIAL_HOST_FILE — never an env var)
#    A v1 (Dot 9) host that still has them: remove them, then rotate the avi_app password and firewall :5432 (section 8.6).
# ─────────────────────────────────────────────────────────────────────────────

# ── Northbound UNS broker (central EMQX) ──
UNS_BROKER_URL=mqtts://central.example:8883
UNS_BROKER_USERNAME=
UNS_BROKER_PASSWORD=

# ── Node protocol — normally taken from the bundle's edge-node.env (listed here so nothing is missed) ──
# EDGE_GATEWAY_NODE_CODE=edge-line1
# EDGE_CENTRAL_URL=https://central.example:3000
# EDGE_CENTRAL_NODE_ID=
# EDGE_CENTRAL_CREDENTIAL_ID=
# EDGE_NODE_CREDENTIAL_HOST_FILE=/etc/avi-edge/edge-node.cred     # mode 600, owned by the container's app user
# EDGE_KEYSET_PIN_HOST_FILE=/etc/avi-edge/edge-keyset.json        # mode 444 (the root of trust: integrity matters)

# ── Journal (append-only JSONL + fsync under /app/data/edge-journal on the edgedata volume) ──
# auth / step / STOP / lock records are NEVER dropped: when the journal is full, new non-STOP actuation is refused
# (STOP unaffected) and health reports degraded. Size it for the longest central outage you must ride (section 8.7).
EDGE_JOURNAL_MAX_BYTES=67108864

# ── Devices this node drives (the list itself comes from central's signed config) ──
ROBOT_GATEWAY_ENABLED=false
