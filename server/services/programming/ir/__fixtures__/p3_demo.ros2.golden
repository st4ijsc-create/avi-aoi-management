# ROS2 (rclpy) node generated from IR flow "p3_demo" v1
# NOTE: structural skeleton — bind to a concrete MoveIt config before use.
# SAFETY: deploy only via the gated programmingService (DPC_DEPLOY_ENABLED + HITL).
import rclpy
from rclpy.node import Node


class P3DemoNode(Node):
    def __init__(self):
        super().__init__("p3_demo")

    def run(self):
        # [IR counter #b1]
        cycles = 0
        # [IR set_variable #b2]
        target = 5
        # [IR set_analog #b3]
        self.set_analog("AO1", (target + 1), unit="V")
        # [IR counter #b4]
        cycles = cycles + 1
        # [IR wait #b5]
        self.wait_ms((target * 100))
        # [IR wait_until #b6]
        self.wait_until(lambda: (cycles >= target), timeout_ms=5000, poll_ms=100)
        # [IR set_output #b7]
        self.set_io("DO2", (cycles > 0))
        # [IR pid_control #b8]
        self.pid_control(output_channel="AO2", input_channel="AI1", setpoint=target, kp=2, ki=0.5, kd=0.1, output_min=0, output_max=10)
